package gauge

// MinI returns the smaller of a and b.
fn MinI(a i64, b i64) i64 {
	if a < b {
		return a
	}
	return b
}

// MaxI returns the larger of a and b.
fn MaxI(a i64, b i64) i64 {
	if a > b {
		return a
	}
	return b
}

// AbsI returns |x| (MinI64 wraps to itself).
fn AbsI(x i64) i64 {
	if x < 0 {
		return 0 -% x
	}
	return x
}

// ClampI returns x limited to [lo, hi].
fn ClampI(x i64, lo i64, hi i64) i64 {
	if x < lo {
		return lo
	}
	if x > hi {
		return hi
	}
	return x
}

// shl and shr are the shifts Go defines for every count: a count of 64 or more gives 0, where
// the hardware (and Tin) takes the count modulo 64.
fn shl(x u64, n u64) u64 {
	if n >= 64 {
		return 0
	}
	return x << n
}

fn shr(x u64, n u64) u64 {
	if n >= 64 {
		return 0
	}
	return x >> n
}

// Gcd returns the greatest common divisor of |a| and |b| (0 when both are 0).
fn Gcd(a i64, b i64) i64 {
	a = AbsI(a)
	b = AbsI(b)
	for b != 0 {
		let t = a % b
		a = b
		b = t
	}
	// Only MinI64 stays negative under AbsI; any remainder of it is small enough to negate.
	return AbsI(a)
}

// Lcm returns the least common multiple of |a| and |b| (0 when either is 0; wraps on overflow).
fn Lcm(a i64, b i64) i64 {
	if a == 0 || b == 0 {
		return 0
	}
	return AbsI(a / Gcd(a, b) *% b)
}
