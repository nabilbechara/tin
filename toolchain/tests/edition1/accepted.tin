}

const MaxCount i64 = 10
let initial i64 = 0
mut total i64 = initial
shared let hits atomic.I64

type Pair struct {
	@json("first") first  i64
	second i64
}

type Token secret str
type Name str max 100
type Coordinate = (i64, i64)
type Status enum {
	Ready
	Failed(str, i64)
}
type Celsius f64
type Bytes [8]u8
type Lookup map[str]i64
type Mapper = fn(i64) i64
type Rune = rune
shape Reader {
	read(buf mut []u8) !i64
}

@nopoll fn bounded(s str max 100) secret str {
	return s
}

fn pair() (i64, i64) {
	return 1, 2
}

fn first[T](xs []T) ?T {
	return nil
}

fn sumValues(xs ...i64) i64 {
	return 0
}

fn (p mut Pair) move(dx i64, dy i64) {
	p.first += dx
	p.second += dy
}

fn flush(w mut Writer) ! {
	return
}

fn sum(n i64) i64 {
	let zero i64 = 0
	mut result = zero
	for i in 0..n {
		result += i
	}
	for value in values {
		result += value
	}
	for index, value in values {
		result += index + value
	}
	for key, value in lookup {
		result += value + len(key)
	}
	for result < MaxCount {
		result += 1
	}
	for {
		break
	}
	let (a, b) = pair()
	mut (left, right) = pair()
	let p = Pair{first: a, second: b}
	let array = [2]i64{1, 2}
	let slice = []i64{1, 2}
	let lookup = map[str]i64{"a": 1}
	let twice = fn(x i64) i64 { return x * 2 }
	let mapper Mapper = fn(x i64) i64 { return x * 2 }
	let optional = first[i64](array[0:1])
	let message = "status {n}"
	let raw = `raw {status}`
	let character = 'é'
	if n > 0 {
		defer close()
	} else if n == 0 {
		fail fault.BadInput
	} else {
		try recover() catch err {
			fail err
		}
	}
	return mapper(p.first + p.second) + sumValues(1, 2)
}

fn main() {}

fn contextualNames() {
	let use = 1
	let with = 2
	let in = 3
	let max = 4
	let select = 5
	let scope = 6
	let arena = 7
	let on = 8
	let once = 9
	let shape = 10
	let dyn = 11
	_ = use + with + in + max + select + scope + arena + on + once + shape + dyn
}

fn syntaxForms(maybe ?str, code i64, values []i64) {
	let timeout = 200ms
	let fractional = 2.5s
	let nanoseconds = 1ns
	let microseconds = 2us
	let minutes = 3m
	let hours = 4h
	let bytes = 5b
	let kilobytes = 6kb
	let megabytes = 7mb
	let gigabytes = 8gb
	let name = maybe ?? "anonymous"
	let wrapped = try load() wrap "loading"
	let bounded = try within 200ms {
		try load()
	}
	let guarded = guard {
		render()
	} catch err {
		fallback(err)
	}
	let limited = try limit memory 4mb, tasks 8 {
		summarize()
	}
	let allocated = arena { build() }
	let parallelResult = try parallel {
		loadUser()
		loadOrders()
	}
	let policy = try with retry(3) {
		charge()
	}
	let parenthesizedPolicy = with (retry(2)) {
		charge()
	}
	scope requests {
		use connection = open()
	}
	detach {
		flush(keep(event))
	}
	once {
		warmCache()
	}
	select {
		let job = jobs.recv() => handle(job)
		let response = request.wait() => use(response)
		after(5s) => timeout()
		canceled() => return
	}
	if let present = maybe {
		_ = present
	}
	let label = match code {
		200 => "ok"
		404 => "missing"
		500..600 => "server"
		_ => "other"
	}
	match shape {
		Circle(radius) => use(radius)
		Rect(width, height) => use(width + height)
	}
	match result {
		Some(Other(value)) => use(value)
		_ => { return }
	}
	let value = match code {
		n if n > 100 => n
		_ => 0
	}
	let auth = match code {
		401, 403 => "auth"
		_ => "other"
	}
	if maybe != nil {
		use(maybe)
	} else {
		defer finish()
	}
	for i in (0..10).step(2) {
		use(i)
	}
	outer: for i in 0..n {
		for j in 0..n {
			if j > i {
				break outer
			}
			continue
		}
	}
}
