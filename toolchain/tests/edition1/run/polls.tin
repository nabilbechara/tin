package main

import "say"
import "tide"

mut cleaned bool = false

fn cleanup() {
	cleaned = true
}

fn spin() {
	for {
	}
}

@nopoll fn kernel() {
	mut n i64 = 0
	for i in 0..100000000 {
		n += i
	}
	cleaned = n > 0
}

fn main() {
	let start = tide.Now()
	within 200ms {
		defer cleanup()
		spin()
	} catch err {
		say.Line("poll fault:", err)
	}
	say.Line("bounded:", tide.Now() - start < 1s)
	say.Line("deferred:", cleaned)
	cleaned = false
	within 10ms {
		kernel()
	} catch _ {
	}
	say.Line("nopoll completed:", cleaned)
	let a = limit memory 8mb {
		mut n i64 = 0
		for i in 0..10000 {
			n += 1
		}
		n
	} catch _ {
		-1
	}
	let b = guard {
		mut n i64 = 0
		for i in 0..10000 {
			n += 1
		}
		n
	} catch _ {
		-1
	}
	say.Line("unlimited:", a, b)
	cleaned = false
	within 20ms {
		guard {
			limit memory 8mb {
				defer cleanup()
				spin()
			} catch _ {
				say.Line("wrong limit landing")
			}
		} catch _ {
			say.Line("wrong guard landing")
		}
	} catch err {
		say.Line("owner:", err, cleaned)
	}
	within 1s {
		within 20ms {
			spin()
		} catch err {
			say.Line("inner owner:", err)
		}
		say.Line("outer alive")
	} catch _ {
		say.Line("wrong outer landing")
	}

	within 30ms {
		scope s {
			s.spawn(fn() ! { spin() })
			s.spawn(fn() ! { try tide.Wait(2s) })
		}
	} catch err {
		say.Line("child deadline:", err)
	}
	within 30ms {
		scope s {
			s.spawn(fn() ! { spin() })
			spin()
		}
	} catch err {
		say.Line("joined on unwind:", err)
	}

}
