package main

type Point struct {
	x i64
	y i64
}

const Bias i64 = 2
mut seed i64 = 3

fn sum(n i64) i64 {
	mut total i64 = i64(0)
	for i in 0..n {
		total += i
	}
	return total
}

fn total(xs []i64) i64 {
	mut total i64 = i64(0)
	for value in xs {
		total += value
	}
	return total
}

fn totalWithIndex(xs []i64) i64 {
	mut total i64 = i64(0)
	for index, value in xs {
		total += index + value
	}
	return total
}

fn stepped(n i64) i64 {
	mut total i64 = i64(0)
	for i in (0..n).step(2) {
		total += i
	}
	return total
}

fn mapTotal(values map[str]i64) i64 {
	mut total i64 = i64(0)
	for key, value in values {
		total += value
		_ = key
	}
	return total
}

fn choose(value ?str) i64 {
	if let present = value {
		return len(present)
	}
	return seed
}

fn pointSum(x i64, y i64) i64 {
	let point = Point{x: x, y: y}
	return point.x + point.y + Bias
}

fn main() {
	_ = sum(10)
	let values = []i64{1, 2}
	_ = total(values)
	_ = totalWithIndex(values)
	_ = stepped(10)
	let lookup = map[str]i64{"one": 1}
	_ = mapTotal(lookup)
	_ = choose(nil)
	_ = pointSum(1, 2)
}
