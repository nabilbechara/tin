package main

// #526: tin fix declares mut every let the program reassigns, and nothing else.

import "say"

let Limit = 3

mut hits = 0

fn pair() (i64, i64) {
	return 1, 2
}

fn main() {
	let total = 0
	let names = []str{}
	let fixed = "keep"
	let (a, b) = pair()
	for i in 0..Limit {
		total += i
		names = append(names, "n{i}")
	}
	a = a + b
	let bump = fn() {
		hits += 1
		total += 100
	}
	bump()
	say.Line(total, names, fixed, a, b, hits)
}
