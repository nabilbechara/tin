package main

import "say"
import "hearth"
import "relay"

const rounds = 20000

fn worker(id i64) {
	if id == 0 {
		for c in 1..4 {
			for i in 0..rounds {
				relay.Send(c, say.Fmt("%d", i))
			}
		}
		mut total = 0
		mut sum = 0
		for total < 3*rounds {
			let (_, msg) = relay.Recv()
			sum += len(msg)
			total += 1
		}
		say.Line("core 0 got", total, "replies, bytes", sum)
		for c in 1..4 {
			relay.Send(c, "stop")
		}
		return
	}
	mut n = 0
	for {
		let (from, msg) = relay.Recv()
		if msg == "stop" {
			break
		}
		relay.Send(from, say.Fmt("%d:%s", id, msg))
		n += 1
	}
	say.Line("core", id, "echoed", n)
}

fn main() {
	hearth.Run(4, worker)
}
