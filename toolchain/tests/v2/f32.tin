package main

import "argo"
import "say"

type Vec struct {
	X f32
	Y f32
}

fn dot(a []f32, b []f32) f32 {
	mut s = f32(0)
	for i in 0..len(a) {
		s += a[i] * b[i]
	}
	return s
}

fn main() {
	let a = f32(0.1)
	let b = f32(0.2)
	let c = a + b
	say.Line(a, b, c, c == 0.3, f64(c))
	say.Line(f32(1)/3, f32(2)/3*3, f32(16777217), f32(1e39) > 1e38)
	mut x = f32(1.5)
	x *= 1.1
	x += 1
	x = -x
	say.Line(x, i64(x), i32(f32(7.9)), f32(i64(123456789)))
	mut xs = []f32{1.25, 2.5, 3.75}
	xs = append(xs, 0.1, f32(1)/3)
	let ys = make([]f32, 5)
	for i in 0..5 {
		ys[i] = f32(i) * 0.5
	}
	say.Line(xs, ys, len(xs), dot(xs, ys))
	let m = map[str]f32{"half": 0.5}
	m["third"] = f32(1) / 3
	say.Line(m["third"], m["half"])
	let v = Vec{X: 0.1, Y: f32(2) / 7}
	say.Line(v.X, v.Y, "interp {v.X} {v.Y:.3}")
	let buf = make([]u8, 0, 64)
	argo.Put(mut buf, v)
	argo.Put(mut buf, xs)
	say.Line(str(buf))
	let back = Vec{X: 0, Y: 0}
	say.Line(argo.Get(`{"X": 0.30000001192092896, "Y": 1e-45}`, mut back), back.X, back.Y)
	say.Line(f32(3.4028235e38), f32(1.17549435e-38), f32(1.4e-45), f32(0.5e-45))
}
