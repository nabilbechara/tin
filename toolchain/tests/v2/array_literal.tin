package main

// #518: an [N]T{...} literal has N elements, the listed values first, then zero values.

import "say"

type P struct {
	x i64
}

fn main() {
	let a = [4]i64{}
	say.Line(len(a), a)
	let b = [3]i64{1, 2}
	say.Line(len(b), b)
	mut d [4]i64 = [4]i64{}
	d[3] = 9
	say.Line(d)
	let s = [3]str{"x"}
	say.Line(len(s), s, s[2] == "")
	let g = [2][3]i64{{1}}
	say.Line(len(g), len(g[0]), len(g[1]), g[0], g[1])
	let full = [2]i64{5, 6}
	say.Line(full)
	let ps = [2]P{{x: 1}, {x: 2}}
	say.Line(ps)
	let fs = [3]f64{1.5}
	say.Line(fs)
	let nested = [2][]i64{{1, 2}}
	say.Line(len(nested), len(nested[0]), len(nested[1]))
}
