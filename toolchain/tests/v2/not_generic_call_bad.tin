package main

import "cairn"
import "constraints"
import "twine"

// Type arguments go only to a generic function (#554): each call reports E501 once and is
// then checked without them; the compiler used to crash on all of these.

type C struct {
	n i64
}

fn (c C) get() i64 {
	return c.n
}

fn plain(x i64) i64 {
	return x
}

fn pair[A constraints.Any, B constraints.Any](a A, b B) A {
	return a
}

fn main() {
	let c = C{n: 1}
	let a = plain[i64](1)
	let b = twine.ToUpper[str]("a")
	mut l = cairn.NewLRU[str, i64](2)
	let d = c.get[i64]()
	let e = pair[i64](1, 2)
	let n = 5
	let f = n[i64](1)
	_ = a
	_ = b
	_ = l
	_ = d
	_ = e
	_ = f
}
