package main

import "argo"
import "say"

type Box struct {
	n i64
}

fn bump(b mut Box) {
	b.n += 1
}

fn show(b Box) {
	say.Line(b.n)
}

fn (b mut Box) Add(k i64) {
	b.n += k
}

fn main() {
	let b = Box{n: 1}
	bump(b)
	show(mut b)
	let f = bump
	f(b)
	b.Add(mut 2)
	let buf = make([]u8, 0, 16)
	argo.Put(buf, b)
	say.Line(b.n, len(buf))
}
