isabs "" false
isabs "." false
isabs ".." false
isabs "./" false
isabs "/" true
isabs "//" true
isabs "/a/../bb" true
isabs "/usr/bin/gcc" true
isabs "lala" false
join2 "" "" -> ""
join2 "" "/abs" -> "/abs"
join2 "" "b" -> "b"
join2 ".." ".." -> "../.."
join2 "/" "" -> "/"
join2 "/" "/" -> "/"
join2 "/" "a" -> "/a"
join2 "/" "a/b" -> "/a/b"
join2 "//" "a" -> "/a"
join2 "/a" "b" -> "/a/b"
join2 "a" "" -> "a"
join2 "a" "/b" -> "a/b"
join2 "a" "b" -> "a/b"
join2 "a/" "" -> "a"
join2 "a/" "b" -> "a/b"
join2 "a/b" "../../../xyz" -> "../xyz"
join2 "x" "./y/" -> "x/y"
join3 "/a/b" "a/b" "" "c"
joinall "" "" "x/y" "/a/c" "a"
match "" "" true <nil>
match "" "a" false <nil>
match "*" "" true <nil>
match "*" "abc" true <nil>
