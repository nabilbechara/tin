base dir split "" -> "." "." | "" ""
base dir split "." -> "." "." | "" "."
base dir split ".." -> ".." "." | "" ".."
base dir split "/" -> "/" "/" | "/" ""
base dir split "/." -> "." "/" | "/" "."
base dir split "////" -> "/" "/" | "////" ""
base dir split "/a/.." -> ".." "/a" | "/a/" ".."
base dir split "a//b//" -> "b" "a/b" | "a//b//" ""
base dir split "a/b/.x" -> ".x" "a/b" | "a/b/" ".x"
base dir split "a/b/c." -> "c." "a/b" | "a/b/" "c."
base dir split "a/b/c.x" -> "c.x" "a/b" | "a/b/" "c.x"
base dir split "abc" -> "abc" "." | "" "abc"
base dir split "abc/def" -> "def" "abc" | "abc/" "def"
base dir split "x/" -> "x" "x" | "x/" ""
base dir split "ß/é" -> "é" "ß" | "ß/" "é"
clean "" -> "."
clean "." -> "."
clean ".." -> ".."
clean "..." -> "..."
clean "../" -> ".."
clean "../.." -> "../.."
clean "../../" -> "../.."
clean "../../abc" -> "../../abc"
