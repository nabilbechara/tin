package main

import "say"

type Box struct {
	name str
}

// Assigning a mut struct, optional or map parameter itself would be lost in the caller (#180).
fn clear(x mut ?Box) { x = nil }
fn reset(b mut Box) { b = Box{name: "new"} }
fn remake(m mut map[str]i64) { m = make(map[str]i64) }
fn (b mut Box) Replace() { b = Box{name: "r"} }

// Still allowed: fields, elements, and the append idiom on a mut slice.
fn rename(b mut Box) { b.name = "renamed" }
fn grow(xs mut []i64) { xs = append(xs, 1) }
fn fill(m mut map[str]i64) { m["k"] = 1 }

fn main() {
	let o ?Box = Box{name: "x"}
	clear(mut o)
	let b = Box{name: "b"}
	reset(mut b)
	rename(mut b)
	let m = make(map[str]i64)
	remake(mut m)
	fill(mut m)
	let xs = []i64{}
	grow(mut xs)
	b.Replace()
	say.Line(b.name, len(m), len(xs))
}
