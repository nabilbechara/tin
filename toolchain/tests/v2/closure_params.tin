package main

import "say"

// Closures that outlive the call capture parameters through cells; every parameter must
// keep its own value (a captured parameter's cell once overwrote the next parameter).

fn adders(a i64, b i64, c str) []fn() str {
	mut fs = make([]fn() str, 0, 3)
	fs = append(fs, fn() str { return say.Fmt("%d", a+b) })
	fs = append(fs, fn() str { return c + say.Fmt("%d", b) })
	fs = append(fs, fn() str { return say.Fmt("%d %d %s", a, b, c) })
	return fs
}

fn counter(start i64, step i64) fn() i64 {
	mut n = start
	return fn() i64 {
		n += step
		return n
	}
}

fn main() {
	for _, f in adders(3, 4, "x") {
		say.Line(f())
	}
	let next = counter(10, 5)
	next()
	say.Line(next())
}
