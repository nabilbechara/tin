package main

import "mint"
import "say"

fn old() (i64, fault) {
	return 1, nil
}

fn both() !i64 {
	return 1, nil
}

fn noval() ! {
	return 3
}

fn plain() i64 {
	fail "no fault result"
}

fn novalue() i64 {
	let n = mint.Atoi("1") catch _ {
		say.Line("no value here")
	}
	return n
}

fn nofault() i64 {
	return 2
}

fn caught() i64 {
	return nofault() catch _ { 0 }
}

fn pairs() !(i64, i64) {
	return 1, 2
}

fn multi() i64 {
	let (a, b) = pairs() catch _ { 0 }
	return a + b
}

fn main() {
	say.Line(novalue(), caught(), multi())
}
