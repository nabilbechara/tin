package main

fn checkpoint(x i64) i64 {
	if x < 0 {
		return 0
	}
	return x + 1
}

fn work(n i64) f64 {
	mut a = 1.0
	mut b = 2.0
	mut c = 3.0
	mut d = 4.0
	mut e = 5.0
	mut f = 6.0
	let scale = 0.001
	for i in 0..n {
		a = a + b*scale
		b = b + c*scale
		c = c + d*scale
		d = d + e*scale
		e = e + f*scale
		f = f + a*scale
	}
	a = a + f64(checkpoint(n))*0.000000000000001
	return a + b + c + d + e + f
}

fn main() {
	_ = work(1000)
}
