package main

// #519: a program may declare names the runtime uses; the runtime keeps its own.

import "say"
import "twine"

const pipe = 7

mut poll = 3

let rtArgc = "mine"

fn read(path str) str {
	return "read " + path
}

fn write(s str) i64 {
	return len(s)
}

fn open(a i64, b i64) i64 {
	return a + b
}

fn close() str {
	return "closed"
}

fn exit(code i64) i64 {
	return code * 2
}

fn free(x i64) i64 {
	return x + 1
}

fn malloc(n i64) []i64 {
	return make([]i64, n)
}

fn memcpy(a str, b str) str {
	return a + b
}

fn signal(s str) str {
	return twine.ToUpper(s)
}

fn sigaction() i64 {
	return poll + pipe
}

fn main() {
	poll += 1
	say.Line(read("x"), write("abc"), open(1, 2), close(), exit(4), free(5))
	say.Line(len(malloc(3)), memcpy("a", "b"), signal("hup"), sigaction(), rtArgc)
	let f = read
	say.Line(f("via value"))
}
