# The integer instantiation folds x == x / x != x after inlining. The floating-point
# instantiation keeps the self-comparisons needed for NaN ordering.

[arm64]
CHECK: _sift\.less\[i64\]:
CHECK-NOT: cmp x9, x9
CHECK-NOT: cmp x10, x10
CHECK: ret
CHECK: _sift\.less\[f64\]:
CHECK: fcmp d16, d17
CHECK: fcmp d16, d16
CHECK: fcmp d17, d17

[amd64]
# Match each summary label to its body without depending on compiler-assigned IDs.
CHECK: (?ms)# L(?P<int>[0-9]+): sift\.less\[i64\][\s\S]*?# L(?P<float>[0-9]+): sift\.less\[f64\][\s\S]*?^L(?P=int):\n(?:(?!^cmp ).)*?^cmp [^,\n]+,[^\n]+$\n(?:(?!^cmp ).)*?^ret$[\s\S]*?^L(?P=float):\n(?:(?!^ret$)[\s\S])*?^ucomisd [^\n]+\n(?:(?!^ret$)[\s\S])*?^ucomisd [^\n]+\n(?:(?!^ret$)[\s\S])*?^ucomisd [^\n]+\n(?:(?!^ret$)[\s\S])*?^ret$
