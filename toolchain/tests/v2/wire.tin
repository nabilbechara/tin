package main

import "say"
import "hearth"
import "relay"
import "mint"
import "wire"
import "twine"

// serve answers three raw echo lines, then HTTP requests until it sees /stop.
fn serve(l wire.Listener) ! {
	let c = try l.Accept()
	let buf = make([]u8, 0, 64)
	for len(buf) < 14 {
		let (_, err) = c.Read(mut buf, 64)
		if err != nil {
			fail err
		}
	}
	try c.WriteBytes(buf)
	c.Close()
	for {
		let hc = try l.Accept()
		let req = make([]u8, 0, 1024)
		for {
			let (_, err) = hc.Read(mut req, 1024)
			if err != nil {
				break
			}
			let s = str(req)
			if len(s) >= 4 && s[len(s)-4:] == "\r\n\r\n" {
				break
			}
			if len(s) > 4 && s[:4] == "POST" && len(s) > 10 && s[len(s)-5:] == "hello" {
				break
			}
		}
		let s = str(req)
		if len(s) >= 9 && s[:9] == "GET /stop" {
			try hc.Write("HTTP/1.1 200 OK\r\nContent-Length: 3\r\n\r\nbye")
			hc.Close()
			return
		}
		if len(s) >= 10 && s[:10] == "GET /stall" {
			// Half a body, then nothing until the client gives up and closes.
			try hc.Write("HTTP/1.1 200 OK\r\nContent-Length: 10\r\n\r\nab")
			let junk = make([]u8, 0, 64)
			for {
				let (_, err) = hc.Read(mut junk, 64)
				if err != nil {
					break
				}
			}
			hc.Close()
			continue
		}
		if len(s) >= 8 && s[:8] == "GET /big" {
			try hc.Write("HTTP/1.1 200 OK\r\nContent-Length: 100\r\n\r\n" + twine.Repeat("x", 100))
			hc.Close()
			continue
		}
		if len(s) >= 12 && s[:12] == "GET /chunked" {
			try hc.Write("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nX-Kind: chunks\r\n\r\n5\r\nhello\r\n7\r\n, world\r\n0\r\n\r\n")
		} else if len(s) >= 4 && s[:4] == "POST" {
			try hc.Write("HTTP/1.1 201 Created\r\nContent-Length: 7\r\n\r\ncreated")
		} else {
			try hc.Write("HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 2\r\n\r\nok")
		}
		hc.Close()
	}
}

fn worker(id i64) {
	if id == 1 {
		let (l, err) = wire.Listen("127.0.0.1:0")
		if err != nil {
			say.Line("listen", err)
			return
		}
		relay.Send(0, mint.Itoa(l.Port()))
		let e2 = serve(l)
		if e2 != nil {
			say.Line("serve error", e2)
		}
		l.Close()
		return
	}
	let (_, portmsg) = relay.Recv()
	let addr = "127.0.0.1:" + portmsg
	let (c, err) = wire.Dial(addr)
	say.Line("dial", err == nil)
	c.SetTimeout(2000000000)
	let e1 = c.Write("one\n")
	let e2 = c.Write("two\n")
	let e3 = c.Write("three\n")
	let (got, e4) = c.ReadFull(14)
	say.Line("echo", say.Fmt("%q", got), e1 == nil && e2 == nil && e3 == nil && e4 == nil)
	let (_, e5) = c.ReadFull(1)
	say.Line("eof", wire.IsEOF(e5))
	c.Close()
	let (r, e6) = wire.Get("http://" + addr + "/hello?x=1")
	say.Line("get", e6 == nil, r.Status, r.Body, r.Header("content-type"))
	let (r2, e7) = wire.Get("http://" + addr + "/chunked")
	say.Line("chunked", e7 == nil, r2.Status, say.Fmt("%q", r2.Body), r2.Header("X-Kind"))
	let (r3, e8) = wire.Post("http://" + addr + "/items", "text/plain", "hello")
	say.Line("post", e8 == nil, r3.Status, r3.Body)
	let (_, e14) = wire.DoWith("GET", "http://" + addr + "/stall", []str{}, "", wire.Options{Timeout: 200000000, MaxBody: 0})
	say.Line("timeout", e14)
	let (_, e15) = wire.DoWith("GET", "http://" + addr + "/big", []str{}, "", wire.Options{Timeout: 0, MaxBody: 50})
	say.Line("maxbody length", e15)
	let (r5, e16) = wire.DoWith("GET", "http://" + addr + "/big", []str{}, "", wire.Options{Timeout: 0, MaxBody: 100})
	say.Line("maxbody exact", e16 == nil, len(r5.Body))
	let (_, e17) = wire.DoWith("GET", "http://" + addr + "/chunked", []str{}, "", wire.Options{Timeout: 0, MaxBody: 8})
	say.Line("maxbody chunked", e17)
	let (_, e18) = wire.Do("GET", "http://" + addr + "/x", []str{"X-A", "a\r\nSet-Cookie: x=1"}, "")
	say.Line("header value", e18)
	let (_, e19) = wire.Do("GET", "http://" + addr + "/x", []str{"Bad Name", "v"}, "")
	say.Line("header name", e19)
	let (_, e20) = wire.Do("GET", "http://" + addr + "/x HTTP/1.1\r\nX: y", []str{}, "")
	say.Line("url", e20 != nil)
	let (_, e21) = wire.Do("GE T", "http://" + addr + "/x", []str{}, "")
	say.Line("method", e21)
	let r4 = wire.Get("http://" + addr + "/stop") catch err {
		say.Line("stop", err)
		return
	}
	say.Line("stop", r4.Body)
	// https:// is dialed (TLS on top); a refused port fails before any TLS, deterministically.
	let (_, e9) = wire.Get("https://127.0.0.1:1/")
	say.Line("https", e9)
	let (_, e9b) = wire.Get("ftp://example.com/")
	say.Line("scheme", e9b)
	let (_, e10) = wire.Get("ftp://x")
	say.Line("bad url", e10 != nil)
	let (_, e11) = wire.Dial("127.0.0.1:1")
	say.Line("refused", e11 != nil)
	let (_, e12) = wire.Dial("nohostport")
	say.Line("noport", e12)
	let (_, e13) = wire.Dial("localhost:9")
	say.Line("localhost", e13 != nil)
}

fn main() {
	hearth.Run(2, worker)
}
