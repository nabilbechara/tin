package main

import "say"

type Node struct {
	v i64
	l ?Node
	r ?Node
}

fn check(n Node) i64 {
	let l = n.l
	let r = n.r
	if l == nil || r == nil {
		return 1
	}
	return 1 + check(l) + check(r)
}

fn both(a ?Node, b ?Node) i64 {
	if a != nil && b != nil {
		return a.v + b.v
	}
	return -1
}

fn bytesOf(n i64) []u8 {
	mut b = make([]u8, 0, 8)
	for i in 0..n {
		b = append(b, 'x')
	}
	return b
}

fn main() {
	let leaf = Node{v: 1}
	let t = Node{v: 2, l: leaf, r: Node{v: 3, l: leaf, r: leaf}}
	say.Line(check(t), both(leaf, leaf), both(leaf, nil))
	say.Line("len", len(bytesOf(3)))
	let big u64 = 18446744073709551615
	let h u64 = 0xcbf29ce484222325
	say.Line(big, h, big/2+1)
}
