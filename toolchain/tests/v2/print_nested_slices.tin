package main

// #524: a slice of slices, maps, faults or optionals prints its elements, not their addresses.

import "say"

type P struct {
	x i64
}

type G struct {
	grid [][]i64
	sets []map[str]bool
}

type E enum {
	A
	B(i64)
}

fn main() {
	let e1 = fail("one")
	say.Line([]u8{1, 2}, []u64{18446744073709551615}, []i8{-1}, []u16{7})
	say.Line([]fault{e1, nil})
	let s1 ?str = "s"
	let s2 ?str = nil
	say.Line([]?str{s1, s2})
	say.Line([][]i64{{1, 2}, {3}}, [][]str{{"a"}, {}}, [][][]i64{{{1}, {2, 3}}})
	say.Line([]map[str]i64{map[str]i64{"x": 1}}, [][]P{{{x: 1}}}, [][]E{{E.A, E.B(2)}})
	say.Out("%v|%+v\n", [][]i64{{1}}, [][]P{{{x: 1}}})
	let nest = [][]i64{{4}}
	let t = "{nest}"
	say.Line(t, say.Str([][]bool{{true}}), say.Fmt("%v", [][]f64{{1.5}}))
	let g = G{grid: [][]i64{{1, 2}, {3}}, sets: []map[str]bool{map[str]bool{"on": true}}}
	say.Line(g)
	say.Out("%+v\n", g)
	let byName = map[str][][]i64{"m": {{1}, {2}}}
	say.Line(byName)
	let empty = [][]i64{}
	say.Line(empty, len(empty))
}
