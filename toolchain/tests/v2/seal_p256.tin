package main

import "say"
import "seal"

fn hx(s str) []u8 {
	let (b, err) = seal.HexDecode(s)
	if err != nil {
		panic("bad hex")
	}
	return b
}

fn small(v i64) []u8 {
	let k = make([]u8, 32)
	k[31] = u8(v)
	return k
}

fn pub(k []u8) str {
	let p = seal.P256PublicKey(k) catch _ {
		return "fault"
	}
	return seal.Hex(p)
}

fn shared_(k []u8, peer []u8) str {
	let s = seal.P256ECDH(k, peer) catch _ {
		return "fault"
	}
	return seal.Hex(s)
}

fn cat(a []u8, b []u8) []u8 {
	mut out = make([]u8, 0, len(a)+len(b))
	out = append(out, a...)
	out = append(out, b...)
	return out
}

fn main() {
	let n = hx("ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551")
	let n1 = hx("ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632550")
	let n2 = hx("ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc63254f")
	let np1 = hx("ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632552")
	let ks = [][]u8{small(1), small(2), small(15), small(16), small(255), n1, n2, hx("c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721")}
	for i, k in ks {
		say.Line("pub", i, pub(k))
	}
	let bad = [][]u8{make([]u8, 32), n, np1, hx("ff"), make([]u8, 33)}
	for i, k in bad {
		say.Line("badpriv", i, pub(k))
	}
	let a = hx("0612465c89a023ab17855b0a6bcebfd3febb53aef84138647b5352e02c10c346")
	let b = hx("7d7dc5f71eb29ddaf80d6214632eeae03d9058af1fb6d22ed80badb62bc1a534")
	let pa = hx(pub(a))
	let pb = hx(pub(b))
	say.Line("ecdh", shared_(a, pb), shared_(b, pa))
	let comp = cat([]u8{2 + pb[64]&1}, pb[1:33])
	let flip = cat([]u8{3 - pb[64]&1}, pb[1:33])
	say.Line("compressed", shared_(a, comp), shared_(a, flip) != shared_(a, pb))
	let notOn = cat([]u8{}, pb)
	notOn[64] ^= 1
	let big1 = make([]u8, 65)
	big1[0] = 4
	for i in 1..33 {
		big1[i] = 0xff
	}
	let peers = [][]u8{notOn, big1, pb[:64], cat([]u8{5}, pb[1:]), []u8{}, []u8{0}, cat([]u8{2}, make([]u8, 32))}
	for i, p in peers {
		say.Line("badpeer", i, shared_(a, p))
	}
	// Fresh keys agree with each other.
	let x = seal.P256NewPrivateKey()
	let y = seal.P256NewPrivateKey()
	let px = hx(pub(x))
	let py = hx(pub(y))
	say.Line("fresh", shared_(x, py) == shared_(y, px), len(px))
}
