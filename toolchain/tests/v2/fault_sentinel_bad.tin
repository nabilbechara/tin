package main

import "fault"
import "say"

let ErrA = fault("a")
let ErrB = fault(3)
let ErrC = fault("a", "b")

fn f() !i64 {
	let e = fault("inside a function")
	fail e
}

fn g(err fault) str {
	match err {
		"a" => {
			return "text"
		}
	}
	return "none"
}

fn main() {
	say.Line(ErrA, ErrB, ErrC, g(ErrA))
}
