package main

import "say"
import "sift"

mut g fn() i64

fn makeCounter() fn() i64 {
	mut n = 0
	return fn() i64 {
		n += 1
		return n
	}
}

fn adder(base i64) fn(i64) i64 {
	return fn(x i64) i64 {
		base += x
		return base
	}
}

fn main() {
	let xs = []i64{1, 2, 3, 4, 5}
	mut total = 0
	let u0 = rt_pool_used()
	sift.Each(xs, fn(x i64) {
		total += x
	})
	let u1 = rt_pool_used()
	say.Line("total:", total)
	say.Line("pool diff:", u1 - u0)

	let c1 = makeCounter()
	say.Line("c1:", c1())
	say.Line("c1:", c1())
	say.Line("c1:", c1())

	let c2 = makeCounter()
	say.Line("c2:", c2())
	say.Line("c1 again:", c1())

	let add10 = adder(10)
	say.Line("add10:", add10(5))
	say.Line("add10:", add10(3))

	g = keep(makeCounter())
	say.Line("global keep:", g())
	say.Line("global keep:", g())
}
