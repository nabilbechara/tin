package main

// #520: s += e in a loop that only appends to s grows s in place. No other name may see the
// growth: strings kept between loops, aliases taken before the loop, and loops that read s are
// all left as they were.

import "say"
import "sift"

fn build(n i64) str {
	mut s = ""
	for i in 0..n {
		s += "{i % 10}"
	}
	return s
}

fn chain(n i64) str {
	mut s = "<"
	for i in 0..n {
		s = s + "a" + str(65 + i % 26) + ","
	}
	return s + ">"
}

fn main() {
	let big = build(100000)
	say.Line(len(big), big[0:12], big[len(big) - 5:])
	say.Line(chain(4))

	// rows kept between inner loops are never extended by the next run
	mut rows = []str{}
	mut row = ""
	for r in 0..4 {
		row = ""
		for c in 0..r + 1 {
			row += "{c}"
		}
		rows = append(rows, row)
	}
	say.Line(rows)

	// an alias taken before the loop keeps its value
	mut s = "base"
	let before = s
	for i in 0..3 {
		s += "+"
	}
	say.Line(before, s)

	// a loop that keeps s elsewhere is not rewritten, and its copies stay right
	mut acc = ""
	mut seen = []str{}
	for i in 0..3 {
		acc += "x"
		seen = append(seen, acc)
	}
	say.Line(seen)

	// len, index and comparisons in the loop; break and continue
	mut t = ""
	mut words = []str{"go", "tin", "zig", "c", "rust"}
	for w in words {
		if w == "c" {
			continue
		}
		if len(t) > 9 {
			break
		}
		t += w
		if t[0] == 'g' && t != "go" {
			t += "!"
		}
	}
	say.Line(t, len(t))

	// a closure that reads s: no rewrite
	mut u = ""
	sift.Each([]i64{1, 2, 3}, fn(x i64) {
		u += "{x}"
	})
	say.Line(u)

	// while loop and unicode
	mut v = ""
	mut k = 0
	for k < 3 {
		v += "é"
		k += 1
	}
	say.Line(v, len(v))

	// appending empty strings and to an empty start
	mut e = ""
	for i in 0..3 {
		e += ""
	}
	say.Line(e == "", len(e))
}
