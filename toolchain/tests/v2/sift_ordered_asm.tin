package main

import "sift"

// Both monomorphizations are required below: an integer comparison is reflexive, but
// floating-point self-comparisons must remain so NaNs continue to sort first.
fn main() {
	let ints = []i64{2, 1}
	sift.Sort(mut ints)
	let floats = []f64{2, 1}
	sift.Sort(mut floats)
}
