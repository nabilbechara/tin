package main

import "constraints"
import "say"

fn Max[T i64 | f64 | str](a T, b T) T {
	if a > b {
		return a
	}
	return b
}

fn Sum[T i64 | f64](xs []T) T {
	mut t T
	for _, x in xs {
		t += x
	}
	return t
}

fn Map[T constraints.Any, U constraints.Any](xs []T, f fn(T) U) []U {
	mut out = make([]U, 0, len(xs))
	for _, x in xs {
		out = append(out, f(x))
	}
	return out
}

fn Keys[K constraints.Comparable, V constraints.Any](m map[K]V) []K {
	mut out = []K{}
	for k, _ in m {
		out = append(out, k)
	}
	return out
}

type Stack[T constraints.Any] struct {
	items []T
}

fn (s mut Stack[T]) Push(x T) {
	s.items = append(s.items, x)
}

fn (s mut Stack[T]) Pop() (T, bool) {
	let n = len(s.items)
	if n == 0 {
		mut zero T
		return zero, false
	}
	let x = s.items[n-1]
	s.items = s.items[:n-1]
	return x, true
}

fn (s Stack[T]) Len() i64 {
	return len(s.items)
}

type Pair[A constraints.Any, B constraints.Any] struct {
	first  A
	second B
}

fn MakePair[A constraints.Any, B constraints.Any](a A, b B) Pair[A, B] {
	return Pair[A, B]{first: a, second: b}
}

fn square(x i64) str {
	return say.Fmt("%d", x*x)
}

fn main() {
	say.Line(Max(3, 9), Max(2.5, 1.5), Max("pear", "apple"), Max[i64](-1, -2))
	say.Line(Sum([]i64{1, 2, 3}), Sum([]f64{0.5, 0.25}))
	say.Line(Map([]i64{1, 2, 3}, square))
	let m = map[str]i64{"x": 1}
	say.Line(Keys(m))
	let s = Stack[i64]{items: []i64{}}
	s.Push(10)
	s.Push(20)
	let (v, ok) = s.Pop()
	say.Line(v, ok, s.Len())
	let names = Stack[str]{items: []str{}}
	names.Push("tin")
	say.Line(names.Len(), names.items)
	let p = MakePair("k", 7)
	say.Line(p.first, p.second)
	let q = Pair[i64, []str]{first: 1, second: []str{"a"}}
	say.Line(q.first, q.second)
}
