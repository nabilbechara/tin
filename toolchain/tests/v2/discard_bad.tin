package main

import "constraints"
import "say"

fn one() !i64 {
	fail "boom"
}

fn two() !(i64, str) {
	fail "boom"
}

fn check() ! {
	fail "boom"
}

fn pair() (i64, str) {
	return 1, "a"
}

fn none() {
}

fn drop[T constraints.Any](x T) {
}

fn blanks() {
	_ = one()
	mut _ = check()
	mut (x, _) = one()
	mut (a, b, _) = two()
	x, _ = one()
	mut (_, c) = one(), 2
	_ = pair()
	_ = none()
	let (_, err) = one()
	if err != nil {
		say.Line(x, a, b, c)
	}
}

fn values() {
	say.Line(one())
	say.Line(pair())
	say.Line(none())
	let s = say.Fmt("%v", one())
	println(one())
	let t = "v={one()}"
	drop(one())
	say.Line(s, t)
}

fn main() {
	blanks()
	values()
}
