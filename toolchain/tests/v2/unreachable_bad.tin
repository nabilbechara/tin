package main

import "say"

// #531: a statement after one that always leaves its block is reported as unreachable.
fn answer() i64 {
	return 42
	say.Line("computed")
}

fn loop() {
	for i in 0..3 {
		if i == 1 {
			continue
			say.Line("skipped")
		}
		break
		say.Line(i)
	}
}

fn check(n i64) ! {
	if n < 0 {
		fail "negative"
		say.Line("after fail")
	}
}

fn main() {
	loop()
	check(1) catch _ {
		panic("no")
		say.Line("after panic")
	}
	say.Line(answer())
}
