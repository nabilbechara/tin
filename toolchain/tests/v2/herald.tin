package main

import "say"
import "herald"
import "crucible"

fn fixed() i64 {
	return 1759317725123
}

fn main() {
	herald.SetClock(fixed)
	crucible.EqS("info line", herald.Line(herald.LInfo, "listening", []str{"addr", ":8080"}), "2025-10-01T11:22:05.123Z INFO core=0 listening addr=:8080\n")
	crucible.EqS("quoted", herald.Line(herald.LError, "failed", []str{"err", "bad thing", "empty", ""}), "2025-10-01T11:22:05.123Z ERROR core=0 failed err=\"bad thing\" empty=\"\"\n")
	crucible.EqS("debug", herald.Line(herald.LDebug, "x", []str{}), "2025-10-01T11:22:05.123Z DEBUG core=0 x\n")
	crucible.EqS("odd pairs", herald.Line(herald.LWarn, "w", []str{"k"}), "2025-10-01T11:22:05.123Z WARN core=0 w\n")
	herald.SetOutput(1)
	herald.Info2("written", "k", "v")
	herald.Debug("dropped below level")
	herald.SetLevel(herald.LError)
	herald.Warn("dropped too")
	herald.Error("kept")
	crucible.EqI("ints", 2+2, 4)
	crucible.EqF("floats", 0.1+0.2, 0.3, 1e-12)
	crucible.True("true", len("ab") == 2)
	crucible.NoFault("nofault", nil)
	crucible.HasFault("hasfault", fail("x"))
	say.Line("failed so far", crucible.Failed(), crucible.Checks())
	crucible.Done()
}
