package main

import "say"

// #526: a let is not reassigned: locals, compound assignment, tuple bindings, captures,
// package-level lets and loop variables; fields and elements through a let stay assignable.
let G = 1

type Box struct {
	n i64
}

fn pair() (i64, i64) {
	return 1, 2
}

fn main() {
	let x = 1
	x = 2
	let s = "a"
	s += "b"
	let (a, b) = pair()
	a, b = b, a
	let f = fn() {
		x = 3
	}
	G = 2
	let box = Box{n: 1}
	box.n = 2
	let xs = []i64{1}
	xs[0] = 5
	mut ok = 1
	ok = 2
	for i in 0..3 {
		i = 5
	}
	for w in []i64{1} {
		w = 2
	}
	say.Line(x, s, a, b, box.n, xs, ok, G)
	f()
}
