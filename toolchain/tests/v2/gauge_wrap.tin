package main

// #532: gauge.AbsI and gauge.Lcm wrap as documented under checked arithmetic (#362).

import "gauge"
import "say"

fn main() {
	let m = -9223372036854775807 - 1
	say.Line(gauge.AbsI(m), gauge.AbsI(-5), gauge.AbsI(7))
	say.Line(gauge.Lcm(4, 6), gauge.Lcm(-4, 6), gauge.Lcm(0, 3))
	say.Line(gauge.Lcm(4611686018427387904, 3))
	say.Line(gauge.Gcd(m, 6))
}
