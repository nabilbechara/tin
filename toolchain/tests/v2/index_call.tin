package main

import "constraints"
import "lane"
import "say"

// X[a](...) reads like explicit type arguments; when X is not a generic function it is an
// index, then a call (#554): a slice or map of functions, indexed by a name or an expression.

type Ops struct {
	k i64
}

fn inc(x i64) i64 {
	return x + 1
}

fn dbl(x i64) i64 {
	return x * 2
}

fn pick(i i64) i64 {
	return i % 2
}

fn ident[T constraints.Any](x T) T {
	return x
}

fn pair[A constraints.Any, B constraints.Any](a A, b B) B {
	return b
}

let table = []fn(i64) i64{inc, dbl}

fn main() {
	let fs = []fn(i64) i64{inc, dbl}
	let m = map[str]fn(i64) i64{"inc": inc, "dbl": dbl}
	let k = 1
	let name = "inc"
	let o = Ops{k: 0}
	say.Line("name", fs[k](10), m[name](10), table[k](4))
	say.Line("field", fs[o.k](10))
	say.Line("expr", fs[k-1](10), fs[k*1](10), m["dbl"](3), fs[pick(3)](7))
	for i in 0..2 {
		say.Line("loop", i, fs[i](i))
	}
	say.Line("generic", ident[i64](5), ident[str]("s"), pair[i64, str](1, "b"), ident[[]i64]([]i64{1, 2}))
	say.Line("generic types", len(ident[map[str]i64](map[str]i64{"a": 1})), ident[fn(i64) i64](inc)(1), ident[[2]u8]([2]u8{3, 4}))
	mut l = lane.New[i64](2)
	l.Send(9) catch _ {
	}
	let got = l.Recv() catch _ { 0 }
	say.Line("lane", got)
}
