package main

// #522: a narrowing that a branch ended is over after the if, and after a ?T assignment.

import "say"

type Node struct {
	val i64
	next ?Node
}

fn mk() ?Node {
	return nil
}

fn main() {
	mut c ?Node = Node{val: 1, next: nil}
	let flag = true
	for c != nil {
		if flag {
			c = c.next
		}
		say.Line(c.val)
	}
	mut d = mk()
	if d == nil {
		return
	}
	say.Line(d.val)
	d = mk()
	say.Line(d.val)
}
