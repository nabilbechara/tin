package main

import "flume"
import "mint"
import "say"
import "wire"

fn main() {
	let w = flume.Stdout()
	say.Line(w.fd)
	let n = mint.parseInt("Atoi", "1", 10) catch _ { 0 }
	say.Line(n, mint.MaxI64)
	let r = wire.Resp{Status: 200, Body: "", head: ""}
	say.Line(r.Status)
	let c = wire.Conn{}
	say.Line(c.open)
	let b = flume.bufSize
	say.Line(b)
}
