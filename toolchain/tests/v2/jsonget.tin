package main

import "say"
import "argo"

type Point struct {
	@json("x") X i64
	Y i64
}

type Item struct {
	name  str
	price f64
	qty   u16
	small i8
	tags  []str
	at    Point
	maybe ?Point
	attrs map[str]i64
	ok    bool
}

fn main() {
	let it = Item{at: Point{}, attrs: make(map[str]i64)}
	let err = argo.Get(` { "name": "tin \"can\" éé😀", "price": 2.5e1, "qty": 700, "small": -12,
		"tags": ["a", "b\n"], "at": {"x": 3, "Y": -4}, "maybe": {"x": 9},
		"attrs": {"k": 1, "j": 2}, "ok": true, "unknown": [1, {"deep": [null, true]}] } `, mut it)
	say.Line(err == nil, it.name, it.price, it.qty, it.small, it.tags, it.at.X, it.at.Y, it.attrs["j"], it.ok)
	let m = it.maybe
	if m != nil {
		say.Line("maybe", m.X, m.Y)
	}
	let xs = []Point{}
	let e2 = argo.Get(`[{"X":1,"Y":2},{"Y":5}]`, mut xs)
	say.Line(e2 == nil, len(xs), xs[1].Y)
	let bad = Point{}
	say.Line(argo.Get(`{"X": 1.5}`, mut bad))
	say.Line(argo.Get(`{"X": 99999999999999999999}`, mut bad))
	say.Line(argo.Get(`{"X": 1,}`, mut bad))
	say.Line(argo.Get(`{"X": 1} x`, mut bad))
	let small = Item{at: Point{}, attrs: make(map[str]i64)}
	say.Line(argo.Get(`{"qty": 70000}`, mut small))
	let b = make([]u8, 0)
	argo.Put(mut b, it)
	say.Line(str(b))
}
