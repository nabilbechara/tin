package main

// #522: for x != nil narrows x in the body until an assignment of a ?T ends it.

import "say"

type Node struct {
	val i64
	next ?Node
}

fn half(n i64) ?i64 {
	if n % 2 != 0 || n == 0 {
		return nil
	}
	return n / 2
}

fn sum(head ?Node) i64 {
	mut cur = head
	mut t = 0
	for cur != nil {
		t += cur.val
		cur = cur.next
	}
	return t
}

fn main() {
	mut head ?Node = nil
	for i in 0..5 {
		head = Node{val: i, next: head}
	}
	say.Line(sum(head), sum(nil))
	mut n = half(48)
	mut steps = []i64{}
	for n != nil {
		steps = append(steps, n)
		n = half(n)
	}
	say.Line(steps)
	mut a ?Node = Node{val: 1, next: Node{val: 2, next: nil}}
	mut b ?Node = Node{val: 10, next: nil}
	mut t = 0
	for a != nil && b != nil {
		t += a.val * b.val
		a = a.next
		b = b.next
	}
	say.Line(t)
	mut c ?Node = Node{val: 7, next: nil}
	mut seen = 0
	for c != nil {
		seen += c.val
		if seen > 100 {
			c = nil
		} else {
			c = c.next
		}
	}
	say.Line(seen)
	mut x ?i64 = 5
	for x != nil {
		x += 1
		if x > 7 {
			x = nil
		}
	}
	say.Line(x)
}
