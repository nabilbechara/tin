package main

import "say"

type Entry struct {
	Key  str
	Tags []str
}

mut names []str
let cache map[str]i64 = make(map[str]i64)
mut last str
mut entries []Entry

fn remember(q str) {
	names = append(names, keep(q))
	cache[keep(q)] = len(q)
	last = keep(q)
	let e = Entry{Key: q}
	e.Tags = append(e.Tags, q)
	entries = append(entries, keep(e))
}

fn count(m map[str]i64, k str) i64 {
	return m[k]
}

fn main() {
	for i in 0..3 {
		remember(say.Fmt("req%d", i))
	}
	say.Line(names, len(cache), last, count(cache, "req1"), entries[2].Key, entries[2].Tags)
}
