package main

// Inside the branch that checked a != nil, a holds a number. Assigning nil, or an optional that
// may be nil, ends that (#522): a is optional again, and using it as a number needs a new check.
fn main() {
	mut a ?i64 = 5
	let other ?i64 = 3
	if a != nil {
		a = nil
		let b = a + 1
		a = other
		let c = a * 2
		_ = b
		_ = c
	}
}
