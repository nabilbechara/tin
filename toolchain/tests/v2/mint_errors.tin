package main

// #521: mint faults name mint, and their causes are mint.ErrSyntax and mint.ErrRange.

import "fault"
import "mint"
import "say"

fn main() {
	for s in []str{"12", "x2", "9223372036854775808", "-9223372036854775809", ""} {
		let (v, err) = mint.Atoi(s)
		say.Line(v, err, fault.Is(err, mint.ErrSyntax), fault.Is(err, mint.ErrRange))
	}
	for s in []str{"1.5", "1e400", "-1e400", "1e-400", "abc"} {
		let (v, err) = mint.ParseFloat(s)
		say.Line(v, err, fault.Is(err, mint.ErrSyntax), fault.Is(err, mint.ErrRange))
	}
	let (u, ue) = mint.ParseUint("18446744073709551616", 10)
	say.Line(u, ue, fault.Is(ue, mint.ErrRange))
	let (b, be) = mint.ParseInt("12", 1)
	say.Line(b, be, fault.Is(be, mint.ErrSyntax))
	let (t, te) = mint.ParseBool("maybe")
	say.Line(t, te, fault.Is(te, mint.ErrSyntax))
}
