package main

import "./wycheproofpkg"

// Wycheproof ECDSA P-256 and P-384 vectors with DER signatures (toolchain/tests/wycheproof/ecdsa);
// bench/ref/seal_wycheproof is the Go twin of this test and seal_wycheproof together.
fn main() {
	for _, name in []str{
		"ecdsa/ecdsa_secp256r1_sha256", "ecdsa/ecdsa_secp256r1_sha512", "ecdsa/ecdsa_secp384r1_sha256",
		"ecdsa/ecdsa_secp384r1_sha384", "ecdsa/ecdsa_secp384r1_sha512",
	} {
		wycheproofpkg.Run(name)
	}
}
