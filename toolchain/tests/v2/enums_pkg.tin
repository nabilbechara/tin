package main

import "./enumpkg"
import "say"

fn main() {
	mut sum = 0
	for _, t in enumpkg.Lex("12 apples 30 pears") {
		match t {
			Num(v) => {
				sum += v
			}
			Word(w) => {
				say.Line("word", w)
			}
			End => {
				say.Line("end")
			}
		}
	}
	say.Line(sum, enumpkg.Token.Num(5), enumpkg.Token.Num(5) == enumpkg.Token.Num(5))
}
