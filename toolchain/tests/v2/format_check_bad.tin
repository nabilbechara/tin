package main

// #529: interpolation specs and literal printf formats are checked against their values.

import "say"

fn main() {
	let x = 5
	let name = "bob"
	say.Line("[{x:>4}] [{name:d}]")
	say.Out("%d %s\n", "str", 42)
	say.Out("%d %d\n", 1)
	say.Out("%d\n", 1, 2)
	say.Out("%y\n", 1)
	say.Out("100%\n")
}
