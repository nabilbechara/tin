package main

// #529: a format that is not a literal is checked when it runs: Go's %!(EXTRA ...) and
// %!d(MISSING) markers, with every extra value inside one closed marker.

import "say"

fn main() {
	let f = "[%d]"
	say.Line(say.Fmt(f, 1, 2, "x"))
	say.Line(say.Fmt(f, 5, true))
	let two = "%d %d"
	say.Line(say.Fmt(two, 1))
	say.Line(say.Fmt(f, 3))
	let x = 5
	let pi = 3.14159
	let a = 65
	say.Line("[{x:5}] [{x:-4}] [{x:05}] [{x:x}] [{pi:.2}] [{pi:8.3f}] [{x:+d}] [{a:c}]")
	say.Out("%5.2f|%-4s|%x|%q|%v|%t|%%\n", pi, "ab", 255, "q", []i64{1}, true)
}
