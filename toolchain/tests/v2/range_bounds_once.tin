package main

// #528: a range's bounds and step are evaluated once, before the loop, in source order; a step
// must be positive.

import "say"

mut calls = []str{}

fn note(s str, v i64) i64 {
	calls = append(calls, keep(s))
	return v
}

fn sumTo(xs []i64) i64 {
	mut t = 0
	for i in 0..len(xs) {
		t += xs[i]
	}
	return t
}

fn steps(s i64) !i64 {
	mut n = 0
	guard {
		for i in (0..10).step(s) {
			n += 1
		}
	} catch err {
		fail err
	}
	return n
}

fn main() {
	mut n = 0
	for i in note("lo", 1)..note("hi", 4) {
		n += 1
	}
	say.Line("iterations", n, "calls", calls)
	calls = keep([]str{})
	mut m = 0
	for i in (note("lo", 0)..note("hi", 10)).step(note("step", 3)) {
		m += 1
	}
	say.Line("iterations", m, "calls", calls)

	// changing the bound inside the loop does not change the count
	mut hi = 3
	mut k = 0
	for i in 0..hi {
		hi = 10
		k += 1
	}
	say.Line("hi changed:", k)
	mut xs = []i64{1, 2, 3}
	mut seen = 0
	for i in 0..len(xs) {
		xs = append(xs, i)
		seen += 1
	}
	say.Line("grown:", seen, len(xs))

	// the bound is read outside the loop's own variable
	let i = 4
	mut c = 0
	for i in 0..i {
		c += i
	}
	say.Line("outer bound:", c)

	say.Line(sumTo([]i64{1, 2, 3, 4}))
	for s in []i64{2, 0, -1} {
		let (r, err) = steps(s)
		say.Line("step", s, r, err)
	}
}
