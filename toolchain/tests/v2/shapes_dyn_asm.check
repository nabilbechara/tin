# In the dedicated Log body, dynamic dispatch is exactly one indirect call and no
# allocator call appears. CHECK-NOT scopes end at _main.main, so runtime code after it
# does not affect the assertion.

[arm64]
CHECK: _Log:
CHECK-NOT: _rt_alloc
CHECK: blr
CHECK-NOT: blr
CHECK-NOT: _rt_alloc
CHECK: _main.main:

[amd64]
CHECK: (?m)^L2:$
CHECK-NOT: rt_alloc
CHECK: call rax
CHECK-NOT: call rax
CHECK-NOT: rt_alloc
CHECK: (?m)^L3:$
