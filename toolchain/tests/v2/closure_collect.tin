package main

import "say"
import "sift"

// A closure passed to sift.Each lives no longer than this frame, so it may append request
// memory to a captured local (#181).
fn main() {
	let xs = []i64{3, 1, 2}
	mut out = []str{}
	sift.Each(xs, fn(x i64) { out = append(out, say.Str(x)) })
	say.Line("collected", out)
	let seen = make(map[str]i64)
	sift.Each(xs, fn(x i64) { seen["k{x}"] = x })
	say.Line("map", len(seen), seen["k2"])
	mut last = "none"
	sift.Each(xs, fn(x i64) { last = "item {x}" })
	say.Line("last", last)
	let sorted = sift.Map(xs, fn(x i64) str { return say.Str(x * 10) })
	say.Line("mapped", sorted)
}
