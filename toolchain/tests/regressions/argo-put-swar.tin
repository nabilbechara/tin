package main

import "argo"
import "say"

// An 8-byte chunk ending in a control byte made argo.Put's word-at-a-time scan
// underflow under checked arithmetic and panic (#552).
fn main() {
	mut b = []u8{}
	argo.Put(mut b, "1234567\n")
	argo.Put(mut b, "abcdefg\"")
	argo.Put(mut b, "abcdefg\\")
	argo.Put(mut b, "\x01bcdefgh")
	say.Line(str(b))
}
