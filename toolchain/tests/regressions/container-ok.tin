package main

import "say"

type Box struct {
	Items []str
	n     i64
}

type Page struct {
	box   Box
	lines []str
	title str
}

let gbox Box = Box{Items: []str{"g"}}
mut gboxes []Box

fn (p mut Page) Add(s str) {
	p.lines = append(p.lines, s)
}

fn (p mut Page) Title(s str) {
	p.title = s
}

fn swap(xs mut []Box) {
	let t = xs[0]
	xs[0] = xs[1]
	xs[1] = t
}

fn copied(xs []Box) []Box {
	mut out = []Box{}
	for _, x in xs {
		out = append(out, x)
	}
	return out
}

// Fresh containers that hold long-lived or parameter objects may still take request memory
// themselves, and their parts that are fresh may too.
fn render(b Box, who str) i64 {
	let p = Page{box: b}
	p.Add(say.Fmt("hello %s", who))
	p.Title(who)
	mut xs = []Box{b, Box{}}
	swap(mut xs)
	xs = append(xs, Box{Items: []str{who}})
	return len(p.lines) + len(xs) + xs[0].n
}

fn main() {
	gboxes = append(gboxes, keep(Box{n: 2}))
	let who = say.Fmt("%s-%d", "w", 1)
	mut all = copied(gboxes)
	all = append(all, Box{Items: []str{who}})
	let p = Page{box: gbox}
	p.Add(who)
	say.Line(render(gbox, who), len(all), all[0].n, p.lines[0], len(gbox.Items))
}
