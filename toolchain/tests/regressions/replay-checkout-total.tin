package main

import "anvil"
import "fault"
import "mint"
import "twine"

// A checkout total (#242, saved by tin replay --save-test): the body holds "price qty" lines.
// The recorded request ended in a 500: a blank line was read as a line with two fields and the
// handler indexed past its end. Blank lines are skipped now, so the replay answers 200.

fn total(body str) !i64 {
	mut sum = 0
	for _, line in twine.Split(body, "\n") {
		let f = twine.Fields(line)
		if len(f) == 0 {
			continue
		}
		if len(f) != 2 {
			fail "bad line: " + line
		}
		let price = try mint.Atoi(f[0])
		let qty = try mint.Atoi(f[1])
		sum += price * qty
	}
	return sum
}

fn checkout(q anvil.Req, w mut anvil.Out) {
	let sum = total(q.Body()) catch err {
		w.Status(400)
		w.Text(fault.Message(err) + "\n")
		return
	}
	w.Text("total {sum}\n")
}

fn main() {
	let r = anvil.NewRouter()
	r.Post("/checkout", checkout)
	let err = r.Serve(":8080")
	if err != nil {
		panic(fault.Message(err))
	}
}
