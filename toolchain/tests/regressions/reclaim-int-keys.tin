package main

import "say"

// #176: overwriting an entry of a long-lived map with int keys must not treat the key
// as a pointer (it once segfaulted in rt_rc_drop_fresh).
let hits = map[i64]i64{}
let flags = map[bool]str{}

fn main() {
	for i in 0..1000 {
		hits[7] = hits[7] + 1
		hits[i%13] = i
		flags[i%2 == 0] = keep("v{i}")
	}
	say.Line("hits", hits[7], len(hits), flags[true], flags[false])
}
