package main

import "say"
import "argo"

type F struct {
	X f64
}

type G struct {
	X f32
}

type I struct {
	X i64
	U u64
	B u8
}

fn main() {
	// Numbers follow RFC 8259: -?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?, and must fit f64.
	for _, s in []str{`+5`, `.5`, `1.`, `1.2.3`, `1e`, `1e+`, `1e5e5`, `-`, `--`, `.`, `e`, `01`, `-00`, `0x10`, `1e400`, `-1e400`} {
		let f = F{}
		say.Line(s, argo.Get(`{"X": `+s+`}`, mut f))
	}
	for _, s in []str{`0`, `-0`, `0.5`, `1E+2`, `-1.5e-3`, `1e-400`, `1.7976931348623157e308`} {
		let f = F{}
		let err = argo.Get(`{"X": `+s+`}`, mut f)
		say.Line(s, f.X, err)
	}

	// An f32 must fit f32.
	for _, s in []str{`1e39`, `-3.5e38`, `3.4028235e38`, `1e-46`} {
		let g = G{}
		let err = argo.Get(`{"X": `+s+`}`, mut g)
		say.Line(s, g.X, err)
	}

	// Integers take no leading zeros.
	for _, s in []str{`{"X": 007}`, `{"X": -007}`, `{"X": -}`, `{"U": 007}`, `{"B": 007}`} {
		let n = I{}
		say.Line(s, argo.Get(s, mut n))
	}
	let n = I{}
	mut err = argo.Get(`{"X": -9223372036854775808, "U": 18446744073709551615, "B": 0}`, mut n)
	say.Line(n.X, n.U, n.B, err)
	err = argo.Get(`{"X": -0, "U": 0, "B": 255}`, mut n)
	say.Line(n.X, n.U, n.B, err)

	// Skipped members are checked against the grammar only, as Go does.
	for _, s in []str{`{"Z": 1.2.3}`, `{"Z": 01}`, `{"Z": -}`, `{"Z": [1, 2e]}`, `{"Z": 1e400}`} {
		let f = F{}
		say.Line(s, argo.Get(s, mut f))
	}
}
