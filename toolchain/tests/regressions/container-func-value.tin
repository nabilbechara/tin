package main

import "say"

type Box struct {
	Items []str
}

type Holder struct {
	box Box
}

let gbox Box = Box{}

fn grab(h mut Holder) {
	h.box = gbox
}

// A call through a function value may run grab.
fn main() {
	let f = grab
	let h = Holder{box: Box{}}
	f(mut h)
	h.box.Items = append(h.box.Items, say.Fmt("%d", 1))
	say.Line(len(gbox.Items))
}
