package main

import "say"

type Box struct {
	Items []str
}

type Holder struct {
	box Box
}

let gbox Box = Box{}

fn grab(h mut Holder) {
	h.box = gbox
}

// After grab, h.box is the global's Box.
fn main() {
	let h = Holder{box: Box{}}
	grab(mut h)
	h.box.Items = append(h.box.Items, say.Fmt("%d", 1))
	say.Line(len(gbox.Items))
}
