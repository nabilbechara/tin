package main

// A guarded division must not run on the path that skips it: neither if-conversion
// nor loop-invariant code motion may compute it early.
fn safeDiv(a i64, b i64) i64 {
	mut q = i64(0)
	if b != 0 {
		q = a / b
	}
	return q
}

fn safeRem(a i64, b i64) i64 {
	mut q = i64(0)
	if b != 0 {
		q = a % b
	}
	return q
}

fn avg(sum i64, count i64, xs []i64) i64 {
	mut r = i64(0)
	for _, x in xs {
		r += x + sum / count
	}
	return r
}

fn guardedSum(a i64, b i64, n i64) i64 {
	mut s = i64(0)
	for i in 0..n {
		if b != 0 {
			s += a % b + a / b
		}
	}
	return s
}

fn main() {
	println(safeDiv(7, 0), safeRem(7, 0), avg(10, 0, []i64{}), guardedSum(10, 0, 3))
	println(safeDiv(7, 2), safeRem(7, 2), avg(10, 5, []i64{1, 2}), guardedSum(10, 3, 3))
}
