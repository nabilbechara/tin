package main

import "hearth"
import "say"

type Box struct {
	Items []str
}

let gbox Box = Box{}

// The fresh slice holds the global's Box, so its element is long-lived.
fn remember(q str) {
	mut xs = []Box{}
	xs = append(xs, gbox)
	xs[0].Items = append(xs[0].Items, q)
}

fn main() {
	remember(say.Fmt("secret-%d", 42))
	hearth.Reset()
	say.Line(len(gbox.Items), gbox.Items[0])
}
