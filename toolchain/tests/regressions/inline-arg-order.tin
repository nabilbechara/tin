package main

import "say"

// Inlined calls must still evaluate their arguments left to right, before the body.
type Box struct {
	X i64
}

fn bump(b mut Box) i64 {
	b.X = b.X + 10
	return 0
}

fn push(xs mut []i64) i64 {
	xs = append(xs, 7)
	return 0
}

fn noisy() i64 {
	say.Line("noisy ran")
	return 0
}

fn add(a i64, b i64) i64 {
	return a + b
}

// The body writes through b before it reads a.
fn bumpThenAdd(a i64, b mut Box) i64 {
	return bump(mut b) + a
}

fn main() {
	let box = Box{X: 1}
	say.Line(add(box.X, bump(mut box)))
	let xs = []i64{1, 2}
	say.Line(add(len(xs), push(mut xs)))
	let c = Box{X: 1}
	say.Line(bumpThenAdd(c.X, mut c))
	let x = 5
	let y = 0
	say.Line(add(x / y, noisy()))
}
