package main

import "say"

mut handlers []fn() i64

fn register(f fn() i64) {
	handlers = append(handlers, keep(f))
}

fn makeAll() []fn() i64 {
	mut out = make([]fn() i64, 0, 4)
	for i in 0..4 {
		mut base = i * 100
		out = append(out, fn() i64 {
			base += 1
			return base + i
		})
	}
	return out
}

fn deferred() {
	mut n = 1
	defer fn() {
		say.Line("deferred", n)
	}()
	n = 7
}

fn main() {
	// closures stored by a callee and by append outlive the loop iteration and the frame
	for _, name in []str{"a", "bb", "ccc"} {
		register(fn() i64 {
			return i64(len(name))
		})
	}
	for _, h in handlers {
		say.Line("handler", h())
	}
	let fs = makeAll()
	for _, f in fs {
		say.Line("made", f(), f())
	}
	deferred()
	for k, v in map[str]i64{"x": 1, "y": 2} {
		let g = fn() str {
			return k + say.Fmt("%d", v)
		}
		say.Line("map", g())
	}
}
