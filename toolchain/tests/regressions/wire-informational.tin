package main

import "hearth"
import "mint"
import "relay"
import "say"
import "tide"
import "wire"

// script is the response for path, as parts written 20 ms apart so they arrive in separate reads.
fn script(path str) []str {
	let cont = "HTTP/1.1 100 Continue\r\n\r\n"
	let final = "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok"
	if path == "/coalesced" {
		return []str{cont + final}
	}
	if path == "/split" {
		return []str{"HTTP/1.1 100 Cont", "inue\r\n\r\n", "HTTP/1.1 103 Early Hints\r\nLink: </a.css>; rel=preload\r\n\r\n", "HTTP/1.1 200 OK\r\nX-Final: yes\r\nContent-Length: 5\r\n\r\nfinal"}
	}
	if path == "/early-chunked" {
		return []str{"HTTP/1.1 103 Early Hints\r\nLink: </a.css>\r\n\r\nHTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n2\r\nok\r\n0\r\n\r\n"}
	}
	if path == "/five" {
		return []str{cont + cont + cont + cont, cont + final}
	}
	if path == "/six" {
		return []str{cont + cont + cont + cont + cont + cont + final}
	}
	if path == "/only-continue" {
		return []str{cont}
	}
	if path == "/switch" {
		return []str{"HTTP/1.1 101 Switching Protocols\r\nUpgrade: x\r\nConnection: upgrade\r\n\r\n"}
	}
	return []str{"HTTP/1.1 200 OK\r\nContent-Length: 3\r\n\r\nbye"}
}

// serve answers each request with its script until it sees /stop.
fn serve(l wire.Listener) ! {
	for {
		let c = try l.Accept()
		let req = make([]u8, 0, 1024)
		for {
			let (_, err) = c.Read(mut req, 1024)
			if err != nil {
				fail err
			}
			let s = str(req)
			if len(s) >= 4 && s[len(s)-4:] == "\r\n\r\n" {
				break
			}
		}
		let s = str(req)
		mut sp = 4
		for sp < len(s) && s[sp] != ' ' {
			sp += 1
		}
		let path = s[4:sp]
		let parts = script(path)
		for i, part in parts {
			if i > 0 {
				tide.Sleep(20000000)
			}
			if c.Write(part) != nil {
				break
			}
		}
		c.Close()
		if path == "/stop" {
			return
		}
	}
}

fn show(err fault) str {
	if err == nil {
		return "nil"
	}
	return say.Str(err)
}

fn worker(id i64) {
	if id == 1 {
		let (l, err) = wire.Listen("127.0.0.1:0")
		if err != nil {
			say.Line("listen", err)
			return
		}
		relay.Send(0, mint.Itoa(l.Port()))
		let e2 = serve(l)
		if e2 != nil {
			say.Line("serve error", e2)
		}
		l.Close()
		return
	}
	let (_, port) = relay.Recv()
	let base = "http://127.0.0.1:" + port
	let paths = []str{"/coalesced", "/split", "/early-chunked", "/five", "/six", "/only-continue", "/switch", "/stop"}
	for _, p in paths {
		let (r, err) = wire.Get(base + p)
		say.Line(p, r.Status, say.Fmt("%q", r.Body), say.Fmt("%q", r.Header("X-Final")), say.Fmt("%q", r.Header("Link")), show(err))
	}
}

fn main() {
	hearth.Run(2, worker)
}
