package main
import "wire"
import "say"
import "quarry"
func main() {
    l := wire.Listen("[::1]:0") catch err { panic(err) }
    defer l.Close()
    quarry.Eprint(say.Str(l.Port())+"\n")
    c := l.Accept() catch err { panic(err) }
    defer c.Close()
    s := c.ReadFull(4) catch err { panic(err) }
    c.Write(s) catch err { panic(err) }
}
