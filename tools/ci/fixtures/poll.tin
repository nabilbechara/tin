package main

import "anvil"
import "quarry"
import "say"

var cleaned i64

func finish() {
	cleaned++
}

func spin(q anvil.Req, w mut anvil.Out) {
	defer finish()
	for {
	}
}

func plain(q anvil.Req, w mut anvil.Out) {
	w.Text("ok")
}

func count(q anvil.Req, w mut anvil.Out) {
	w.Text(say.Str(cleaned))
}

func main() {
	r := anvil.NewRouter()
	r.Get("/spin", spin)
	r.Get("/plain", plain)
	r.Get("/count", count)
	say.Line(r.Serve(":" + quarry.Getenv("PORT")))
}
