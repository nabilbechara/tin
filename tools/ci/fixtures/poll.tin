package main

import "anvil"
import "quarry"
import "say"
import "tide"

mut cleaned i64 = 0

fn finish() {
	cleaned += 1
}

fn spin(q anvil.Req, w mut anvil.Out) {
	defer finish()
	for {
	}
}

fn slow_cleanup() {
	tide.Wait(40*tide.Millisecond) catch _ {}
}

fn guarded_body() ! {
	defer slow_cleanup()
	panic("cleanup probe")
}

fn guard_wait(q anvil.Req, w mut anvil.Out) {
	guard {
		try guarded_body()
	} catch _ {}
	w.Text("guard ok")
}

fn plain(q anvil.Req, w mut anvil.Out) {
	w.Text("ok")
}

fn count(q anvil.Req, w mut anvil.Out) {
	w.Text(say.Str(cleaned))
}

fn main() {
	let r = anvil.NewRouter()
	r.Get("/spin", spin)
	r.Get("/plain", plain)
	r.Get("/guard-wait", guard_wait)
	r.Get("/count", count)
	say.Line(r.Serve(":" + quarry.Getenv("PORT")))
}
