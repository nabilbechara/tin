package main

import "anvil"
import "lane"
import "say"
import "tide"

fn fetch(i i64, failAt i64) !str {
	if i == failAt {
		fail "child {i} failed"
	}
	try tide.Wait(100 * tide.Millisecond)
	return "p{i}"
}

fn fetchAll(n i64, failAt i64) ![]str {
	let pages = make([]str, n)
	scope s {
		for i in 0..n {
			let k = i
			s.spawn(fn() ! {
				pages[k] = try fetch(k, failAt)
			})
		}
	}
	return pages
}

// fetch runs 4 children that each wait 50 ms: together they take about 50 ms.
fn all(q anvil.Req, w mut anvil.Out) {
	let pages = fetchAll(4, -1) catch err {
		w.Status(500)
		w.Text("fault: {err}")
		return
	}
	w.Text(say.Str(pages))
}

// fail has one child fail at once: the others are cancelled instead of waiting 50 ms.
fn fails(q anvil.Req, w mut anvil.Out) {
	let pages = fetchAll(4, 2) catch err {
		w.Text("fault: {err}")
		return
	}
	w.Text("never {len(pages)}")
}

mut flushed str = ""

fn record(s str) {
	flushed = keep(flushed + s + ";")
}

// later detaches work that outlives the request: it captures the request's path and runs
// after the response, on the core's event loop.
fn later(q anvil.Req, w mut anvil.Out) {
	let path = q.Path
	detach {
		try tide.Wait(20 * tide.Millisecond)
		record(path)
	}
	w.Text("detached")
}

// failing detaches work that fails: the fault is logged and the server goes on.
fn failing(q anvil.Req, w mut anvil.Out) {
	detach {
		fail "background work failed"
	}
	w.Text("detached")
}

fn seen(q anvil.Req, w mut anvil.Out) {
	w.Text(flushed)
}

fn pick() !str {
	mut jobs = lane.New[str](1)
	mut got str = ""
	scope s {
		s.spawn(fn() ! {
			try tide.Wait(10 * tide.Millisecond)
			try jobs.Send("job")
		})
		select {
			let j = jobs.Recv() => { got = j }
			after(tide.Second) => { got = "timeout" }
		}
	}
	return got
}

// picked runs a select inside the request: the child's value wins over the 1 s timer.
fn picked(q anvil.Req, w mut anvil.Out) {
	let got = pick() catch err {
		w.Text("fault: {err}")
		return
	}
	w.Text(got)
}

fn main() {
	mut r = anvil.NewRouter()
	r.Get("/all", all)
	r.Get("/fail", fails)
	r.Get("/later/one", later)
	r.Get("/later/two", later)
	r.Get("/failing", failing)
	r.Get("/seen", seen)
	r.Get("/select", picked)
	let err = r.Serve(":0")
	say.Line(err)
}
