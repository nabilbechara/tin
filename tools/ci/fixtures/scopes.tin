package main

import "anvil"
import "say"
import "tide"

fn fetch(i i64, failAt i64, ms i64) !str {
	if i == failAt {
		fail "child {i} failed"
	}
	try tide.Wait(ms * tide.Millisecond)
	return "p{i}"
}

// fetchAll gives the pages and the most children that were waiting at once in this request.
fn fetchAll(n i64, failAt i64, ms i64) !str {
	let pages = make([]str, n)
	mut waiting i64 = 0
	mut most i64 = 0
	scope s {
		for i in 0..n {
			let k = i
			s.spawn(fn() ! {
				waiting += 1
				if waiting > most {
					most = waiting
				}
				pages[k] = try fetch(k, failAt, ms)
				waiting -= 1
			})
		}
	}
	return "{pages} {most} at once"
}

// all runs 4 children that each wait 100 ms: all 4 are waiting at once.
fn all(q anvil.Req, w mut anvil.Out) {
	let got = fetchAll(4, -1, 100) catch err {
		w.Status(500)
		w.Text("fault: {err}")
		return
	}
	w.Text(got)
}

// fails has one child fail at once: the others are cancelled instead of waiting 5 s.
fn fails(q anvil.Req, w mut anvil.Out) {
	let got = fetchAll(4, 2, 5000) catch err {
		w.Text("fault: {err}")
		return
	}
	w.Text("never {got}")
}

fn main() {
	mut r = anvil.NewRouter()
	r.Get("/all", all)
	r.Get("/fail", fails)
	let err = r.Serve(":0")
	say.Line(err)
}
