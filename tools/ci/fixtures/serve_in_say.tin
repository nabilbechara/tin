package main

import "anvil"
import "quarry"
import "say"

// #347: Serve is say.Line's argument, and the handler keeps request data in a global. The
// arguments are evaluated before say.Line opens its formatting frame, so the frame is not
// open while requests run, and SIGTERM ends the program with <nil> and exit 0.
mut kept = make([]str, 0, 0)

fn h(q anvil.Req, w mut anvil.Out) {
	if q.Path == "/add" {
		kept = append(kept, keep(q.Body()))
	}
	w.Text("len={len(kept)}")
}

fn main() {
	say.Line(anvil.Serve(":" + quarry.Getenv("PORT"), h))
}
