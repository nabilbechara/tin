package replaysecret

import "fault"
import "quarry"
import "replay"
import "say"

// Copied into a temporary lib/replaysecret by replay_check.py: runs an edition 1 program's work
// in a task with a recording tape, then again replaying it (#241, query.Hidden).

var gWork func() str
var gTape i64
var summary str

func inTask(tp i64) str {
	gTape = tp
	summary = ""
	s := rt_scope_open()
	s.spawn(func() ! {
		rt_tape_set(curTask, gTape)
		summary = gWork()
		rt_tape_set(curTask, 0)
	})
	rt_scope_close(s) catch err {
		say.Line("task:", fault.Message(err))
	}
	return summary
}

// Run records work, writes its tape to TAPE_OUT, and replays it.
func Run(work func() str) {
	say.Line("recording on:", replay.Setup(1))
	gWork = work
	tp := rt_tape_new(1)
	recorded := inTask(tp)
	say.Line("recorded:", recorded)
	quarry.WriteFile(quarry.Getenv("TAPE_OUT"), rt_str_from_raw(tp[1], tp[2])) catch err {
		say.Line("tape:", fault.Message(err))
	}
	rp := rt_tape_new(2)
	rt_tape_load(rp, tp[1], tp[2])
	replayed := inTask(rp)
	say.Line("replayed same:", replayed == recorded, "left:", rt_tape_left(rp), "diverged:", rt_tape_diverged(rp))
}
