// Appended to a temporary copy of lib/tide/tide.tin by cancel_check.py.
var probeBnd = make([]i64, 32)

// ProbeMark remembers the current boundary in slot i.
func ProbeMark(i i64) {
	probeBnd[i] = rt_bnd_current()
}

// ProbeCancel cancels the boundary in slot i with a heap-owned reason.
func ProbeCancel(i i64, reason str) {
	rt_bnd_cancel(probeBnd[i], cast(fault, rt_heap_str(reason)))
}

// ProbeEnter enters a block boundary and returns it.
func ProbeEnter() i64 {
	return rt_bnd_enter(bkWithin)
}

func ProbeLeave(b i64) {
	rt_bnd_leave(b)
}

func ProbeCurrent() i64 {
	return rt_bnd_current()
}

// ProbeCanceled is b's cancel reason, or "".
func ProbeCanceled(b i64) str {
	r := rt_bnd_canceled(b)
	if r == 0 {
		return ""
	}
	return cast(str, r)
}

// ProbeDeadline sets b's own deadline ms from now.
func ProbeDeadline(b i64, ms i64) {
	rt_bnd_set_deadline(b, rt_mono_ns()+ms*1000000)
}
