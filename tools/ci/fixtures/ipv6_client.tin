package main
import "wire"
import "quarry"
import "say"
func main() {
    c := wire.DialTimeout(quarry.Args()[1],3000000000) catch err { panic(err) }
    defer c.Close()
    c.Write("IPv6") catch err { panic(err) }
    s := c.ReadFull(4) catch err { panic(err) }
    if s != "IPv6" { panic("IPv6 client echo") }
    say.Line(s)
}
