package main
import "helperprobe"
import "quarry"
import "twine"
import "mint"
import "say"
func main() {
    args := quarry.Args()
    if args[1] == "calendar" {
        text := quarry.ReadStdin() catch err { panic(err) }
        for _, s := range twine.Fields(text) {
            n := mint.Atoi(s) catch err { panic(err) }
            helperprobe.Calendar(n)
        }
    }
    if args[1] == "errors" {
        for n := -2; n < 140; n++ { helperprobe.Error(n) }
    }
    if args[1] == "tty" {
        for _, arg := range args[2:] {
            n := mint.Atoi(arg) catch err { panic(err) }
            helperprobe.TTY(n)
        }
    }
    if args[1] == "hostname" {
        host := quarry.Hostname() catch err { panic(err) }
        say.Out("%q\n",host)
    }
    if args[1] == "cpus" { helperprobe.CPUs() }
}
