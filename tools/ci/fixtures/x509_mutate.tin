package main

import "say"
import "seal"
import "quarry"
import "mint"

// x509_mutate FILE BLOCK: XORs each byte of the BLOCK-th certificate in FILE (from 0) with 0x01,
// 0x80 and 0xff and prints "BLOCK BYTE XOR rejected" for each mutant that fails to parse.
// tools/ci/x509_check.py runs it once per certificate (memory is only reclaimed at exit);
// bench/ref/x509_mutate is the Go twin.
func main() {
	args := quarry.Args()
	if len(args) != 3 {
		say.Line("usage: x509_mutate FILE BLOCK")
		return
	}
	k := mint.Atoi(args[2]) catch err {
		say.Line("bad block:", err)
		return
	}
	text := quarry.ReadFile(args[1]) catch err {
		say.Line(args[1], err)
		return
	}
	blocks := seal.DecodePEM(text) catch err {
		say.Line(args[1], err)
		return
	}
	if k >= len(blocks) {
		say.Line("no block", k)
		return
	}
	der := blocks[k].Bytes
	m := make([]u8, len(der))
	accepted := 0
	for i := 0; i < len(der); i++ {
		for _, x := range []u8{0x01, 0x80, 0xff} {
			copy(m, der)
			m[i] ^= x
			_, err := seal.ParseCertificate(m)
			if err == nil {
				accepted++
			} else {
				say.Line(k, i, x, "rejected")
			}
		}
	}
	say.Line(k, "accepted", accepted)
}
