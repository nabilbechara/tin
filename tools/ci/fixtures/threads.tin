package main

import "quarry"
import "say"
import "threadprobe"
import "twine"

// lines counts the lines of a /proc file (mappings or task entries).
func lines(path str) i64 {
    text, err := quarry.ReadFile(path)
    if err != nil {
        return -1
    }
    return twine.Count(text, "\n")
}

func threads() str {
    text, err := quarry.ReadFile("/proc/self/status")
    if err != nil {
        return say.Str(err)
    }
    for _, line := range twine.Split(text, "\n") {
        if twine.HasPrefix(line, "Threads:") {
            return twine.TrimSpace(line[8:])
        }
    }
    return "?"
}

func main() {
    args := quarry.Args()
    if len(args) > 1 && args[1] == "overflow" {
        threadprobe.Overflow()
    }
    threadprobe.Cycle(8)
    before := lines("/proc/self/maps")
    ok := threadprobe.Cycle(200)
    after := lines("/proc/self/maps")
    say.Line("cores returned:", ok)
    say.Line("records live:", threadprobe.Live())
    say.Line("threads:", threads())
    say.Line("mappings grew:", after-before > 16)
}
