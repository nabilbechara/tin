// Appended to a temporary copy of lib/tide/tide.tin by guard_check.py.
var probeCleaned = 0

// ProbeCleanup registers a resource-cleanup callback (rt_task_cleanup) that records tag.
func ProbeCleanup(tag i64) {
	rt_task_cleanup(probe_cleaned, tag)
}

func probe_cleaned(tag i64) {
	probeCleaned = probeCleaned*10 + tag
}

// ProbeCleaned is the tags of the callbacks run so far, in order, as decimal digits.
func ProbeCleaned() i64 {
	return probeCleaned
}
