// The compiler host path helper is also exercised directly, beyond /proc/self/exe.
fn main(argc,argv) {
    let out=calloc(4096,1);
    let i=1;
    while i < argc {
        if host_realpath(argv[i],out) { rt_sys_write(1,out,strlen(out)); } else { rt_sys_write(1,"<nil>",5); }
        rt_sys_write(1,"\n",1);
        i=i+1;
    }
    free(out);
    return 0;
}
