package main

import "fault"
import "say"
import "tide"

mut log str = ""

fn note(s str) {
	log = keep(log + s)
}

fn boom(xs []i64, i i64) i64 {
	tide.ProbeCleanup(2)
	defer note("defer;")
	return xs[i]
}

fn run() ! {
	scope s {
		s.spawn(fn() ! {
			tide.ProbeCleanup(1)
			let v = guard boom([]i64{1, 2, 3}, 5) catch err {
				note("fault {fault.Is(err, fault.Panic)};")
				note("cleaned {tide.ProbeCleaned()};")
				0
			}
			note("after {v};")
		})
	}
}

fn main() {
	run() catch err {
		say.Line("never", err)
	}
	say.Line(log, "task end cleaned", tide.ProbeCleaned())
}
