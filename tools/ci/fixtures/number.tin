package main

import "flume"
import "gauge"
import "mint"
import "say"
import "twine"


func check(line str) {
    fields := twine.Split(line, "\t")
    if fields[0] == "P" {
        v, err := mint.ParseFloat(fields[1])
        if err != nil { say.Line("ERR", err) } else { say.Line(gauge.F64bits(v)) }
        return
    }
    bits := mint.ParseUint(fields[1], 10) catch err { panic(err) }
    v := mint.F64frombits(bits)
    if fields[0] == "F" {
        prec := mint.Atoi(fields[3]) catch err { panic(err) }
        say.Line(mint.FormatFloat(v, fields[2][0], prec))
    } else if fields[3] == "32" {
        say.Line(say.Fmt(fields[2], f32(v)))
    } else {
        say.Line(say.Fmt(fields[2], v))
    }
}

func main() {
    input := flume.New(0)
    for {
        line, ok, err := input.Line()
        if err != nil { panic(err) }
        if !ok { break }
        check(line)
    }
}
