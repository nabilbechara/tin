package main

import "quarry"
import "say"

// Generate rewrites docs/COVERAGE.md from its maintained source in notes/coverage.md.
func main() {
	contents := quarry.ReadFile("notes/coverage.md") catch e {
		say.Line("gencoverage: " + say.Str(e))
		quarry.Exit(1)
		return
	}
	quarry.WriteFile("docs/COVERAGE.md", contents) catch e {
		say.Line("gencoverage: " + say.Str(e))
		quarry.Exit(1)
		return
	}
}
