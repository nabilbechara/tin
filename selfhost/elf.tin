// ELF writer: a static position-independent Linux arm64 executable. Tin's own _start reads
// argc, argv and envp from the kernel's initial stack: there is no interpreter, no dynamic
// section and no C library (#125).
//
// Layout (vaddr == file offset, segments 64 KiB aligned so any kernel page size works):
//   R   : ELF header, program headers, function names, backtrace records
//   RX  : _start, the program's code, C strings, Tin strings, constants
//   RW  : globals, function descriptors

const E_ALIGN = 65536;
const E_START_WORDS = 13;

fn el_phdr(p, typ, flags, off, vaddr, filesz, memsz, align) {
    put32(p, typ);
    put32(p + 4, flags);
    put64(p + 8, off);
    put64(p + 16, vaddr);
    put64(p + 24, vaddr);
    put64(p + 32, filesz);
    put64(p + 40, memsz);
    put64(p + 48, align);
    return p + 56;
}

// el_check_static stops the link when the program would import a function: a Linux
// executable is static, and only the macOS runtime files declare externs (#125).
fn el_check_static() {
    let i = 0;
    while i < prog_fns[VEC_LEN] {
        let f = vec_get(prog_fns, i);
        if f[F_EXTERN] && f[F_USED] {
            let b = buf_new();
            buf_str(b, "a Linux executable is static, but the program imports ");
            buf_str(b, f[F_NAME]);
            buf_byte(b, 0);
            link_fail(b[VEC_DATA]);
        }
        i = i + 1;
    }
}

// el_start_static writes the static _start at p (address at): main(argc, argv, envp) from the
// kernel's initial stack, with no frame or link register, then exit_group (94) with its result.
fn el_start_static(p, at, main_addr) {
    put32(p, 0xD280001D);
    put32(p + 4, 0xD280001E);
    put32(p + 8, 0xF94003E0);
    put32(p + 12, 0x910023E1);
    put32(p + 16, 0x8B000C22);
    put32(p + 20, 0x91002042);
    put32(p + 24, 0x94000000 | (((main_addr - (at + 24)) >> 2) & 0x3ffffff));
    put32(p + 28, 0xD2800BC8);
    put32(p + 32, 0xD4000001);
    put32(p + 36, 0xD4200000);
    put32(p + 40, 0xD4200000);
    put32(p + 44, 0xD4200000);
    put32(p + 48, 0xD4200000);
}

fn write_elf(path) {
    let nvars = prog_vars[VEC_LEN];
    el_check_static();
    lk_imports = vec_new();

    // Function names (tin.<name>) and, after them, one backtrace record per function:
    // [start, end, name offset] (the runtime's symbol table).
    let dstr = buf_new();
    buf_byte(dstr, 0);
    let name_off = vec_new();
    let own = vec_new();
    let i = 0;
    while i < prog_fns[VEC_LEN] {
        let f = vec_get(prog_fns, i);
        if !f[F_EXTERN] && f[F_REACH] {
            vec_push(own, f);
            vec_push(name_off, dstr[VEC_LEN]);
            buf_str(dstr, "tin.");
            buf_str(dstr, f[F_QNAME]);
            buf_byte(dstr, 0);
        }
        i = i + 1;
    }

    // Read-only segment: headers, names, backtrace records.
    let ph_off = 64;
    let phnum = 5;
    let dynstr_off = ph_off + 56 * phnum;
    lk_btrace = align_up(dynstr_off + dstr[VEC_LEN], 8);
    let ro_end = lk_btrace+8+24*own[VEC_LEN];

    // Text segment: _start, code, strings, constants.
    let text_addr = align_up(ro_end, E_ALIGN);
    let start_addr = text_addr;
    let pc = text_addr + 4 * E_START_WORDS;
    lk_labels = vec_filled(g_labels + 1, 0);
    i = 0;
    while i < code[VEC_LEN] {
        let op = vec_get(code, i);
        if op == I_LABEL {
            lk_labels[VEC_DATA][vec_get(code, i + 1)] = pc;
        } else if op == I_FUNC {
            vec_get(code, i + 1)[F_ADDR] = pc;
        } else {
            pc = pc + 4;
        }
        i = i + 5;
    }
    lk_stubs = pc;  // the end of the code: there are no import stubs
    lk_strs = vec_new();
    i = 0;
    while i < g_str_ptrs[VEC_LEN] {
        vec_push(lk_strs, pc);
        pc = pc + vec_get(g_str_lens, i) + 1;
        i = i + 1;
    }
    pc = align_up(pc, 8);
    lk_zero = pc;
    pc = pc + 32;
    lk_tstrs = vec_new();
    i = 0;
    while i < g_tstr_ptrs[VEC_LEN] {
        vec_push(lk_tstrs, pc);
        pc = align_up(pc + 8 + vec_get(g_tstr_lens, i) + 1, 8);
        i = i + 1;
    }
    let text_end = pc;

    // Data segment: globals, then function descriptors.
    let data_addr = align_up(text_end, E_ALIGN);
    lk_got = data_addr;
    lk_data = data_addr;
    lk_fndescs = lk_data + 8 * nvars;
    let data_end = lk_fndescs + 16 * prog_fns[VEC_LEN] + 8;
    let file_size = data_end;
    let img = calloc(file_size, 1);

    // ELF header.
    store8(img, 0x7f);
    store8(img + 1, 'E');
    store8(img + 2, 'L');
    store8(img + 3, 'F');
    store8(img + 4, 2);
    store8(img + 5, 1);
    store8(img + 6, 1);
    put32(img + 16, 3 | (183 << 16));
    put32(img + 20, 1);
    put64(img + 24, start_addr);
    put64(img + 32, ph_off);
    put64(img + 40, 0);
    put32(img + 48, 0);
    put32(img + 52, 64 | (56 << 16));
    put32(img + 56, phnum | (64 << 16));
    put32(img + 60, 0);

    // Program headers: PHDR, LOAD R, LOAD RX, LOAD RW, GNU_STACK.
    let p = img + ph_off;
    p = el_phdr(p, 6, 4, ph_off, ph_off, 56 * phnum, 56 * phnum, 8);
    p = el_phdr(p, 1, 4, 0, 0, ro_end, ro_end, E_ALIGN);
    p = el_phdr(p, 1, 5, text_addr, text_addr, text_end - text_addr, text_end - text_addr, E_ALIGN);
    p = el_phdr(p, 1, 6, data_addr, data_addr, data_end - data_addr, data_end - data_addr, E_ALIGN);
    p = el_phdr(p, 0x6474e551, 6, 0, 0, 0, 0, 16);

    memcpy(img + dynstr_off, dstr[VEC_DATA], dstr[VEC_LEN]);
    put64(img+lk_btrace,own[VEC_LEN]);
    i=0;
    while i < own[VEC_LEN] {
        let f=vec_get(own,i);
        let end=lk_stubs;
        if i+1 < own[VEC_LEN] { end=vec_get(own,i+1)[F_ADDR]; }
        let rec=img+lk_btrace+8+24*i;
        put64(rec,f[F_ADDR]); put64(rec+8,end);
        put64(rec+16,dynstr_off+vec_get(name_off,i));
        i=i+1;
    }

    el_start_static(img + start_addr, start_addr, entry_fn()[F_ADDR]);

    // Machine code.
    let q = img + start_addr + 4 * E_START_WORDS;
    pc = start_addr + 4 * E_START_WORDS;
    i = 0;
    while i < code[VEC_LEN] {
        let op = vec_get(code, i);
        if op != I_LABEL && op != I_FUNC {
            put32(q, encode(code[VEC_DATA] + 8 * i, pc));
            q = q + 4;
            pc = pc + 4;
        }
        i = i + 5;
    }
    i = 0;
    while i < g_str_ptrs[VEC_LEN] {
        memcpy(img + vec_get(lk_strs, i), vec_get(g_str_ptrs, i), vec_get(g_str_lens, i));
        i = i + 1;
    }
    i = 0;
    while i < g_tstr_ptrs[VEC_LEN] {
        let at = img + vec_get(lk_tstrs, i);
        put64(at, vec_get(g_tstr_lens, i));
        memcpy(at + 8, vec_get(g_tstr_ptrs, i), vec_get(g_tstr_lens, i));
        i = i + 1;
    }
    i = 0;
    while i < nvars {
        put64(img + lk_data + 8 * i, vec_get(prog_vars, i)[D_VAL]);
        i = i + 1;
    }

    rt_sys_unlink(path);
    let fd = rt_sys_creat(path, 493);
    if (fd & 0x80000000) != 0 {
        let e = err_code(NO_POS, "E904 CANNOT_CREATE");
        buf_str(e, "cannot create ");
        buf_str(e, path);
        fatal(e);
    }
    let out = malloc(24);
    out[VEC_LEN] = file_size;
    out[VEC_CAP] = file_size;
    out[VEC_DATA] = img;
    write_all(fd, out);
    rt_sys_close(fd);
}
