// UTC Gregorian decomposition uses whole 400-year eras, including dates before 1970.
func rt_calendar(now i64, out i64) {
    days := now/86400
    seconds := now%86400
    if seconds < 0 { days--; seconds += 86400 }
    weekday := (days+4)%7
    if weekday < 0 { weekday += 7 }
    z := days+719468
    era := z/146097
    if z < 0 { era = (z-146096)/146097 }
    dayOfEra := z-era*146097
    yearOfEra := (dayOfEra-dayOfEra/1460+dayOfEra/36524-dayOfEra/146096)/365
    year := yearOfEra+era*400
    dayOfYear := dayOfEra-(365*yearOfEra+yearOfEra/4-yearOfEra/100)
    monthPart := (5*dayOfYear+2)/153
    day := dayOfYear-(153*monthPart+2)/5+1
    month := monthPart+3
    if monthPart >= 10 { month = monthPart-9; year++ }
    out[0] = year
    out[1] = month
    out[2] = day
    out[3] = seconds/3600
    out[4] = seconds/60%60
    out[5] = seconds%60
    out[6] = weekday
}

func rt_date_two(p i64, n i64) {
    store8(p,'0'+n/10)
    store8(p+1,'0'+n%10)
}

// rt_http_date returns the existing HTTP Date header, including CRLF.
func rt_http_date(now i64) str {
    fields := rt_alloc(56)
    rt_calendar(now,fields)
    year := rt_i64str(fields[0])
    width := len(year)
    if width < rt_date_year_width() { width = rt_date_year_width() }
    raw := rt_str_new(33+width)
    p := raw+8
    memcpy(p,cast(i64,"Date: Sun, 00 Jan ")+8,18)
    memcpy(p+6,cast(i64,"SunMonTueWedThuFriSat")+8+fields[6]*3,3)
    rt_date_two(p+11,fields[2])
    memcpy(p+14,cast(i64,"JanFebMarAprMayJunJulAugSepOctNovDec")+8+(fields[1]-1)*3,3)
    memset(p+18,'0',width)
    if year[0] == '-' {
        store8(p+18,'-')
        memcpy(p+18+width-len(year)+1,cast(i64,year)+9,len(year)-1)
    } else { memcpy(p+18+width-len(year),cast(i64,year)+8,len(year)) }
    memcpy(p+18+width,cast(i64," 00:00:00 GMT\r\n")+8,15)
    rt_date_two(p+19+width,fields[3])
    rt_date_two(p+22+width,fields[4])
    rt_date_two(p+25+width,fields[5])
    return cast(str,raw)
}

func rt_wall_seconds() i64 {
    ns := rt_wall_ns()
    seconds := ns/1000000000
    if ns < 0 && ns%1000000000 != 0 { seconds-- }
    return seconds
}
