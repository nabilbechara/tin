// Linker-emitted [count, start/end/name records] uses image-relative addresses.
func rt_symbol_lookup(addr i64, info i64) i64 {
    base := __image_base()
    table := __tin_symbols()
    pc := addr-base
    for i := i64(0); i < table[0]; i++ {
        rec := table+8+24*i
        if pc >= rec[0] && pc < rec[1] { info[2] = base+rec[2]; return 1 }
    }
    info[2] = 0
    return 0
}
