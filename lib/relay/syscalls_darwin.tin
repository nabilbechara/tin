// Darwin system calls retain libSystem.
package relay

extern fn fcntl(fd i64, cmd i64, ...) i64
fn rt_sys_fcntl(fd i64, cmd i64, arg i64) i64 { return fcntl(fd, cmd, arg) }
extern fn pipe(fds i64) i64
fn rt_sys_pipe(fds i64) i64 { return pipe(fds) }
extern fn poll(fds i64, n i64, timeout i64) i64
fn rt_sys_poll(fds i64, n i64, timeout i64) i64 { return poll(fds, n, timeout) }
