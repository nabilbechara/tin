package seal

// seal on Linux: where distributions keep the trusted root certificates (the files Go's crypto/x509 reads).

// rootFiles lists the PEM bundles SystemRoots tries, in order.
func rootFiles() []str {
	return []str{
		"/etc/ssl/certs/ca-certificates.crt",
		"/etc/pki/tls/certs/ca-bundle.crt",
		"/etc/ssl/ca-bundle.pem",
		"/etc/pki/tls/cacert.pem",
		"/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem",
		"/etc/ssl/cert.pem",
	}
}
