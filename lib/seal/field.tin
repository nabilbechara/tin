package seal

// ---- constant-time arithmetic modulo an odd prime, in Montgomery form ----
// An element is a []u64 of n 32-bit limbs, least significant first, holding x*R mod m with
// R = 2^(32n). Every function here runs in time that depends only on n and on public
// exponents: no branch or index depends on an element's value. P-256 (p256.tin) uses it for
// its field and its scalars; P-384 and other prime fields can reuse it with their constants.

// monty is a prime modulus with its Montgomery constants and scratch space.
type monty struct {
	m    []u64 // the modulus
	rr   []u64 // R^2 mod m
	one  []u64 // R mod m (1 in Montgomery form)
	minv u64   // -m^-1 mod 2^32
	n    i64   // limbs
	t    []u64 // n+2 words of scratch
	u    []u64 // n words of scratch
}

fn new_monty(m []u64, rr []u64, one []u64, minv u64) monty {
	let n = len(m)
	return monty{m: m, rr: rr, one: one, minv: minv, n: n, t: make([]u64, n+2), u: make([]u64, n)}
}

// elem returns a new zero element of f.
fn (f monty) elem() []u64 {
	return make([]u64, f.n)
}

// mul sets z = x*y/R mod m (CIOS Montgomery multiplication); z may alias x or y.
@wrap fn (f mut monty) mul(z mut []u64, x []u64, y []u64) {
	let n = f.n
	let t = f.t
	for i in 0..n+2 {
		t[i] = 0
	}
	for i in 0..n {
		let yi = y[i]
		mut c = u64(0)
		for j in 0..n {
			let s = t[j] + x[j]*yi + c
			t[j] = s & 0xffffffff
			c = s >> 32
		}
		mut s = t[n] + c
		t[n] = s & 0xffffffff
		t[n+1] = s >> 32
		let mm = (t[0] * f.minv) & 0xffffffff
		s = t[0] + mm*f.m[0]
		c = s >> 32
		for j in 1..n {
			s = t[j] + mm*f.m[j] + c
			t[j-1] = s & 0xffffffff
			c = s >> 32
		}
		s = t[n] + c
		t[n-1] = s & 0xffffffff
		t[n] = t[n+1] + (s >> 32)
	}
	f.reduce(mut z, t, t[n])
}

// The arithmetic below is @wrap (#362): the borrows and masks wrap modulo 2^64 by design, the
// 32-bit limbs keep products and carries in u64, and constant-time code takes no value-dependent branch.
// reduce sets z = t - m if the n+1-word value (t[:n], top) is at least m, else t, in constant
// time; t < 2m.
@wrap fn (f mut monty) reduce(z mut []u64, t []u64, top u64) {
	let n = f.n
	let d = f.u
	mut b = u64(0)
	for j in 0..n {
		let s = t[j] - f.m[j] - b
		d[j] = s & 0xffffffff
		b = (s >> 32) & 1
	}
	// Keep t only when the subtraction borrowed past the top word.
	let keep_ = b & (1 ^ top)
	let mask = u64(0) - keep_
	for j in 0..n {
		z[j] = (t[j] & mask) | (d[j] & ^mask)
	}
}

// add sets z = x + y mod m; z may alias x or y.
@wrap fn (f mut monty) add(z mut []u64, x []u64, y []u64) {
	let n = f.n
	let t = f.t
	mut c = u64(0)
	for j in 0..n {
		let s = x[j] + y[j] + c
		t[j] = s & 0xffffffff
		c = s >> 32
	}
	f.reduce(mut z, t, c)
}

// sub sets z = x - y mod m; z may alias x or y.
@wrap fn (f mut monty) sub(z mut []u64, x []u64, y []u64) {
	let n = f.n
	let t = f.t
	mut b = u64(0)
	for j in 0..n {
		let s = x[j] - y[j] - b
		t[j] = s & 0xffffffff
		b = (s >> 32) & 1
	}
	// Add m back when it borrowed.
	let mask = u64(0) - b
	mut c = u64(0)
	for j in 0..n {
		let s = t[j] + (f.m[j] & mask) + c
		z[j] = s & 0xffffffff
		c = s >> 32
	}
}

// set copies x into z.
fn (f monty) set(z mut []u64, x []u64) {
	for j in 0..f.n {
		z[j] = x[j]
	}
}

// sel sets z = a when bit is 1 and z = b when bit is 0, in constant time.
@wrap fn (f monty) sel(z mut []u64, a []u64, b []u64, bit u64) {
	let mask = u64(0) - bit
	for j in 0..f.n {
		z[j] = (a[j] & mask) | (b[j] & ^mask)
	}
}

// is_zero is 1 when x is zero, else 0, in constant time.
@wrap fn (f monty) is_zero(x []u64) u64 {
	mut v = u64(0)
	for j in 0..f.n {
		v |= x[j]
	}
	return 1 ^ ((v | (u64(0) - v)) >> 63)
}

// equal is 1 when x == y, else 0, in constant time.
@wrap fn (f monty) equal(x []u64, y []u64) u64 {
	mut v = u64(0)
	for j in 0..f.n {
		v |= x[j] ^ y[j]
	}
	return 1 ^ ((v | (u64(0) - v)) >> 63)
}

// exp sets z = x^e (e big-endian and public) in Montgomery form; z may alias x.
@wrap fn (f mut monty) exp(z mut []u64, x []u64, e []u8) {
	let acc = f.elem()
	let base = f.elem()
	f.set(mut base, x)
	f.set(mut acc, f.one)
	for i in 0..len(e) {
		{
			mut bit = 7
			for bit >= 0 {
				f.mul(mut acc, acc, acc)
				if (e[i]>>u8(bit))&1 == 1 {
					f.mul(mut acc, acc, base)
				}
				bit -= 1
			}
		}
	}
	f.set(mut z, acc)
}

// inv sets z = x^-1 (x^(m-2), m prime; 0 for x = 0); z may alias x.
@wrap fn (f mut monty) inv(z mut []u64, x []u64) {
	let e = make([]u8, 4*f.n)
	mut b = u64(2)
	for j in 0..f.n {
		let s = f.m[j] - b
		b = (s >> 32) & 1
		let w = s & 0xffffffff
		let k = 4*f.n - 4*j
		e[k-1] = u8(w)
		e[k-2] = u8(w >> 8)
		e[k-3] = u8(w >> 16)
		e[k-4] = u8(w >> 24)
	}
	f.exp(mut z, x, e)
}

// from_bytes sets z to the big-endian value b in Montgomery form and returns 1, or returns 0
// (z unchanged) when b is not 4n bytes or not below m. Only the result is public.
@wrap fn (f mut monty) from_bytes(z mut []u64, b []u8) u64 {
	let n = f.n
	if len(b) != 4*n {
		return 0
	}
	let x = f.elem()
	for j in 0..n {
		let k = 4*n - 4*j
		x[j] = u64(b[k-1]) | u64(b[k-2])<<8 | u64(b[k-3])<<16 | u64(b[k-4])<<24
	}
	// x < m exactly when x - m borrows.
	mut bw = u64(0)
	for j in 0..n {
		let s = x[j] - f.m[j] - bw
		bw = (s >> 32) & 1
	}
	if bw == 0 {
		return 0
	}
	f.mul(mut z, x, f.rr)
	return 1
}

// to_bytes is x (in Montgomery form) as 4n big-endian bytes.
fn (f mut monty) to_bytes(x []u64) []u8 {
	let n = f.n
	let one = f.elem()
	one[0] = 1
	let y = f.elem()
	f.mul(mut y, x, one)
	let out = make([]u8, 4*n)
	for j in 0..n {
		let k = 4*n - 4*j
		out[k-1] = u8(y[j])
		out[k-2] = u8(y[j] >> 8)
		out[k-3] = u8(y[j] >> 16)
		out[k-4] = u8(y[j] >> 24)
	}
	return out
}
