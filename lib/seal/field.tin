package seal

// ---- constant-time arithmetic modulo an odd prime, in Montgomery form ----
// An element is a []u64 of n 32-bit limbs, least significant first, holding x*R mod m with
// R = 2^(32n). Every function here runs in time that depends only on n and on public
// exponents: no branch or index depends on an element's value. P-256 (p256.tin) uses it for
// its field and its scalars; P-384 and other prime fields can reuse it with their constants.

// monty is a prime modulus with its Montgomery constants and scratch space.
type monty struct {
	m    []u64 // the modulus
	rr   []u64 // R^2 mod m
	one  []u64 // R mod m (1 in Montgomery form)
	minv u64   // -m^-1 mod 2^32
	n    i64   // limbs
	t    []u64 // n+2 words of scratch
	u    []u64 // n words of scratch
}

func new_monty(m []u64, rr []u64, one []u64, minv u64) monty {
	n := len(m)
	return monty{m: m, rr: rr, one: one, minv: minv, n: n, t: make([]u64, n+2), u: make([]u64, n)}
}

// elem returns a new zero element of f.
func (f monty) elem() []u64 {
	return make([]u64, f.n)
}

// mul sets z = x*y/R mod m (CIOS Montgomery multiplication); z may alias x or y.
func (f mut monty) mul(z mut []u64, x []u64, y []u64) {
	n := f.n
	t := f.t
	for i := 0; i < n+2; i++ {
		t[i] = 0
	}
	for i := 0; i < n; i++ {
		yi := y[i]
		c := u64(0)
		for j := 0; j < n; j++ {
			s := t[j] + x[j]*yi + c
			t[j] = s & 0xffffffff
			c = s >> 32
		}
		s := t[n] + c
		t[n] = s & 0xffffffff
		t[n+1] = s >> 32
		mm := (t[0] * f.minv) & 0xffffffff
		s = t[0] + mm*f.m[0]
		c = s >> 32
		for j := 1; j < n; j++ {
			s = t[j] + mm*f.m[j] + c
			t[j-1] = s & 0xffffffff
			c = s >> 32
		}
		s = t[n] + c
		t[n-1] = s & 0xffffffff
		t[n] = t[n+1] + (s >> 32)
	}
	f.reduce(mut z, t, t[n])
}

// reduce sets z = t - m if the n+1-word value (t[:n], top) is at least m, else t, in constant
// time; t < 2m.
func (f mut monty) reduce(z mut []u64, t []u64, top u64) {
	n := f.n
	d := f.u
	b := u64(0)
	for j := 0; j < n; j++ {
		s := t[j] - f.m[j] - b
		d[j] = s & 0xffffffff
		b = (s >> 32) & 1
	}
	// Keep t only when the subtraction borrowed past the top word.
	keep := b & (1 ^ top)
	mask := u64(0) - keep
	for j := 0; j < n; j++ {
		z[j] = (t[j] & mask) | (d[j] & ^mask)
	}
}

// add sets z = x + y mod m; z may alias x or y.
func (f mut monty) add(z mut []u64, x []u64, y []u64) {
	n := f.n
	t := f.t
	c := u64(0)
	for j := 0; j < n; j++ {
		s := x[j] + y[j] + c
		t[j] = s & 0xffffffff
		c = s >> 32
	}
	f.reduce(mut z, t, c)
}

// sub sets z = x - y mod m; z may alias x or y.
func (f mut monty) sub(z mut []u64, x []u64, y []u64) {
	n := f.n
	t := f.t
	b := u64(0)
	for j := 0; j < n; j++ {
		s := x[j] - y[j] - b
		t[j] = s & 0xffffffff
		b = (s >> 32) & 1
	}
	// Add m back when it borrowed.
	mask := u64(0) - b
	c := u64(0)
	for j := 0; j < n; j++ {
		s := t[j] + (f.m[j] & mask) + c
		z[j] = s & 0xffffffff
		c = s >> 32
	}
}

// set copies x into z.
func (f monty) set(z mut []u64, x []u64) {
	for j := 0; j < f.n; j++ {
		z[j] = x[j]
	}
}

// sel sets z = a when bit is 1 and z = b when bit is 0, in constant time.
func (f monty) sel(z mut []u64, a []u64, b []u64, bit u64) {
	mask := u64(0) - bit
	for j := 0; j < f.n; j++ {
		z[j] = (a[j] & mask) | (b[j] & ^mask)
	}
}

// is_zero is 1 when x is zero, else 0, in constant time.
func (f monty) is_zero(x []u64) u64 {
	v := u64(0)
	for j := 0; j < f.n; j++ {
		v |= x[j]
	}
	return 1 ^ ((v | (u64(0) - v)) >> 63)
}

// equal is 1 when x == y, else 0, in constant time.
func (f monty) equal(x []u64, y []u64) u64 {
	v := u64(0)
	for j := 0; j < f.n; j++ {
		v |= x[j] ^ y[j]
	}
	return 1 ^ ((v | (u64(0) - v)) >> 63)
}

// exp sets z = x^e (e big-endian and public) in Montgomery form; z may alias x.
func (f mut monty) exp(z mut []u64, x []u64, e []u8) {
	acc := f.elem()
	base := f.elem()
	f.set(mut base, x)
	f.set(mut acc, f.one)
	for i := 0; i < len(e); i++ {
		for bit := 7; bit >= 0; bit-- {
			f.mul(mut acc, acc, acc)
			if (e[i]>>u8(bit))&1 == 1 {
				f.mul(mut acc, acc, base)
			}
		}
	}
	f.set(mut z, acc)
}

// inv sets z = x^-1 (x^(m-2), m prime; 0 for x = 0); z may alias x.
func (f mut monty) inv(z mut []u64, x []u64) {
	e := make([]u8, 4*f.n)
	b := u64(2)
	for j := 0; j < f.n; j++ {
		s := f.m[j] - b
		b = (s >> 32) & 1
		w := s & 0xffffffff
		k := 4*f.n - 4*j
		e[k-1] = u8(w)
		e[k-2] = u8(w >> 8)
		e[k-3] = u8(w >> 16)
		e[k-4] = u8(w >> 24)
	}
	f.exp(mut z, x, e)
}

// from_bytes sets z to the big-endian value b in Montgomery form and returns 1, or returns 0
// (z unchanged) when b is not 4n bytes or not below m. Only the result is public.
func (f mut monty) from_bytes(z mut []u64, b []u8) u64 {
	n := f.n
	if len(b) != 4*n {
		return 0
	}
	x := f.elem()
	for j := 0; j < n; j++ {
		k := 4*n - 4*j
		x[j] = u64(b[k-1]) | u64(b[k-2])<<8 | u64(b[k-3])<<16 | u64(b[k-4])<<24
	}
	// x < m exactly when x - m borrows.
	bw := u64(0)
	for j := 0; j < n; j++ {
		s := x[j] - f.m[j] - bw
		bw = (s >> 32) & 1
	}
	if bw == 0 {
		return 0
	}
	f.mul(mut z, x, f.rr)
	return 1
}

// to_bytes is x (in Montgomery form) as 4n big-endian bytes.
func (f mut monty) to_bytes(x []u64) []u8 {
	n := f.n
	one := f.elem()
	one[0] = 1
	y := f.elem()
	f.mul(mut y, x, one)
	out := make([]u8, 4*n)
	for j := 0; j < n; j++ {
		k := 4*n - 4*j
		out[k-1] = u8(y[j])
		out[k-2] = u8(y[j] >> 8)
		out[k-3] = u8(y[j] >> 16)
		out[k-4] = u8(y[j] >> 24)
	}
	return out
}
