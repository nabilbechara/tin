// The hash functions signatures and key derivation name: one enum shared by RSA, ECDSA, HMAC and HKDF.
package seal

// Hash names a hash function.
type Hash enum {
	SHA1,
	SHA256,
	SHA384,
	SHA512,
}

// HashSize is the length in bytes of h's digest.
func HashSize(h Hash) i64 {
	switch h {
	case SHA1:
		return 20
	case SHA256:
		return 32
	case SHA384:
		return 48
	case SHA512:
		return 64
	}
	return 0
}

// HashName is h's name as standards write it ("SHA-256").
func HashName(h Hash) str {
	switch h {
	case SHA1:
		return "SHA-1"
	case SHA256:
		return "SHA-256"
	case SHA384:
		return "SHA-384"
	case SHA512:
		return "SHA-512"
	}
	return ""
}

// hash_ready reports whether h is implemented in this build of seal.
func hash_ready(h Hash) bool {
	switch h {
	case SHA1, SHA256:
		return true
	default:
		return false
	}
}

// HashSum is the digest of msg under h; msg may be secret. It panics for a hash seal does not have yet.
func HashSum(h Hash, msg secret str) []u8 {
	switch h {
	case SHA1:
		return Sha1(msg)
	case SHA256:
		return Sha256(msg)
	default:
		rt_panic("seal: " + HashName(h) + " is not available yet")
	}
	return []u8{}
}
