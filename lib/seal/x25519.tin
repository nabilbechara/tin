package seal

// ---- X25519 (RFC 7748) ----
// Field elements mod p = 2^255 - 19 are ten signed limbs in radix 2^25.5 (26, 25, 26, ... bits),
// so every product fits in 64 bits. The ladder swaps with masks, never branches on the
// scalar, and every field operation runs the same instructions whatever the values: X25519
// is constant-time in the scalar and the point.

// fe_t is the multiplication scratch (per core; nothing here waits).
var fe_t = make([]i64, 20)

func fe_new() []i64 {
	return make([]i64, 10)
}

// fe_width is the bit width of limb i: 26 for even i, 25 for odd.
func fe_width(i i64) i64 {
	return 26 - (i & 1)
}

// fe_carry brings limbs t[0..9] back to about +-2^25 (+-2^24 for odd limbs) and stores h.
func fe_carry(h mut []i64, t mut []i64) {
	for i := 0; i < 9; i++ {
		w := 26 - (i & 1)
		c := (t[i] + (1 << (w - 1))) >> w
		t[i] -= c << w
		t[i+1] += c
	}
	c := (t[9] + (1 << 24)) >> 25
	t[9] -= c << 25
	t[0] += 19 * c
	c = (t[0] + (1 << 25)) >> 26
	t[0] -= c << 26
	t[1] += c
	for i := 0; i < 10; i++ {
		h[i] = t[i]
	}
}

// fe_mul sets h = f*g; h may alias f or g. Inputs may have limbs up to 2^27 in magnitude.
func fe_mul(h mut []i64, f []i64, g []i64) {
	t := fe_t
	for k := 0; k < 10; k++ {
		t[k] = 0
	}
	for i := 0; i < 10; i++ {
		fi := f[i]
		fi2 := fi * (1 + (i & 1))
		for j := 0; j < 10; j++ {
			// Two odd limbs carry an extra factor 2 (their offsets add to one bit above a limb).
			p := fi * g[j]
			if j&1 == 1 {
				p = fi2 * g[j]
			}
			k := i + j
			if k >= 10 {
				t[k-10] += 19 * p
			} else {
				t[k] += p
			}
		}
	}
	fe_carry(mut h, mut t)
}

// fe_sq sets h = f*f.
func fe_sq(h mut []i64, f []i64) {
	fe_mul(mut h, f, f)
}

// fe_mul121665 sets h = 121665*f.
func fe_mul121665(h mut []i64, f []i64) {
	t := fe_t
	for i := 0; i < 10; i++ {
		t[i] = f[i] * 121665
	}
	fe_carry(mut h, mut t)
}

func fe_add(h mut []i64, f []i64, g []i64) {
	for i := 0; i < 10; i++ {
		h[i] = f[i] + g[i]
	}
}

func fe_sub(h mut []i64, f []i64, g []i64) {
	for i := 0; i < 10; i++ {
		h[i] = f[i] - g[i]
	}
}

func fe_copy(h mut []i64, f []i64) {
	for i := 0; i < 10; i++ {
		h[i] = f[i]
	}
}

// fe_cswap swaps f and g when b is 1, in constant time.
func fe_cswap(f mut []i64, g mut []i64, b i64) {
	mask := 0 - b
	for i := 0; i < 10; i++ {
		x := (f[i] ^ g[i]) & mask
		f[i] ^= x
		g[i] ^= x
	}
}

// fe_frombytes reads 32 little-endian bytes, ignoring the top bit.
func fe_frombytes(h mut []i64, s []u8) {
	off := 0
	for i := 0; i < 10; i++ {
		w := fe_width(i)
		v := u64(0)
		for j := 0; j < 5; j++ {
			b := off/8 + j
			if b < 32 {
				v |= u64(s[b]) << u64(8*j)
			}
		}
		h[i] = i64((v >> u64(off%8)) & ((u64(1) << u64(w)) - 1))
		off += w
	}
	h[9] &= (1 << 25) - 1
}

// fe_tobytes is h reduced mod p, as 32 little-endian bytes.
func fe_tobytes(f []i64) []u8 {
	h := fe_new()
	t := fe_t
	for i := 0; i < 10; i++ {
		t[i] = f[i]
	}
	fe_carry(mut h, mut t)
	// q is 1 when h >= p, else 0.
	q := (19*h[9] + (1 << 24)) >> 25
	for i := 0; i < 10; i++ {
		q = (h[i] + q) >> fe_width(i)
	}
	h[0] += 19 * q
	for i := 0; i < 9; i++ {
		w := fe_width(i)
		c := h[i] >> w
		h[i+1] += c
		h[i] -= c << w
	}
	h[9] &= (1 << 25) - 1
	out := make([]u8, 32)
	off := 0
	for i := 0; i < 10; i++ {
		v := u64(h[i])
		for k := 0; k < fe_width(i); k++ {
			bit := off + k
			out[bit/8] |= u8(((v >> u64(k)) & 1) << u64(bit%8))
		}
		off += fe_width(i)
	}
	return out
}

// fe_invert sets out = z^(p-2) with the usual chain of 254 squarings and 11 multiplications.
func fe_invert(out mut []i64, z []i64) {
	t0 := fe_new()
	t1 := fe_new()
	t2 := fe_new()
	t3 := fe_new()
	fe_sq(mut t0, z)
	fe_sq(mut t1, t0)
	fe_sq(mut t1, t1)
	fe_mul(mut t1, z, t1)
	fe_mul(mut t0, t0, t1)
	fe_sq(mut t2, t0)
	fe_mul(mut t1, t1, t2)
	fe_sq(mut t2, t1)
	for i := 1; i < 5; i++ {
		fe_sq(mut t2, t2)
	}
	fe_mul(mut t1, t2, t1)
	fe_sq(mut t2, t1)
	for i := 1; i < 10; i++ {
		fe_sq(mut t2, t2)
	}
	fe_mul(mut t2, t2, t1)
	fe_sq(mut t3, t2)
	for i := 1; i < 20; i++ {
		fe_sq(mut t3, t3)
	}
	fe_mul(mut t2, t3, t2)
	fe_sq(mut t2, t2)
	for i := 1; i < 10; i++ {
		fe_sq(mut t2, t2)
	}
	fe_mul(mut t1, t2, t1)
	fe_sq(mut t2, t1)
	for i := 1; i < 50; i++ {
		fe_sq(mut t2, t2)
	}
	fe_mul(mut t2, t2, t1)
	fe_sq(mut t3, t2)
	for i := 1; i < 100; i++ {
		fe_sq(mut t3, t3)
	}
	fe_mul(mut t2, t3, t2)
	fe_sq(mut t2, t2)
	for i := 1; i < 50; i++ {
		fe_sq(mut t2, t2)
	}
	fe_mul(mut t1, t2, t1)
	fe_sq(mut t1, t1)
	for i := 1; i < 5; i++ {
		fe_sq(mut t1, t1)
	}
	fe_mul(mut out, t1, t0)
}

// x25519 is the X25519 function of a 32-byte scalar and u-coordinate (no zero check).
func x25519(scalar []u8, point []u8) []u8 {
	e := make([]u8, 32)
	for i := 0; i < 32; i++ {
		e[i] = scalar[i]
	}
	e[0] &= 248
	e[31] &= 127
	e[31] |= 64
	x1 := fe_new()
	fe_frombytes(mut x1, point)
	x2 := fe_new()
	x2[0] = 1
	z2 := fe_new()
	x3 := fe_new()
	fe_copy(mut x3, x1)
	z3 := fe_new()
	z3[0] = 1
	a := fe_new()
	aa := fe_new()
	b := fe_new()
	bb := fe_new()
	ee := fe_new()
	c := fe_new()
	d := fe_new()
	da := fe_new()
	cb := fe_new()
	swap := 0
	for pos := 254; pos >= 0; pos-- {
		bit := i64((e[pos/8] >> u8(pos&7)) & 1)
		swap ^= bit
		fe_cswap(mut x2, mut x3, swap)
		fe_cswap(mut z2, mut z3, swap)
		swap = bit
		fe_add(mut a, x2, z2)
		fe_sq(mut aa, a)
		fe_sub(mut b, x2, z2)
		fe_sq(mut bb, b)
		fe_sub(mut ee, aa, bb)
		fe_add(mut c, x3, z3)
		fe_sub(mut d, x3, z3)
		fe_mul(mut da, d, a)
		fe_mul(mut cb, c, b)
		fe_add(mut x3, da, cb)
		fe_sq(mut x3, x3)
		fe_sub(mut z3, da, cb)
		fe_sq(mut z3, z3)
		fe_mul(mut z3, z3, x1)
		fe_mul(mut x2, aa, bb)
		fe_mul121665(mut z2, ee)
		fe_add(mut z2, z2, aa)
		fe_mul(mut z2, z2, ee)
	}
	fe_cswap(mut x2, mut x3, swap)
	fe_cswap(mut z2, mut z3, swap)
	fe_invert(mut z2, z2)
	fe_mul(mut x2, x2, z2)
	return fe_tobytes(x2)
}

// X25519 is the RFC 7748 function: the shared secret of a 32-byte private scalar and a
// peer's 32-byte public key. It fails for wrong lengths and when the result is all zeros
// (a low-order peer key), as TLS 1.3 requires. Constant-time in the scalar and the point.
func X25519(scalar secret []u8, point []u8) ![]u8 {
	if len(scalar) != 32 || len(point) != 32 {
		fail "seal: X25519 needs a 32-byte scalar and point"
	}
	out := x25519(scalar, point)
	v := u8(0)
	for i := 0; i < 32; i++ {
		v |= out[i]
	}
	if v == 0 {
		fail "seal: X25519 shared secret is zero (low-order public key)"
	}
	return out
}

// X25519NewPrivateKey returns 32 random bytes to use as an X25519 private key.
func X25519NewPrivateKey() []u8 {
	return RandomBytes(32)
}

// X25519PublicKey is the public key (32 bytes) of a 32-byte X25519 private key.
func X25519PublicKey(priv secret []u8) ![]u8 {
	if len(priv) != 32 {
		fail "seal: X25519 needs a 32-byte private key"
	}
	base := make([]u8, 32)
	base[0] = 9
	return x25519(priv, base)
}
