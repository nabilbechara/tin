package seal

// ---- X25519 (RFC 7748) ----
// Field elements mod p = 2^255 - 19 are ten signed limbs in radix 2^25.5 (26, 25, 26, ... bits),
// so every product fits in 64 bits; fe_mul and fe_sq are generated (fe25519.tin). The ladder swaps with masks, never branches on the
// scalar, and every field operation runs the same instructions whatever the values: X25519
// is constant-time in the scalar and the point. The field and ladder functions are @wrap (#362):
// their limb bounds keep values in i64, and a checked operation would branch on secret data.

// fe_t is the multiplication scratch (per core; nothing here waits).
let fe_t = make([]i64, 20)

fn fe_new() []i64 {
	return make([]i64, 10)
}

// fe_width is the bit width of limb i: 26 for even i, 25 for odd.
fn fe_width(i i64) i64 {
	return 26 - (i & 1)
}

// fe_carry brings limbs t[0..9] back to about +-2^25 (+-2^24 for odd limbs) and stores h.
@wrap fn fe_carry(h mut []i64, t mut []i64) {
	for i in 0..9 {
		let w = 26 - (i & 1)
		let c = (t[i] + (1 << (w - 1))) >> w
		t[i] -= c << w
		t[i+1] += c
	}
	mut c = (t[9] + (1 << 24)) >> 25
	t[9] -= c << 25
	t[0] += 19 * c
	c = (t[0] + (1 << 25)) >> 26
	t[0] -= c << 26
	t[1] += c
	for i in 0..10 {
		h[i] = t[i]
	}
}

// fe_mul121665 sets h = 121665*f.
@wrap fn fe_mul121665(h mut []i64, f []i64) {
	let t = fe_t
	for i in 0..10 {
		t[i] = f[i] * 121665
	}
	fe_carry(mut h, mut t)
}

@wrap fn fe_add(h mut []i64, f []i64, g []i64) {
	for i in 0..10 {
		h[i] = f[i] + g[i]
	}
}

@wrap fn fe_sub(h mut []i64, f []i64, g []i64) {
	for i in 0..10 {
		h[i] = f[i] - g[i]
	}
}

fn fe_copy(h mut []i64, f []i64) {
	for i in 0..10 {
		h[i] = f[i]
	}
}

// fe_cswap swaps f and g when b is 1, in constant time.
@wrap fn fe_cswap(f mut []i64, g mut []i64, b i64) {
	let mask = 0 - b
	for i in 0..10 {
		let x = (f[i] ^ g[i]) & mask
		f[i] ^= x
		g[i] ^= x
	}
}

// fe_frombytes reads 32 little-endian bytes, ignoring the top bit.
@wrap fn fe_frombytes(h mut []i64, s []u8) {
	mut off = 0
	for i in 0..10 {
		let w = fe_width(i)
		mut v = u64(0)
		for j in 0..5 {
			let b = off/8 + j
			if b < 32 {
				v |= u64(s[b]) << u64(8*j)
			}
		}
		h[i] = i64((v >> u64(off%8)) & ((u64(1) << u64(w)) - 1))
		off += w
	}
	h[9] &= (1 << 25) - 1
}

// fe_tobytes is h reduced mod p, as 32 little-endian bytes.
@wrap fn fe_tobytes(f []i64) []u8 {
	let h = fe_new()
	let t = fe_t
	for i in 0..10 {
		t[i] = f[i]
	}
	fe_carry(mut h, mut t)
	// q is 1 when h >= p, else 0.
	mut q = (19*h[9] + (1 << 24)) >> 25
	for i in 0..10 {
		q = (h[i] + q) >> fe_width(i)
	}
	h[0] += 19 * q
	for i in 0..9 {
		let w = fe_width(i)
		let c = h[i] >> w
		h[i+1] += c
		h[i] -= c << w
	}
	h[9] &= (1 << 25) - 1
	let out = make([]u8, 32)
	mut off = 0
	for i in 0..10 {
		let v = u64(h[i])
		{
			mut k = 0
			for k < fe_width(i) {
				let bit = off + k
				out[bit/8] |= u8(((v >> u64(k)) & 1) << u64(bit%8))
				k += 1
			}
		}
		off += fe_width(i)
	}
	return out
}

// fe_invert sets out = z^(p-2) with the usual chain of 254 squarings and 11 multiplications.
@wrap fn fe_invert(out mut []i64, z []i64) {
	let t0 = fe_new()
	let t1 = fe_new()
	let t2 = fe_new()
	let t3 = fe_new()
	fe_sq(mut t0, z)
	fe_sq(mut t1, t0)
	fe_sq(mut t1, t1)
	fe_mul(mut t1, z, t1)
	fe_mul(mut t0, t0, t1)
	fe_sq(mut t2, t0)
	fe_mul(mut t1, t1, t2)
	fe_sq(mut t2, t1)
	for i in 1..5 {
		fe_sq(mut t2, t2)
	}
	fe_mul(mut t1, t2, t1)
	fe_sq(mut t2, t1)
	for i in 1..10 {
		fe_sq(mut t2, t2)
	}
	fe_mul(mut t2, t2, t1)
	fe_sq(mut t3, t2)
	for i in 1..20 {
		fe_sq(mut t3, t3)
	}
	fe_mul(mut t2, t3, t2)
	fe_sq(mut t2, t2)
	for i in 1..10 {
		fe_sq(mut t2, t2)
	}
	fe_mul(mut t1, t2, t1)
	fe_sq(mut t2, t1)
	for i in 1..50 {
		fe_sq(mut t2, t2)
	}
	fe_mul(mut t2, t2, t1)
	fe_sq(mut t3, t2)
	for i in 1..100 {
		fe_sq(mut t3, t3)
	}
	fe_mul(mut t2, t3, t2)
	fe_sq(mut t2, t2)
	for i in 1..50 {
		fe_sq(mut t2, t2)
	}
	fe_mul(mut t1, t2, t1)
	fe_sq(mut t1, t1)
	for i in 1..5 {
		fe_sq(mut t1, t1)
	}
	fe_mul(mut out, t1, t0)
}

// x25519 is the X25519 function of a 32-byte scalar and u-coordinate (no zero check).
@wrap fn x25519(scalar []u8, point []u8) []u8 {
	let e = make([]u8, 32)
	for i in 0..32 {
		e[i] = scalar[i]
	}
	e[0] &= 248
	e[31] &= 127
	e[31] |= 64
	let x1 = fe_new()
	fe_frombytes(mut x1, point)
	let x2 = fe_new()
	x2[0] = 1
	let z2 = fe_new()
	let x3 = fe_new()
	fe_copy(mut x3, x1)
	let z3 = fe_new()
	z3[0] = 1
	let a = fe_new()
	let aa = fe_new()
	let b = fe_new()
	let bb = fe_new()
	let ee = fe_new()
	let c = fe_new()
	let d = fe_new()
	let da = fe_new()
	let cb = fe_new()
	mut swap = 0
	{
		mut pos = 254
		for pos >= 0 {
			let bit = i64((e[pos/8] >> u8(pos&7)) & 1)
			swap ^= bit
			fe_cswap(mut x2, mut x3, swap)
			fe_cswap(mut z2, mut z3, swap)
			swap = bit
			fe_add(mut a, x2, z2)
			fe_sq(mut aa, a)
			fe_sub(mut b, x2, z2)
			fe_sq(mut bb, b)
			fe_sub(mut ee, aa, bb)
			fe_add(mut c, x3, z3)
			fe_sub(mut d, x3, z3)
			fe_mul(mut da, d, a)
			fe_mul(mut cb, c, b)
			fe_add(mut x3, da, cb)
			fe_sq(mut x3, x3)
			fe_sub(mut z3, da, cb)
			fe_sq(mut z3, z3)
			fe_mul(mut z3, z3, x1)
			fe_mul(mut x2, aa, bb)
			fe_mul121665(mut z2, ee)
			fe_add(mut z2, z2, aa)
			fe_mul(mut z2, z2, ee)
			pos -= 1
		}
	}
	fe_cswap(mut x2, mut x3, swap)
	fe_cswap(mut z2, mut z3, swap)
	fe_invert(mut z2, z2)
	fe_mul(mut x2, x2, z2)
	return fe_tobytes(x2)
}

// X25519 is the RFC 7748 function: the shared secret of a 32-byte private scalar and a
// peer's 32-byte public key. It fails for wrong lengths and when the result is all zeros
// (a low-order peer key), as TLS 1.3 requires. Constant-time in the scalar and the point.
fn X25519(scalar secret []u8, point []u8) ![]u8 {
	if len(scalar) != 32 || len(point) != 32 {
		fail "seal: X25519 needs a 32-byte scalar and point"
	}
	let out = x25519(scalar, point)
	mut v = u8(0)
	for i in 0..32 {
		v |= out[i]
	}
	if v == 0 {
		fail "seal: X25519 shared secret is zero (low-order public key)"
	}
	return out
}

// X25519NewPrivateKey returns 32 random bytes to use as an X25519 private key.
fn X25519NewPrivateKey() []u8 {
	return RandomBytes(32)
}

// X25519PublicKey is the public key (32 bytes) of a 32-byte X25519 private key.
fn X25519PublicKey(priv secret []u8) ![]u8 {
	if len(priv) != 32 {
		fail "seal: X25519 needs a 32-byte private key"
	}
	let base = make([]u8, 32)
	base[0] = 9
	return x25519(priv, base)
}
