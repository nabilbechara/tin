// Montgomery arithmetic modulo an odd number, for RSA: little-endian 32-bit limbs held in u64s.
// Constant time: mont_mul, mont_new and mont_exp take time that depends only on the limb
// count, the modulus's bit length and the exponent's length, never on the values (no secret branches or
// secret-indexed loads). nat_cmp and mont_exp_pub are variable time and only see public values.
package seal

// montCtx holds a modulus and its Montgomery constants; R = 2^(32n).
type montCtx struct {
	m []u64
	n i64
	inv u64
	rr []u64
	one []u64
}

// nat_from_bytes reads big-endian b into n limbs; b must fit.
func nat_from_bytes(b []u8, n i64) []u64 {
	out := make([]u64, n)
	for i := 0; i < len(b); i++ {
		k := len(b) - 1 - i
		if k/4 < n {
			out[k/4] |= u64(b[i]) << u64(8*(k%4))
		}
	}
	return out
}

// nat_bytes writes x as size big-endian bytes.
func nat_bytes(x []u64, size i64) []u8 {
	out := make([]u8, size)
	for k := 0; k < size; k++ {
		if k/4 < len(x) {
			out[size-1-k] = u8(x[k/4] >> u64(8*(k%4)))
		}
	}
	return out
}

// nat_cmp compares equal-length a and b (-1, 0, 1); variable time, for public values.
func nat_cmp(a []u64, b []u64) i64 {
	for k := len(a) - 1; k >= 0; k-- {
		if a[k] != b[k] {
			if a[k] < b[k] {
				return -1
			}
			return 1
		}
	}
	return 0
}

// mont_new prepares arithmetic modulo the odd big-endian number mod (at least 2 limbs).
func mont_new(mod []u8) !montCtx {
	at := 0
	for at < len(mod) && mod[at] == 0 {
		at++
	}
	b := mod[at:]
	if len(b) < 8 || b[len(b)-1]&1 == 0 {
		fail "seal: modulus must be odd and at least 64 bits"
	}
	n := (len(b) + 3) / 4
	m := nat_from_bytes(b, n)
	// Newton's iteration doubles the correct low bits of m[0]^-1 mod 2^32 each step.
	x := m[0]
	for i := 0; i < 5; i++ {
		x = (x * (2 - m[0]*x)) & 0xffffffff
	}
	c := montCtx{m: m, n: n, inv: (0 - x) & 0xffffffff, rr: make([]u64, n), one: make([]u64, n)}
	// R mod m: start from 2^(bits-1) < m and double to 2^(32n), reducing after each step.
	bits := 32 * n
	for (m[n-1] >> u64(31-(32*n-bits))) & 1 == 0 {
		bits--
	}
	acc := make([]u64, n)
	acc[(bits-1)/32] = u64(1) << u64((bits-1)%32)
	tmp := make([]u64, n)
	for i := bits - 1; i < 32*n; i++ {
		mont_double(c, mut acc, mut tmp)
	}
	copy(c.one, acc)
	// R^2 mod m is 2^(32n) in Montgomery form: square and multiply from 2R mod m.
	mont_double(c, mut acc, mut tmp)
	t := make([]u64, n+2)
	r := make([]u64, n)
	copy(r, c.one)
	e := 32 * n
	top := 0
	for (e >> u64(top+1)) != 0 {
		top++
	}
	for i := top; i >= 0; i-- {
		mont_mul(c, r, r, mut r, mut t)
		if (e>>u64(i))&1 == 1 {
			mont_mul(c, r, acc, mut r, mut t)
		}
	}
	copy(c.rr, r)
	return c
}

// mont_double sets acc = 2*acc mod m for acc < m, in constant time.
func mont_double(c montCtx, acc mut []u64, tmp mut []u64) {
	n := c.n
	carry := u64(0)
	for j := 0; j < n; j++ {
		v := acc[j]<<1 | carry
		acc[j] = v & 0xffffffff
		carry = v >> 32
	}
	borrow := u64(0)
	for j := 0; j < n; j++ {
		d := acc[j] - c.m[j] - borrow
		tmp[j] = d & 0xffffffff
		borrow = d >> 63
	}
	// Keep acc only when 2*acc < m: no carry out and the subtraction borrowed.
	mask := 0 - (borrow & (carry ^ 1))
	for j := 0; j < n; j++ {
		acc[j] = (acc[j] & mask) | (tmp[j] & ^mask)
	}
}

// mont_mul sets out = a*b/R mod m for a, b < m; out may alias a or b. t has n+2 limbs.
// Each row multiplies and reduces in one pass (FIOS) over the slices' raw words.
func mont_mul(c montCtx, a []u64, b []u64, out mut []u64, t mut []u64) {
	n := c.n
	inv := c.inv
	ap := cast(i64, a)[2]
	bp := cast(i64, b)[2]
	mp := cast(i64, c.m)[2]
	tp := cast(i64, t)[2]
	op := cast(i64, out)[2]
	for k := 0; k < n+2; k++ {
		tp[k] = 0
	}
	m0 := u64(mp[0])
	for i := 0; i < n; i++ {
		bi := u64(bp[i])
		s := u64(tp[0]) + u64(ap[0])*bi
		c1 := s >> 32
		q := ((s & 0xffffffff) * inv) & 0xffffffff
		u := (s & 0xffffffff) + q*m0
		c2 := u >> 32
		for j := 1; j < n; j++ {
			s = u64(tp[j]) + u64(ap[j])*bi + c1
			c1 = s >> 32
			u = (s & 0xffffffff) + q*u64(mp[j]) + c2
			c2 = u >> 32
			tp[j-1] = i64(u & 0xffffffff)
		}
		s = u64(tp[n]) + c1 + c2
		tp[n-1] = i64(s & 0xffffffff)
		tp[n] = i64(u64(tp[n+1]) + (s >> 32))
		tp[n+1] = 0
	}
	// t < 2m: subtract m unless t < m, choosing by mask.
	borrow := u64(0)
	for j := 0; j < n; j++ {
		d := u64(tp[j]) - u64(mp[j]) - borrow
		op[j] = i64(d & 0xffffffff)
		borrow = d >> 63
	}
	mask := 0 - (borrow & (u64(tp[n]) ^ 1))
	for j := 0; j < n; j++ {
		op[j] = i64((u64(tp[j]) & mask) | (u64(op[j]) & ^mask))
	}
}

// mont_exp_pub is x^e mod m for x < m, square and multiply; variable time, for public e and x.
func mont_exp_pub(c montCtx, x []u64, e []u8) []u64 {
	n := c.n
	t := make([]u64, n+2)
	xm := make([]u64, n)
	mont_mul(c, x, c.rr, mut xm, mut t)
	r := make([]u64, n)
	copy(r, c.one)
	started := false
	for i := 0; i < len(e)*8; i++ {
		bit := (e[i/8] >> u8(7-i%8)) & 1
		if started {
			mont_mul(c, r, r, mut r, mut t)
		}
		if bit == 1 {
			mont_mul(c, r, xm, mut r, mut t)
			started = true
		}
	}
	one := make([]u64, n)
	one[0] = 1
	mont_mul(c, r, one, mut r, mut t)
	return r
}

// mont_exp is x^e mod m for x < m with 4-bit fixed windows: every window does four squarings,
// reads all 16 table entries and multiplies once, so the time depends only on len(e).
func mont_exp(c montCtx, x []u64, e []u8) []u64 {
	n := c.n
	t := make([]u64, n+2)
	table := make([]u64, 16*n)
	for j := 0; j < n; j++ {
		table[j] = c.one[j]
	}
	xm := make([]u64, n)
	mont_mul(c, x, c.rr, mut xm, mut t)
	prev := make([]u64, n)
	copy(prev, c.one)
	for k := 1; k < 16; k++ {
		mont_mul(c, prev, xm, mut prev, mut t)
		for j := 0; j < n; j++ {
			table[k*n+j] = prev[j]
		}
	}
	r := make([]u64, n)
	copy(r, c.one)
	sel := make([]u64, n)
	for i := 0; i < len(e)*2; i++ {
		for s := 0; s < 4; s++ {
			mont_mul(c, r, r, mut r, mut t)
		}
		w := u64(e[i/2]>>u8(4-4*(i%2))) & 15
		for j := 0; j < n; j++ {
			sel[j] = 0
		}
		for k := 0; k < 16; k++ {
			// mask is all ones exactly when k == w, computed without a branch.
			d := u64(k) ^ w
			mask := ((d | (0 - d)) >> 63) - 1
			for j := 0; j < n; j++ {
				sel[j] |= table[k*n+j] & mask
			}
		}
		mont_mul(c, r, sel, mut r, mut t)
	}
	one := make([]u64, n)
	one[0] = 1
	mont_mul(c, r, one, mut r, mut t)
	return r
}

// mont_add sets out = a+b mod m for a, b < m, in constant time; out may alias a or b.
func mont_add(c montCtx, a []u64, b []u64, out mut []u64, tmp mut []u64) {
	n := c.n
	carry := u64(0)
	for j := 0; j < n; j++ {
		s := a[j] + b[j] + carry
		out[j] = s & 0xffffffff
		carry = s >> 32
	}
	borrow := u64(0)
	for j := 0; j < n; j++ {
		d := out[j] - c.m[j] - borrow
		tmp[j] = d & 0xffffffff
		borrow = d >> 63
	}
	mask := 0 - (borrow & (carry ^ 1))
	for j := 0; j < n; j++ {
		out[j] = (out[j] & mask) | (tmp[j] & ^mask)
	}
}

// mont_sub sets out = a-b mod m for a, b < m, in constant time; out may alias a or b.
func mont_sub(c montCtx, a []u64, b []u64, out mut []u64) {
	n := c.n
	borrow := u64(0)
	for j := 0; j < n; j++ {
		d := a[j] - b[j] - borrow
		out[j] = d & 0xffffffff
		borrow = d >> 63
	}
	mask := 0 - borrow
	carry := u64(0)
	for j := 0; j < n; j++ {
		s := out[j] + (c.m[j] & mask) + carry
		out[j] = s & 0xffffffff
		carry = s >> 32
	}
}
