// Package herald writes leveled log lines, one write(2) per line so cores never interleave:
//
//	2026-10-01T11:22:05.123Z INFO core=2 listening addr=:8080
package herald

import "say"
import "tide"

const LDebug = 0
const LInfo = 1
const LWarn = 2
const LError = 3

mut level i64 = LInfo
mut out i64 = 2
mut clock fn() i64 = wall_ms

fn wall_ms() i64 {
	return tide.Wall() / 1000000
}

// SetLevel drops lines below l (LDebug, LInfo, LWarn, LError) on this core.
fn SetLevel(l i64) {
	level = l
}

// SetOutput sends this core's lines to file descriptor fd.
fn SetOutput(fd i64) {
	out = fd
}

// SetClock replaces the clock (unix milliseconds), for tests.
fn SetClock(f fn() i64) {
	clock = f
}

fn name_of(l i64) str {
	if l == LDebug {
		return "DEBUG"
	}
	if l == LInfo {
		return "INFO"
	}
	if l == LWarn {
		return "WARN"
	}
	return "ERROR"
}

fn needs_quote(v str) bool {
	if len(v) == 0 {
		return true
	}
	for i in 0..len(v) {
		let c = v[i]
		if c <= ' ' || c == '"' || c == '=' || c >= 0x7f {
			return true
		}
	}
	return false
}

fn pad(b mut []u8, v i64, width i64) {
	let s = say.Str(v)
	for i in len(s)..width {
		b = append(b, '0')
	}
	b = append(b, s...)
}

// Line formats a log line (without writing it): timestamp, level, core, message, pairs.
fn Line(l i64, msg str, kv []str) str {
	let ms = clock()
	let c = tide.UTC(ms * 1000000)
	mut b = make([]u8, 0, 96+len(msg))
	pad(mut b, c.Year, 4)
	b = append(b, '-')
	pad(mut b, c.Month, 2)
	b = append(b, '-')
	pad(mut b, c.Day, 2)
	b = append(b, 'T')
	pad(mut b, c.Hour, 2)
	b = append(b, ':')
	pad(mut b, c.Min, 2)
	b = append(b, ':')
	pad(mut b, c.Sec, 2)
	b = append(b, '.')
	pad(mut b, ms%1000, 3)
	b = append(b, "Z "...)
	b = append(b, name_of(l)...)
	b = append(b, " core="...)
	b = append(b, say.Str(rt_core_id())...)
	b = append(b, ' ')
	b = append(b, msg...)
	{
		mut i = 0
		for i+1 < len(kv) {
			b = append(b, ' ')
			b = append(b, kv[i]...)
			b = append(b, '=')
			let v = kv[i+1]
			if needs_quote(v) {
				b = append(b, say.Fmt("%q", v)...)
			} else {
				b = append(b, v...)
			}
			i += 2
		}
	}
	b = append(b, '\n')
	return str(b)
}

// Log writes msg at level l with key/value pairs kv (k1, v1, k2, v2, ...).
fn Log(l i64, msg str, kv []str) {
	if l < level {
		return
	}
	let s = Line(l, msg, kv)
	rt_sys_write(out, cast(i64, s)+8, len(s))
}

// Debug logs msg at debug level.
fn Debug(msg str) {
	Log(LDebug, msg, []str{})
}

// Info logs msg at info level.
fn Info(msg str) {
	Log(LInfo, msg, []str{})
}

// Warn logs msg at warning level.
fn Warn(msg str) {
	Log(LWarn, msg, []str{})
}

// Error logs msg at error level.
fn Error(msg str) {
	Log(LError, msg, []str{})
}

// Info2 logs msg with one key/value pair.
fn Info2(msg str, k str, v str) {
	Log(LInfo, msg, []str{k, v})
}

// Info4 logs msg with two key/value pairs.
fn Info4(msg str, k1 str, v1 str, k2 str, v2 str) {
	Log(LInfo, msg, []str{k1, v1, k2, v2})
}

// Error2 logs msg with one key/value pair at error level.
fn Error2(msg str, k str, v str) {
	Log(LError, msg, []str{k, v})
}
