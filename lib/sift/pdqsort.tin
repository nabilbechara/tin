package sift

import "constraints"

// Sorting any slice, by the pattern-defeating quicksort of Go's slices package (zsortordered.go and
// zsortanyfunc.go), so that Sort and SortFunc produce the same order as Go's for the same input,
// equal elements included. The two variants below are the same code: one compares with `<` (NaNs
// first, as cmp.Less), the other calls cmp. Change them together.

// swapCount counts the swaps order2 makes while a pivot is chosen.
type swapCount struct {
	n i64
}

// less is cmp.Less: x < y, with NaN smaller than everything else.
fn less[E Ordered](x E, y E) bool {
	return x < y || (x != x && y == y)
}

// ---- ordered element types ----

fn insertionSortOrdered[E Ordered](data mut []E, a i64, b i64) {
	for i in a + 1..b {
		{
			mut j = i
			for j > a && less(data[j], data[j-1]) {
				data[j], data[j-1] = data[j-1], data[j]
				j -= 1
			}
		}
	}
}

fn siftDownOrdered[E Ordered](data mut []E, lo i64, hi i64, first i64) {
	mut root = lo
	for {
		mut child = 2*root + 1
		if child >= hi {
			break
		}
		if child+1 < hi && less(data[first+child], data[first+child+1]) {
			child += 1
		}
		if !less(data[first+root], data[first+child]) {
			return
		}
		data[first+root], data[first+child] = data[first+child], data[first+root]
		root = child
	}
}

fn heapSortOrdered[E Ordered](data mut []E, a i64, b i64) {
	let first = a
	let lo = 0
	let hi = b - a
	{
		mut i = (hi - 1) / 2
		for i >= 0 {
			siftDownOrdered(mut data, i, hi, first)
			i -= 1
		}
	}
	{
		mut i = hi - 1
		for i >= 0 {
			data[first], data[first+i] = data[first+i], data[first]
			siftDownOrdered(mut data, lo, i, first)
			i -= 1
		}
	}
}

const pdqsortOrderedMaxInsertion = 12

fn pdqsortOrdered[E Ordered](data mut []E, a i64, b i64, limit_ i64) {
	mut wasBalanced = true // whether the last partitioning was reasonably balanced
	mut wasPartitioned = true // whether the slice was already partitioned
	for {
		let length = b - a
		if length <= pdqsortOrderedMaxInsertion {
			insertionSortOrdered(mut data, a, b)
			return
		}
		// Fall back to heapsort if too many bad choices were made.
		if limit_ == 0 {
			heapSortOrdered(mut data, a, b)
			return
		}
		// If the last partitioning was imbalanced, we need to breakPatterns.
		if !wasBalanced {
			breakPatternsOrdered(mut data, a, b)
			limit_ -= 1
		}
		mut (pivot, hint) = choosePivotOrdered(data, a, b)
		if hint == hintDecreasing {
			reverseRangeOrdered(mut data, a, b)
			// The chosen pivot was pivot-a elements after the start of the array.
			// After reversing it is pivot-a elements before the end of the array.
			pivot = (b - 1) - (pivot - a)
			hint = hintIncreasing
		}
		// The slice is likely already sorted.
		if wasBalanced && wasPartitioned && hint == hintIncreasing {
			if partialInsertionSortOrdered(mut data, a, b) {
				return
			}
		}
		// Probably the slice contains many duplicate elements, partition the slice into
		// elements equal to and elements greater than the pivot.
		if a > 0 && !less(data[a-1], data[pivot]) {
			let mid = partitionEqualOrdered(mut data, a, b, pivot)
			a = mid
			continue
		}
		let (mid, alreadyPartitioned) = partitionOrdered(mut data, a, b, pivot)
		wasPartitioned = alreadyPartitioned
		let leftLen = mid - a
		let rightLen = b - mid
		let balanceThreshold = length / 8
		if leftLen < rightLen {
			wasBalanced = leftLen >= balanceThreshold
			pdqsortOrdered(mut data, a, mid, limit_)
			a = mid + 1
		} else {
			wasBalanced = rightLen >= balanceThreshold
			pdqsortOrdered(mut data, mid+1, b, limit_)
			b = mid
		}
	}
}

fn partitionOrdered[E Ordered](data mut []E, a i64, b i64, pivot i64) (i64, bool) {
	data[a], data[pivot] = data[pivot], data[a]
	mut i = a + 1
	mut j = b - 1 // i and j are inclusive of the elements remaining to be partitioned
	for i <= j && less(data[i], data[a]) {
		i += 1
	}
	for i <= j && !less(data[j], data[a]) {
		j -= 1
	}
	if i > j {
		data[j], data[a] = data[a], data[j]
		return j, true
	}
	data[i], data[j] = data[j], data[i]
	i += 1
	j -= 1
	for {
		for i <= j && less(data[i], data[a]) {
			i += 1
		}
		for i <= j && !less(data[j], data[a]) {
			j -= 1
		}
		if i > j {
			break
		}
		data[i], data[j] = data[j], data[i]
		i += 1
		j -= 1
	}
	data[j], data[a] = data[a], data[j]
	return j, false
}

fn partitionEqualOrdered[E Ordered](data mut []E, a i64, b i64, pivot i64) i64 {
	data[a], data[pivot] = data[pivot], data[a]
	mut i = a + 1
	mut j = b - 1 // i and j are inclusive of the elements remaining to be partitioned
	for {
		for i <= j && !less(data[a], data[i]) {
			i += 1
		}
		for i <= j && less(data[a], data[j]) {
			j -= 1
		}
		if i > j {
			break
		}
		data[i], data[j] = data[j], data[i]
		i += 1
		j -= 1
	}
	return i
}

const partialInsertionSortOrderedMaxSteps = 5 // maximum number of adjacent out-of-order pairs that will get shifted

const partialInsertionSortOrderedShortestShifting = 50 // don't shift any elements on short arrays

fn partialInsertionSortOrdered[E Ordered](data mut []E, a i64, b i64) bool {
	mut i = a + 1
	for j in 0..partialInsertionSortOrderedMaxSteps {
		for i < b && !less(data[i], data[i-1]) {
			i += 1
		}
		if i == b {
			return true
		}
		if b-a < partialInsertionSortOrderedShortestShifting {
			return false
		}
		data[i], data[i-1] = data[i-1], data[i]
		// Shift the smaller one to the left.
		if i-a >= 2 {
			{
				mut k = i - 1
				for k >= 1 {
					if !less(data[k], data[k-1]) {
						break
					}
					data[k], data[k-1] = data[k-1], data[k]
					k -= 1
				}
			}
		}
		// Shift the greater one to the right.
		if b-i >= 2 {
			for k in i + 1..b {
				if !less(data[k], data[k-1]) {
					break
				}
				data[k], data[k-1] = data[k-1], data[k]
			}
		}
	}
	return false
}

fn breakPatternsOrdered[E Ordered](data mut []E, a i64, b i64) {
	let length = b - a
	if length >= 8 {
		mut random = u64(length) // xorshift, seeded with the length: deterministic
		let modulus = u64(1) << u64(bitLen(length))
		{
			mut idx = a + (length/4)*2 - 1
			for idx <= a+(length/4)*2+1 {
				random ^= random << 13
				random ^= random >> 7
				random ^= random << 17
				mut other = i64(random & (modulus - 1))
				if other >= length {
					other -= length
				}
				data[idx], data[a+other] = data[a+other], data[idx]
				idx += 1
			}
		}
	}
}

const choosePivotOrderedShortestNinther = 50

const choosePivotOrderedMaxSwaps = 4 * 3

// choosePivot chooses a pivot in data[a:b] and reports whether the slice looks sorted, reverse
// sorted or neither (a hint).
fn choosePivotOrdered[E Ordered](data []E, a i64, b i64) (i64, i64) {
	let l = b - a
	let swaps = swapCount{}
	mut i = a + l/4*1
	mut j = a + l/4*2
	mut k = a + l/4*3
	if l >= 8 {
		if l >= choosePivotOrderedShortestNinther {
			// Tukey ninther method, the idea came from Rust's implementation.
			i = medianAdjacentOrdered(data, i, mut swaps)
			j = medianAdjacentOrdered(data, j, mut swaps)
			k = medianAdjacentOrdered(data, k, mut swaps)
		}
		// Find the median among i, j, k and stores it into j.
		j = medianOrdered(data, i, j, k, mut swaps)
	}
	if swaps.n == 0 {
		return j, hintIncreasing
	}
	if swaps.n == choosePivotOrderedMaxSwaps {
		return j, hintDecreasing
	}
	return j, hintUnknown
}

// order2 returns x,y where data[x] <= data[y], where x,y=a,b or x,y=b,a.
fn order2Ordered[E Ordered](data []E, a i64, b i64, swaps mut swapCount) (i64, i64) {
	if less(data[b], data[a]) {
		swaps.n += 1
		return b, a
	}
	return a, b
}

// median returns x where data[x] is the median of data[a],data[b],data[c], where x is a, b, or c.
fn medianOrdered[E Ordered](data []E, a i64, b i64, c i64, swaps mut swapCount) i64 {
	a, b = order2Ordered(data, a, b, mut swaps)
	b, c = order2Ordered(data, b, c, mut swaps)
	a, b = order2Ordered(data, a, b, mut swaps)
	return b
}

// medianAdjacent finds the median of data[a - 1], data[a], data[a + 1] and stores the index into a.
fn medianAdjacentOrdered[E Ordered](data []E, a i64, swaps mut swapCount) i64 {
	return medianOrdered(data, a-1, a, a+1, mut swaps)
}

fn reverseRangeOrdered[E Ordered](data mut []E, a i64, b i64) {
	mut i = a
	mut j = b - 1
	for i < j {
		data[i], data[j] = data[j], data[i]
		i += 1
		j -= 1
	}
}

// ---- comparison function ----

fn insertionSortCmpFunc[E constraints.Any](data mut []E, a i64, b i64, cmp fn(E, E) i64) {
	for i in a + 1..b {
		{
			mut j = i
			for j > a && (cmp(data[j], data[j-1]) < 0) {
				data[j], data[j-1] = data[j-1], data[j]
				j -= 1
			}
		}
	}
}

fn siftDownCmpFunc[E constraints.Any](data mut []E, lo i64, hi i64, first i64, cmp fn(E, E) i64) {
	mut root = lo
	for {
		mut child = 2*root + 1
		if child >= hi {
			break
		}
		if child+1 < hi && (cmp(data[first+child], data[first+child+1]) < 0) {
			child += 1
		}
		if !(cmp(data[first+root], data[first+child]) < 0) {
			return
		}
		data[first+root], data[first+child] = data[first+child], data[first+root]
		root = child
	}
}

fn heapSortCmpFunc[E constraints.Any](data mut []E, a i64, b i64, cmp fn(E, E) i64) {
	let first = a
	let lo = 0
	let hi = b - a
	{
		mut i = (hi - 1) / 2
		for i >= 0 {
			siftDownCmpFunc(mut data, i, hi, first, cmp)
			i -= 1
		}
	}
	{
		mut i = hi - 1
		for i >= 0 {
			data[first], data[first+i] = data[first+i], data[first]
			siftDownCmpFunc(mut data, lo, i, first, cmp)
			i -= 1
		}
	}
}

const pdqsortCmpFuncMaxInsertion = 12

fn pdqsortCmpFunc[E constraints.Any](data mut []E, a i64, b i64, limit_ i64, cmp fn(E, E) i64) {
	mut wasBalanced = true // whether the last partitioning was reasonably balanced
	mut wasPartitioned = true // whether the slice was already partitioned
	for {
		let length = b - a
		if length <= pdqsortCmpFuncMaxInsertion {
			insertionSortCmpFunc(mut data, a, b, cmp)
			return
		}
		// Fall back to heapsort if too many bad choices were made.
		if limit_ == 0 {
			heapSortCmpFunc(mut data, a, b, cmp)
			return
		}
		// If the last partitioning was imbalanced, we need to breakPatterns.
		if !wasBalanced {
			breakPatternsCmpFunc(mut data, a, b, cmp)
			limit_ -= 1
		}
		mut (pivot, hint) = choosePivotCmpFunc(data, a, b, cmp)
		if hint == hintDecreasing {
			reverseRangeCmpFunc(mut data, a, b, cmp)
			// The chosen pivot was pivot-a elements after the start of the array.
			// After reversing it is pivot-a elements before the end of the array.
			pivot = (b - 1) - (pivot - a)
			hint = hintIncreasing
		}
		// The slice is likely already sorted.
		if wasBalanced && wasPartitioned && hint == hintIncreasing {
			if partialInsertionSortCmpFunc(mut data, a, b, cmp) {
				return
			}
		}
		// Probably the slice contains many duplicate elements, partition the slice into
		// elements equal to and elements greater than the pivot.
		if a > 0 && !(cmp(data[a-1], data[pivot]) < 0) {
			let mid = partitionEqualCmpFunc(mut data, a, b, pivot, cmp)
			a = mid
			continue
		}
		let (mid, alreadyPartitioned) = partitionCmpFunc(mut data, a, b, pivot, cmp)
		wasPartitioned = alreadyPartitioned
		let leftLen = mid - a
		let rightLen = b - mid
		let balanceThreshold = length / 8
		if leftLen < rightLen {
			wasBalanced = leftLen >= balanceThreshold
			pdqsortCmpFunc(mut data, a, mid, limit_, cmp)
			a = mid + 1
		} else {
			wasBalanced = rightLen >= balanceThreshold
			pdqsortCmpFunc(mut data, mid+1, b, limit_, cmp)
			b = mid
		}
	}
}

fn partitionCmpFunc[E constraints.Any](data mut []E, a i64, b i64, pivot i64, cmp fn(E, E) i64) (i64, bool) {
	data[a], data[pivot] = data[pivot], data[a]
	mut i = a + 1
	mut j = b - 1 // i and j are inclusive of the elements remaining to be partitioned
	for i <= j && (cmp(data[i], data[a]) < 0) {
		i += 1
	}
	for i <= j && !(cmp(data[j], data[a]) < 0) {
		j -= 1
	}
	if i > j {
		data[j], data[a] = data[a], data[j]
		return j, true
	}
	data[i], data[j] = data[j], data[i]
	i += 1
	j -= 1
	for {
		for i <= j && (cmp(data[i], data[a]) < 0) {
			i += 1
		}
		for i <= j && !(cmp(data[j], data[a]) < 0) {
			j -= 1
		}
		if i > j {
			break
		}
		data[i], data[j] = data[j], data[i]
		i += 1
		j -= 1
	}
	data[j], data[a] = data[a], data[j]
	return j, false
}

fn partitionEqualCmpFunc[E constraints.Any](data mut []E, a i64, b i64, pivot i64, cmp fn(E, E) i64) i64 {
	data[a], data[pivot] = data[pivot], data[a]
	mut i = a + 1
	mut j = b - 1 // i and j are inclusive of the elements remaining to be partitioned
	for {
		for i <= j && !(cmp(data[a], data[i]) < 0) {
			i += 1
		}
		for i <= j && (cmp(data[a], data[j]) < 0) {
			j -= 1
		}
		if i > j {
			break
		}
		data[i], data[j] = data[j], data[i]
		i += 1
		j -= 1
	}
	return i
}

const partialInsertionSortCmpFuncMaxSteps = 5 // maximum number of adjacent out-of-order pairs that will get shifted

const partialInsertionSortCmpFuncShortestShifting = 50 // don't shift any elements on short arrays

fn partialInsertionSortCmpFunc[E constraints.Any](data mut []E, a i64, b i64, cmp fn(E, E) i64) bool {
	mut i = a + 1
	for j in 0..partialInsertionSortCmpFuncMaxSteps {
		for i < b && !(cmp(data[i], data[i-1]) < 0) {
			i += 1
		}
		if i == b {
			return true
		}
		if b-a < partialInsertionSortCmpFuncShortestShifting {
			return false
		}
		data[i], data[i-1] = data[i-1], data[i]
		// Shift the smaller one to the left.
		if i-a >= 2 {
			{
				mut k = i - 1
				for k >= 1 {
					if !(cmp(data[k], data[k-1]) < 0) {
						break
					}
					data[k], data[k-1] = data[k-1], data[k]
					k -= 1
				}
			}
		}
		// Shift the greater one to the right.
		if b-i >= 2 {
			for k in i + 1..b {
				if !(cmp(data[k], data[k-1]) < 0) {
					break
				}
				data[k], data[k-1] = data[k-1], data[k]
			}
		}
	}
	return false
}

fn breakPatternsCmpFunc[E constraints.Any](data mut []E, a i64, b i64, cmp fn(E, E) i64) {
	let length = b - a
	if length >= 8 {
		mut random = u64(length) // xorshift, seeded with the length: deterministic
		let modulus = u64(1) << u64(bitLen(length))
		{
			mut idx = a + (length/4)*2 - 1
			for idx <= a+(length/4)*2+1 {
				random ^= random << 13
				random ^= random >> 7
				random ^= random << 17
				mut other = i64(random & (modulus - 1))
				if other >= length {
					other -= length
				}
				data[idx], data[a+other] = data[a+other], data[idx]
				idx += 1
			}
		}
	}
}

const choosePivotCmpFuncShortestNinther = 50

const choosePivotCmpFuncMaxSwaps = 4 * 3

// choosePivot chooses a pivot in data[a:b] and reports whether the slice looks sorted, reverse
// sorted or neither (a hint).
fn choosePivotCmpFunc[E constraints.Any](data []E, a i64, b i64, cmp fn(E, E) i64) (i64, i64) {
	let l = b - a
	let swaps = swapCount{}
	mut i = a + l/4*1
	mut j = a + l/4*2
	mut k = a + l/4*3
	if l >= 8 {
		if l >= choosePivotCmpFuncShortestNinther {
			// Tukey ninther method, the idea came from Rust's implementation.
			i = medianAdjacentCmpFunc(data, i, mut swaps, cmp)
			j = medianAdjacentCmpFunc(data, j, mut swaps, cmp)
			k = medianAdjacentCmpFunc(data, k, mut swaps, cmp)
		}
		// Find the median among i, j, k and stores it into j.
		j = medianCmpFunc(data, i, j, k, mut swaps, cmp)
	}
	if swaps.n == 0 {
		return j, hintIncreasing
	}
	if swaps.n == choosePivotCmpFuncMaxSwaps {
		return j, hintDecreasing
	}
	return j, hintUnknown
}

// order2 returns x,y where data[x] <= data[y], where x,y=a,b or x,y=b,a.
fn order2CmpFunc[E constraints.Any](data []E, a i64, b i64, swaps mut swapCount, cmp fn(E, E) i64) (i64, i64) {
	if (cmp(data[b], data[a]) < 0) {
		swaps.n += 1
		return b, a
	}
	return a, b
}

// median returns x where data[x] is the median of data[a],data[b],data[c], where x is a, b, or c.
fn medianCmpFunc[E constraints.Any](data []E, a i64, b i64, c i64, swaps mut swapCount, cmp fn(E, E) i64) i64 {
	a, b = order2CmpFunc(data, a, b, mut swaps, cmp)
	b, c = order2CmpFunc(data, b, c, mut swaps, cmp)
	a, b = order2CmpFunc(data, a, b, mut swaps, cmp)
	return b
}

// medianAdjacent finds the median of data[a - 1], data[a], data[a + 1] and stores the index into a.
fn medianAdjacentCmpFunc[E constraints.Any](data []E, a i64, swaps mut swapCount, cmp fn(E, E) i64) i64 {
	return medianCmpFunc(data, a-1, a, a+1, mut swaps, cmp)
}

fn reverseRangeCmpFunc[E constraints.Any](data mut []E, a i64, b i64, cmp fn(E, E) i64) {
	mut i = a
	mut j = b - 1
	for i < j {
		data[i], data[j] = data[j], data[i]
		i += 1
		j -= 1
	}
}

// ---- stable sort (comparison function only) ----

// stableCmpFunc sorts data[0:n] stably: insertion sort on blocks of 20, then merges of
// doubling blocks (SymMerge, which needs no scratch memory).
fn stableCmpFunc[E constraints.Any](data mut []E, n i64, cmp fn(E, E) i64) {
	mut blockSize = 20 // must be > 0
	mut a = 0
	mut b = blockSize
	for b <= n {
		insertionSortCmpFunc(mut data, a, b, cmp)
		a = b
		b += blockSize
	}
	insertionSortCmpFunc(mut data, a, n, cmp)
	for blockSize < n {
		a = 0
		b = 2 * blockSize
		for b <= n {
			symMergeCmpFunc(mut data, a, a+blockSize, b, cmp)
			a = b
			b += 2 * blockSize
		}
		let m = a + blockSize
		if m < n {
			symMergeCmpFunc(mut data, a, m, n, cmp)
		}
		blockSize *= 2
	}
}

// symMergeCmpFunc merges the sorted runs data[a:m] and data[m:b] in place, stably, using
// rotations (Kim and Kutzner, "Stable Minimum Storage Merging by Symmetric Comparisons").
fn symMergeCmpFunc[E constraints.Any](data mut []E, a i64, m i64, b i64, cmp fn(E, E) i64) {
	// Avoid unnecessary recursions of symMerge by direct insertion of data[a] into data[m:b]
	// if data[a:m] only contains one element.
	if m-a == 1 {
		// Use binary search to find the lowest index i such that data[i] >= data[a] for m <= i < b.
		mut i = m
		mut j = b
		for i < j {
			let h = (i + j) >> 1
			if cmp(data[h], data[a]) < 0 {
				i = h + 1
			} else {
				j = h
			}
		}
		// Swap values until data[a] reaches the position before i.
		for k in a..i-1 {
			data[k], data[k+1] = data[k+1], data[k]
		}
		return
	}
	// Avoid unnecessary recursions of symMerge by direct insertion of data[m] into data[a:m]
	// if data[m:b] only contains one element.
	if b-m == 1 {
		// Use binary search to find the lowest index i such that data[i] > data[m] for a <= i < m.
		mut i = a
		mut j = m
		for i < j {
			let h = (i + j) >> 1
			if !(cmp(data[m], data[h]) < 0) {
				i = h + 1
			} else {
				j = h
			}
		}
		// Swap values until data[m] reaches the position i.
		{
			mut k = m
			for k > i {
				data[k], data[k-1] = data[k-1], data[k]
				k -= 1
			}
		}
		return
	}
	let mid = (a + b) >> 1
	let n = mid + m
	mut start i64
	mut r i64
	if m > mid {
		start = n - b
		r = mid
	} else {
		start = a
		r = m
	}
	let p = n - 1
	for start < r {
		let c = (start + r) >> 1
		if !(cmp(data[p-c], data[c]) < 0) {
			start = c + 1
		} else {
			r = c
		}
	}
	let end = n - start
	if start < m && m < end {
		rotateRange(mut data, start, m, end)
	}
	if a < start && start < mid {
		symMergeCmpFunc(mut data, a, start, mid, cmp)
	}
	if mid < end && end < b {
		symMergeCmpFunc(mut data, mid, end, b, cmp)
	}
}

// rotateRange rotates the two consecutive blocks data[a:m] and data[m:b] by swapping.
fn rotateRange[E constraints.Any](data mut []E, a i64, m i64, b i64) {
	mut i = m - a
	mut j = b - m
	for i != j {
		if i > j {
			swapRange(mut data, m-i, m, j)
			i -= j
		} else {
			swapRange(mut data, m-i, m+j-i, i)
			j -= i
		}
	}
	// i == j
	swapRange(mut data, m-i, m, i)
}

fn swapRange[E constraints.Any](data mut []E, a i64, b i64, n i64) {
	for i in 0..n {
		data[a+i], data[b+i] = data[b+i], data[a+i]
	}
}
