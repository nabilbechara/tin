package wire

import "say"

extern func getaddrinfo(node i64, service i64, hints i64, res i64) i64
extern func freeaddrinfo(res i64)

// resolve fills a sockaddr_in for host (dotted IPv4, "localhost" or a DNS name).
func resolve(host str, port i64, sa i64, until i64) ! {
	rt_sockaddr_in(sa, 0, port)
	if host == "" || host == "localhost" {
		if host == "localhost" {
			rt_sockaddr_in(sa, 0x7f000001, port)
		}
		return
	}
	parts := 0
	val := 0
	octets := calloc(1, 8)
	dotted := true
	for i := 0; i < len(host); i++ {
		c := host[i]
		if c == '.' {
			if parts >= 3 || val > 255 {
				dotted = false
				break
			}
			store8(octets+parts, val)
			parts++
			val = 0
		} else if c >= '0' && c <= '9' {
			val = val*10 + i64(c-'0')
		} else {
			dotted = false
			break
		}
	}
	if dotted && parts == 3 && val <= 255 {
		store8(octets+3, val)
		memcpy(sa+4, octets, 4)
		free(octets)
		return
	}
	free(octets)
	// getaddrinfo blocks: inside a request task it runs on a helper thread.
	job := calloc(3, 8)
	job[0] = rt_heap_str(host)
	job[1] = calloc(1, 16)
	try rt_helper_run(dns_job, job, dns_drop)
	ok := job[2] != 0
	if ok {
		memcpy(sa+4, job[1]+4, 4)
	}
	dns_drop(job)
	if !ok {
		fail say.Fault("wire: cannot resolve %q", host)
	}
}

func dns_drop(job i64) {
	free(job[0])
	free(job[1])
	free(job)
}

// dns_job resolves heap-owned inputs into its own sockaddr; job[2] is 1 on success.
func dns_job(job i64) {
	hints := calloc(1, 48)
	__st(hints+4, 2, 2)
	__st(hints+8, 1, 2)
	res := calloc(1, 8)
	rc := i64(i32(getaddrinfo(job[0]+8, 0, hints, res)))
	free(hints)
	if rc != 0 || res[0] == 0 {
		free(res)
		return
	}
	ai := res[0]
	addr := rt_ai_addr(ai)
	memcpy(job[1]+4, addr+4, 4)
	freeaddrinfo(ai)
	free(res)
	job[2] = 1
}
