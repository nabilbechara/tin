// Package atlas is the functions on maps (like Go's maps): keys, values, copies and comparisons.
package atlas

import "constraints"
import "sift"

// Keys returns m's keys in insertion order.
fn Keys[K constraints.Comparable, V constraints.Any](m map[K]V) []K {
	mut out = make([]K, 0, len(m))
	for k, _ in m {
		out = append(out, k)
	}
	return out
}

// Values returns m's values in insertion order.
fn Values[K constraints.Comparable, V constraints.Any](m map[K]V) []V {
	mut out = make([]V, 0, len(m))
	for _, v in m {
		out = append(out, v)
	}
	return out
}

// SortedKeys returns m's keys in ascending order (NaN first), whatever order they were added in.
fn SortedKeys[K sift.Ordered, V constraints.Any](m map[K]V) []K {
	mut out = make([]K, 0, len(m))
	for k, _ in m {
		out = append(out, k)
	}
	sift.Sort(mut out)
	return out
}

// Clone returns a new map with the same entries, in the same order.
fn Clone[K constraints.Comparable, V constraints.Any](m map[K]V) map[K]V {
	let out = make(map[K]V)
	for k, v in m {
		out[k] = v
	}
	return out
}

// Copy adds every entry of src to dst, replacing the values of keys dst already has.
fn Copy[K constraints.Comparable, V constraints.Any](dst mut map[K]V, src map[K]V) {
	for k, v in src {
		dst[k] = v
	}
}

// Equal reports whether a and b have the same keys with equal values.
fn Equal[K constraints.Comparable, V constraints.Comparable](a map[K]V, b map[K]V) bool {
	if len(a) != len(b) {
		return false
	}
	for k, v1 in a {
		let (v2, ok) = b[k]
		if !ok || v1 != v2 {
			return false
		}
	}
	return true
}

// EqualFunc is Equal with eq comparing the values, which may have different types.
fn EqualFunc[K constraints.Comparable, V1 constraints.Any, V2 constraints.Any](a map[K]V1, b map[K]V2, eq fn(V1, V2) bool) bool {
	if len(a) != len(b) {
		return false
	}
	for k, v1 in a {
		let (v2, ok) = b[k]
		if !ok || !eq(v1, v2) {
			return false
		}
	}
	return true
}

// DeleteFunc removes the entries for which del is true.
fn DeleteFunc[K constraints.Comparable, V constraints.Any](m mut map[K]V, del fn(K, V) bool) {
	mut drop = make([]K, 0)
	for k, v in m {
		if del(k, v) {
			drop = append(drop, k)
		}
	}
	for _, k in drop {
		delete(m, k)
	}
}
