package tls

// ---- checking the server's certificate ----

// verify_peer checks the server's certificate chain for name against the roots, and its
// CertificateVerify signature (scheme, sig) over signed. Certificates need seal's X.509
// support (phase 2 of #124); until it is there every connection fails here unless the
// Config says InsecureSkipVerify, so verification can never be skipped by accident.
fn verify_peer(cfg Config, name str, certs [][]u8, scheme i64, signed []u8, sig []u8) ! {
	if cfg.InsecureSkipVerify {
		return
	}
	fail alert_fault(alertBadCertificate, "certificate verification is not available yet (needs X.509 support, #124 phase 2); InsecureSkipVerify is for tests only")
}
