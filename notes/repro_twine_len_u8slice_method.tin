package main

import "say"

type Box struct {
	buf []u8
}

fn (b Box) Bytes() []u8 {
	return b.buf
}

fn (b Box) Len() i64 {
	return len(b.buf)
}

fn bytesOf(b Box) []u8 {
	return b.buf
}

fn main() {
	let b = Box{buf: make([]u8, 0, 8)}
	b.buf = append(b.buf, 'x')
	say.Line("method slice in len", len(b.Bytes()))
}
