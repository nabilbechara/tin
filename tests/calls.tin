// Calls whose arguments mix nested calls, globals, loads and constants.
var g1 = 7;
var g2;

fn five(a, b, c, d, e) {
    return a * 10000 + b * 1000 + c * 100 + d * 10 + e;
}

fn two(a, b) {
    return a * 10 + b;
}

fn ident(x) {
    return x;
}

fn mk(pos, kind) {
    let n = malloc(64);
    n[0] = kind;
    n[1] = pos;
    return n;
}

fn bin(pos, op, l, r, t) {
    let b = mk(pos, 5);
    b[2] = op;
    b[3] = l;
    b[4] = r;
    b[6] = t;
    return b;
}

fn main() {
    let p = 3;
    let s = malloc(64);
    s[4] = 9;
    g2 = 2;
    print_int(five(p, 1, ident(4), ident(5), g1)); println("");
    print_int(five(ident(1), p, s[4], ident(2), g2)); println("");
    print_int(five(1, two(ident(2), g1), 3, ident(4), g1)); println("");
    print_int(two(ident(ident(3)), two(g2, ident(1)))); println("");
    let inner = bin(p, 62, mk(p, 3), mk(p, 1), g1);
    let outer = bin(p, 43, mk(p, 3), bin(p, 62, mk(p, 3), mk(p, 1), g1), g1);
    print_int(inner[1]); print(" "); print_int(inner[2]); print(" "); print_int(inner[3][0]); print(" "); print_int(inner[4][0]); print(" "); print_int(inner[6]); println("");
    let in2 = outer[4];
    print_int(outer[1]); print(" "); print_int(outer[2]); print(" "); print_int(outer[3][0]); print(" "); print_int(in2[1]); print(" "); print_int(in2[2]); print(" "); print_int(in2[3][0]); print(" "); print_int(in2[4][0]); print(" "); print_int(in2[6]); println("");
    return 0;
}

// expect: 31457
// expect: 13922
// expect: 37347
// expect: 51
// expect: 3 62 3 1 7
// expect: 3 43 3 3 62 3 1 7
