const BIG = 1 << 40;
const MASK = ~0 ^ 0xff;

fn show(n) {
    print_int(n);
    println("");
}

fn main() {
    show(1 + 2 * 3);       // expect: 7
    show((1 + 2) * 3);     // expect: 9
    show(7 / 2);           // expect: 3
    show(-7 / 2);          // expect: -3
    show(7 % 3);           // expect: 1
    show(-7 % 3);          // expect: -1
    show(10 - 3 - 2);      // expect: 5
    show(1 << 10 | 3);     // expect: 1027
    show(0xf0 & 0x3c);     // expect: 48
    show(6 ^ 3);           // expect: 5
    show(-16 >> 2);        // expect: -4
    show(~5);              // expect: -6
    show(-(-9));           // expect: 9
    show(BIG);             // expect: 1099511627776
    show(MASK);            // expect: -256
    show(9223372036854775807); // expect: 9223372036854775807
    show(-65536);          // expect: -65536
    show(65536);           // expect: 65536
    show(3 < 4);           // expect: 1
    show(4 <= 3);          // expect: 0
    show(5 == 5);          // expect: 1
    show(5 != 5);          // expect: 0
    show(!0);              // expect: 1
    show(!7);              // expect: 0
    show('A' + 1);         // expect: 66
    show(1 + 2 == 3);      // expect: 1
    return 0;
}
