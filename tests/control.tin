fn classify(n) {
    if n < 0 {
        return -1;
    } else if n == 0 {
        return 0;
    } else {
        return 1;
    }
}

fn main() {
    print_int(classify(-5)); print_int(classify(0)); print_int(classify(9));
    println("");            // expect: -101

    let i = 0;
    let sum = 0;
    while 1 {
        i = i + 1;
        if i % 2 == 0 {
            continue;
        }
        if i > 9 {
            break;
        }
        sum = sum + i;
    }
    print_int(sum);
    println("");            // expect: 25

    let row = 1;
    while row <= 3 {
        let col = 1;
        while col <= row {
            print_int(row * col);
            print(" ");
            col = col + 1;
        }
        println("");
        row = row + 1;
    }
    // expect: 1 
    // expect: 2 4 
    // expect: 3 6 9 
    return 0;
}
