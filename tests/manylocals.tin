// Forces frame offsets past the 256-byte ldur/stur range.
fn main() {
    let a0 = 0; let a1 = 1; let a2 = 2; let a3 = 3; let a4 = 4; let a5 = 5; let a6 = 6; let a7 = 7;
    let b0 = 0; let b1 = 1; let b2 = 2; let b3 = 3; let b4 = 4; let b5 = 5; let b6 = 6; let b7 = 7;
    let c0 = 0; let c1 = 1; let c2 = 2; let c3 = 3; let c4 = 4; let c5 = 5; let c6 = 6; let c7 = 7;
    let d0 = 0; let d1 = 1; let d2 = 2; let d3 = 3; let d4 = 4; let d5 = 5; let d6 = 6; let d7 = 7;
    let e0 = 10; let e1 = 11; let e2 = 12;
    e2 = e2 + e0;
    print_int(e2 + a7 + d7); println(""); // expect: 36
    let p = &e1;
    p[0] = 99;
    print_int(e1); println("");           // expect: 99
    return 0;
}
