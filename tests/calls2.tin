// Nested calls as arguments of a call that is itself an argument (the lower_range shape).
var gt = 7;

fn mk(pos, kind) {
    let n = malloc(64);
    n[0] = kind;
    n[1] = pos;
    return n;
}

fn bin(pos, op, l, r, t) {
    let b = mk(pos, 5);
    b[2] = op;
    b[3] = l;
    b[4] = r;
    b[6] = t;
    return b;
}

fn show(b) {
    print_int(b[1]); print(" "); print_int(b[2]); print(" "); print_int(b[3][0]); print(" "); print_int(b[4][0]); print(" "); print_int(b[6]); println("");
}

fn main() {
    let pos = 11;
    let x = malloc(64);
    x[4] = 3;
    let i = mk(pos, 1);
    let outer = bin(pos, 43, mk(pos, i[0]), bin(pos, 62, mk(pos, x[4]), mk(pos, 32), gt), gt);
    show(outer);
    show(outer[4]);
    return 0;
}

// expect: 11 43 1 5 7
// expect: 11 62 3 32 7
