// Calls nested deep enough to exhaust the temporaries (the push-all fallback).
var gt = 7;

fn mk(pos, kind) {
    let n = malloc(64);
    n[0] = kind;
    n[1] = pos;
    return n;
}

fn bin(pos, op, l, r, t) {
    let b = mk(pos, 5);
    b[2] = op;
    b[3] = l;
    b[4] = r;
    b[6] = t;
    return b;
}

fn sum5(a, b, c, d, e) {
    return a + b + c + d + e;
}

fn main() {
    let a = 1; let b = 2; let c = 3; let d = 4; let e = 5; let f = 6; let g = 7; let h = 8; let k = 9;
    let x = malloc(64);
    x[4] = 3;
    let deep = sum5(a, sum5(b, mk(1, 2)[1], sum5(c, d, mk(e, f)[0], sum5(g, h, k, mk(k, x[4])[0], gt), gt), gt, x[4]), gt, x[4], sum5(a, b, c, d, mk(a, b)[1]));
    print_int(deep); println("");
    let outer = bin(a, 43, mk(b, x[4]), bin(c, 62, mk(d, x[4]), mk(e, 32), sum5(f, g, h, k, gt)), gt);
    print_int(outer[1]); print(" "); print_int(outer[3][0]); print(" "); print_int(outer[4][2]); print(" "); print_int(outer[4][6]); print(" "); print_int(a + b + c + d + e + f + g + h + k); println("");
    return 0;
}

// expect: 89
// expect: 1 3 62 37 45
