package main

type Plain struct {
	n i64
}

type Quiet struct {
	n i64
}

fn (q Quiet) Close() {
}

fn plain() !Plain {
	return Plain{n: 1}
}

fn quiet() !Quiet {
	return Quiet{n: 1}
}

fn sure() Quiet {
	return Quiet{n: 2}
}

use p = plain()
use s = sure()

on app.begin {
}

on server.overload {
}

fn noFault() i64 {
	use q = quiet()
	return q.n
}

fn looped() ! {
	for i in 0..3 {
		use q = quiet()
	}
}

fn closeless() ! {
	use q = quiet()
}

fn main() {
}
