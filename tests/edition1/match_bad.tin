package main

type Shape enum {
	Circle(f64)
	Rect(f64, f64)
	Empty
}

// An enum match handles every variant, or has _.
fn missing(s Shape) i64 {
	match s {
		Circle(r) => return 1
	}
	return 0
}

// A match that gives a value handles every value.
fn partial(n i64) str {
	return match n {
		1 => "one"
		2 => "two"
	}
}

// Nothing after an arm that matches everything.
fn unreachable(n i64) i64 {
	match n {
		_ => return 0
		1 => return 1
	}
}

fn twice(s Shape) i64 {
	match s {
		Empty => return 0
		Shape.Empty => return 1
		_ => return 2
	}
}

// A name in a pattern binds; a local variable is compared with a guard.
fn local(n i64, want i64) i64 {
	match n {
		want => return 1
		_ => return 0
	}
}

fn notEnum(n i64) i64 {
	match n {
		Circle(r) => return 1
		_ => return 0
	}
}

fn noVariant(s Shape) i64 {
	match s {
		Square => return 1
		_ => return 0
	}
}

fn arity(s Shape) i64 {
	match s {
		Rect(w) => return 1
		_ => return 0
	}
}

fn bindTwo(s Shape) i64 {
	match s {
		Circle(r), Empty => return 1
		_ => return 0
	}
}

fn inExpr(n i64) i64 {
	return 1 + match n {
		1 => {
			let x = 2
			x
		}
		_ => 0
	}
}

fn main() {
}
