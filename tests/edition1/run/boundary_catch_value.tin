package main

import "policy"
import "say"

// A boundary block whose last expression is a catch expression (#449): on the fault path the
// block's value is the catch arm's, as it is for a let. It was 0.

fn bad() !i64 {
	fail "no"
}

fn good() !i64 {
	return 7
}

fn main() {
	let a = guard {
		bad() catch _ { -1 }
	} catch _ {
		-2
	}
	let b = guard {
		good() catch _ { -1 }
	} catch _ {
		-2
	}
	let c = within 1s {
		bad() catch _ { -3 }
	} catch _ {
		-2
	}
	let d = limit memory 1000000 {
		bad() catch _ { -4 }
	} catch _ {
		-2
	}
	let e = with policy.Retry(2) {
		bad() catch _ { -5 }
	} catch _ {
		-2
	}
	let f = arena {
		bad() catch _ { -6 }
	}
	let g = bad() catch _ { -1 }
	say.Line(a, b, c, d, e, f, g)
}
