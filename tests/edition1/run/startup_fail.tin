package main

import "quarry"
import "say"

type Conn struct {
	name str
}

fn (c Conn) Close() ! {
	say.Line("close", c.name)
}

fn connect(name str) !Conn {
	if name == "" {
		fail "no address"
	}
	say.Line("open", name)
	return Conn{name: name}
}

use conn = connect(quarry.Getenv("CONN_NAME"))

on app.start {
	if quarry.Getenv("START_FAIL") != "" {
		fail "migration refused"
	}
	say.Line("app.start")
}

on core.start {
	if quarry.Getenv("CORE_PANIC") != "" {
		let xs = []i64{}
		say.Line(xs[1])
	}
}

fn main() {
	say.Line("main", conn.name)
}
