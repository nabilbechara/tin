package main

// An edition 1 program with vendored edition 1 packages imported by path (#146); rawlen is
// granted unsafe, so it may use raw memory and is still read as edition 1.
import "example.com/greet"
import "example.com/rawlen"
import "say"

fn main() {
	say.Line(greet.Hello("tin"))
	say.Line("raw length", rawlen.Of("tin1"))
}
