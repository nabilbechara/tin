package main

import "say"
import "tide"

mut order str = ""

fn fetch(i i64) !str {
	try tide.Wait((4 - i) * 10 * tide.Millisecond)
	order = keep(order + "{i}")
	if i == 7 {
		fail "fetch {i} failed"
	}
	return "page{i}"
}

fn fetchAll(n i64) ![]str {
	let pages = make([]str, n)
	scope s {
		for i in 0..n {
			let k = i
			s.spawn(fn() ! {
				pages[k] = try fetch(k)
			})
		}
	}
	return pages
}

fn slowOrFail(i i64) ! {
	if i == 0 {
		fail "first child failed"
	}
	try tide.Wait(5 * tide.Second)
}

fn firstFault() ! {
	scope s {
		for i in 0..3 {
			let k = i
			s.spawn(fn() ! {
				try slowOrFail(k)
			})
		}
	}
}

fn handles() !str {
	mut got str = ""
	scope s {
		let t = s.spawn(fn() ! {
			try tide.Wait(5 * tide.Second)
		})
		let u = s.spawn(fn() ! {
			try tide.Wait(tide.Millisecond)
		})
		try u.wait()
		t.cancel()
		t.wait() catch err {
			got = keep("cancelled: {err}")
		}
	}
	return got
}

fn main() {
	let start = tide.Now()
	let pages = fetchAll(4) catch err {
		say.Line("never", err)
		[]str{}
	}
	let ms = (tide.Now() - start) / tide.Millisecond
	say.Line("pages:", pages, "overlapped:", ms < 80, "finish order:", order)
	let t0 = tide.Now()
	firstFault() catch err {
		say.Line("scope fault:", err, "fast:", (tide.Now() - t0) / tide.Millisecond < 1000)
	}
	let h = handles() catch err {
		"never {err}"
	}
	say.Line("handles:", h)
	order = ""
	let failed = fetchAll(8) catch err {
		say.Line("fetchAll(8):", err)
		[]str{}
	}
	say.Line("failed pages:", len(failed))
}
