package main

import "hearth"
import "say"
import "tide"

// #176: a long-lived task holds back every release on its core. Past the limbo's cap a
// dropped block is pinned (it leaks, as before reclamation) instead of growing the queue.
mut cache = map[str]str{}

fn put(i i64) {
	cache["k"] = keep("value-{i}-padding-padding")
}

fn main() {
	detach {
		try tide.Wait(60 * tide.Second)
	}
	for i in 0..1100000 {
		hearth.Reset()
		put(i)
	}
	let (blocks, bytes, limbo) = hearth.RcStats()
	say.Line("len", len(cache), "blocks", blocks, "limbo", limbo)
}
