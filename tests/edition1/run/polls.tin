package main

import "say"
import "tide"

mut cleaned bool = false

fn cleanup() {
	cleaned = true
}

fn spin() {
	for {
	}
}

@nopoll fn kernel() {
	mut n i64 = 0
	for i in 0..100000000 {
		n += i
	}
	cleaned = n > 0
}

fn main() {
	let start = tide.Now()
	within 200ms {
		defer cleanup()
		spin()
	} catch err {
		say.Line("poll fault:", err)
	}
	say.Line("bounded:", tide.Now() - start < 1s)
	say.Line("deferred:", cleaned)
	cleaned = false
	within 10ms {
		kernel()
	} catch _ {
	}
	say.Line("nopoll completed:", cleaned)
	let a = limit memory 8mb {
		mut n i64 = 0
		for i in 0..10000 {
			n += 1
		}
		n
	} catch _ {
		-1
	}
	let b = guard {
		mut n i64 = 0
		for i in 0..10000 {
			n += 1
		}
		n
	} catch _ {
		-1
	}
	say.Line("unlimited:", a, b)
}
