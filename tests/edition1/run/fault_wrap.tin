package main

import "fault"
import "say"
import "tide"

let ErrNotFound = fault("not found")

fn find(k str) !i64 {
	if k == "missing" {
		fail ErrNotFound
	}
	if k == "bad" {
		fail "bad key"
	}
	return 7
}

fn load(id i64, k str) !i64 {
	let v = try find(k) wrap "loading user {id}"
	return v
}

fn handle(k str) !i64 {
	return try load(1, k) wrap "handle"
}

fn touch(k str) ! {
	try load(2, k) wrap "touch {k}"
}

fn show(k str) {
	let v = handle(k) catch err {
		say.Line(k, "->", err, fault.Is(err, ErrNotFound))
		0
	}
	say.Line(k, "value", v)
}

fn third(xs []i64) i64 {
	return xs[3]
}

// guard and within (#230, #231) produce the runtime's sentinels, matched by identity.
fn boundaries() {
	guard {
		let xs = []i64{1}
		say.Line("never", third(xs))
	} catch err {
		say.Line("guard:", err, fault.Is(err, fault.Panic), fault.Is(err, fault.DeadlineExceeded))
	}
	within 20 * tide.Millisecond {
		try tide.Wait(5 * tide.Second) wrap "sleeping"
	} catch err {
		say.Line("within:", err, fault.Is(err, fault.DeadlineExceeded), fault.Is(err, fault.Canceled), fault.Is(err, fault.Panic))
	}
}

fn main() {
	show("missing")
	show("bad")
	show("ok")
	touch("missing") catch err {
		say.Line("touch ->", err, fault.Is(err, ErrNotFound))
	}
	boundaries()
}
