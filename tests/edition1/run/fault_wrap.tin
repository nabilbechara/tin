package main

import "fault"
import "say"

let ErrNotFound = fault("not found")

fn find(k str) !i64 {
	if k == "missing" {
		fail ErrNotFound
	}
	if k == "bad" {
		fail "bad key"
	}
	return 7
}

fn load(id i64, k str) !i64 {
	let v = try find(k) wrap "loading user {id}"
	return v
}

fn handle(k str) !i64 {
	return try load(1, k) wrap "handle"
}

fn touch(k str) ! {
	try load(2, k) wrap "touch {k}"
}

fn show(k str) {
	let v = handle(k) catch err {
		say.Line(k, "->", err, fault.Is(err, ErrNotFound))
		0
	}
	say.Line(k, "value", v)
}

fn main() {
	show("missing")
	show("bad")
	show("ok")
	touch("missing") catch err {
		say.Line("touch ->", err, fault.Is(err, ErrNotFound))
	}
}
