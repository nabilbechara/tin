package main

import "say"
import "tide"

/* The translator's rewrites (#225), one of each.
   The translated program prints the same lines. */

type Shape enum {
	Circle(r f64)
	Rect(w, h f64)
}

type Item struct {
	Name str @json("name")
	Count i64
}

const (
	Red = iota
	Green
	Blue
)

func makeCounter() func() i64 {
	n := 0
	return func() i64 {
		n++
		return n
	}
}

func area(s Shape) f64 {
	switch s {
	case Circle(r):
		return 3 * r * r
	case Rect(w, h):
		return w * h
	}
	return 0
}

func classify(n i64) str {
	switch {
	case n < 0:
		return "negative"
	case n == 0:
		return "zero"
	default:
		return "positive"
	}
	return ""
}

// filter keeps the elements keep accepts: a parameter named like the builtin.
func filter(xs []i64, keep func(i64) bool) []i64 {
	var out []i64
	for _, x := range xs {
		if keep(x) {
			out = append(out, x)
		}
	}
	return out
}

func half() i64 {
	const top = 10 // the hoisted constant keeps this comment
	return top / 2
}

func limits() i64 {
	const limit = 3
	total := 0
	for i := 0; i < limit; i++ {
		total += i
	}
	return total
}

func main() {
	var count i64
	xs := []i64{5, 6, 7}
	for i := 0; i < 3; i++ {
		count += xs[i]
	}
	for i := 10; i <= 12; i++ {
		count += i
	}
	sum := 0
	for _, x := range xs {
		it := Item{Name: "x", Count: x}
		sum += it.Count
	}
	for _, w := range []str{"ab", "c"} {
		sum += len(w)
	}
	for i := 0; i < len(xs) && i < 2; i++ {
		sum += xs[i]
	}
	evens := filter(xs, func(x i64) bool { return x%2 == 0 })
	sum += len(evens)
	for i := range xs {
		sum += i
	}
	for i := range 3 {
		sum += i
	}
	m := map[str]i64{"a": 1}
	if v, ok := m["a"]; ok {
		say.Line("found", v)
	}
	match := 2
	keep := 1
	say.Line("count", count, "sum", sum, "match", match, "keep", keep)
	next := makeCounter()
	next()
	say.Line("counter", next())
	say.Line("shape", Shape.Rect(2, 3))
	say.Line("areas", area(Shape.Circle(1)), area(Shape.Rect(2, 3)))
	say.Line("classify", classify(-1), classify(0), classify(4))
	say.Line("limits", limits(), Red, Green, Blue, half())
	say.Line("item", Item{Name: "pen", Count: 2})
	err := fail("boom")
	say.Line("fault", err)
	d := 200 * tide.Millisecond
	say.Line("wait", d == tide.Millisecond*200)
	fs := map[str]func() i64{"one": func() i64 { return 1 }}
	say.Line("call", fs["one"]())
}
