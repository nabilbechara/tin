package main

import "say"
import "tide"

// The translator's rewrites (#225), one of each.
// The translated program prints the same lines.

type Shape enum {
	Circle(r f64)
	Rect(w, h f64)
}

type Item struct {
	@json("name") Name str
	Count i64
}

const Red = 0
const Green = 1
const Blue = 2

fn makeCounter() fn() i64 {
	mut n = 0
	return fn() i64 {
		n += 1
		return n
	}
}

fn area(s Shape) f64 {
	match s {
		Circle(r) => {
			return 3 * r * r
		}
		Rect(w, h) => {
			return w * h
		}
	}
	return 0
}

fn classify(n i64) str {
	match true {
		true if (n < 0) => {
			return "negative"
		}
		true if (n == 0) => {
			return "zero"
		}
		_ => {
			return "positive"
		}
	}
	return ""
}

const limit_ = 3

fn limits() i64 {
	mut total = 0
	for i in 0..limit_ {
		total += i
	}
	return total
}

fn main() {
	mut count i64
	let xs = []i64{5, 6, 7}
	for i in 0..3 {
		count += xs[i]
	}
	{
		mut i = 10
		for i <= 12 {
			count += i
			i += 1
		}
	}
	mut sum = 0
	for _, x in xs {
		sum += x
	}
	for i, _ in xs {
		sum += i
	}
	for i in 0..3 {
		sum += i
	}
	let m = map[str]i64{"a": 1}
	{
		let (v, ok) = m["a"]
		if ok {
			say.Line("found", v)
		}
	}
	let match_ = 2
	say.Line("count", count, "sum", sum, "match", match_)
	let next = makeCounter()
	next()
	say.Line("counter", next())
	say.Line("shape", Shape.Rect(2, 3))
	say.Line("areas", area(Shape.Circle(1)), area(Shape.Rect(2, 3)))
	say.Line("classify", classify(-1), classify(0), classify(4))
	say.Line("limits", limits(), Red, Green, Blue)
	say.Line("item", Item{Name: "pen", Count: 2})
	let err = fail("boom")
	say.Line("fault", err)
	let d = 200ms
	say.Line("wait", d == 200ms)
	let fs = map[str]fn() i64{"one": fn() i64 { return 1 }}
	say.Line("call", fs["one"]())
}
