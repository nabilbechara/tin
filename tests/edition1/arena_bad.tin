package main

import "say"

type Box struct {
	label str
	items []str
}

fn setLabel(b mut Box, s str) {
	b.label = s
}

fn add(b mut Box, s str) {
	b.items = append(b.items, s)
}

// Memory made in an arena cannot be stored into anything made outside it (#236).
fn main() {
	mut last = ""
	mut box = Box{label: "", items: []str{}}
	mut counts = map[str]i64{}
	mut nums = []i64{}
	mut names = make([]str, 0, 4)
	let n = arena {
		let tmp = "t{len(last)}"
		last = tmp
		box.label = "x{1}"
		setLabel(mut box, "y{2}")
		add(mut box, "z")
		counts["k"] = 1
		nums = append(nums, 1)
		// A view shares the outer array: with spare capacity, append writes into it.
		mut view = names[0:0]
		view = append(view, "v{5}")
		// Allowed: outside values into outside objects, arena values into arena objects,
		// static strings, and keep() copies.
		box.label = last
		setLabel(mut box, "static")
		box.label = keep("k{3}")
		let local = Box{label: tmp, items: []str{tmp}}
		local.items = append(local.items, "w{4}")
		len(local.items)
	}
	say.Line(n, last, box.label, counts, nums, names)
}
