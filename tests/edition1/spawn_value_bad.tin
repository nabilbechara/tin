package main

// A handle of a child with a value (spawnedOf[T], #232) cannot outlive its scope either.

mut saved = []spawnedOf[i64]{}

fn leak(s scope) spawnedOf[i64] {
	return s.spawn(fn() !i64 {
		return 1
	})
}

fn keepIt() ! {
	scope s {
		saved = append(saved, s.spawn(fn() !i64 {
			return 2
		}))
	}
}

fn main() {
}
