package main

import "argo"
import "herald"
import "say"

// Every sink rejects a secret at compile time (#239): formatting, logging, JSON, fault
// messages and panics.

type User struct {
	id    i64
	token secret str
}

fn find() !i64 {
	return 1
}

fn load(k secret str) !i64 {
	if len(k) == 0 {
		fail "empty key {k}"
	}
	return try find() wrap "loading {k}"
}

fn main() {
	let t secret str = "abc"
	let u = User{id: 1, token: t}
	say.Line(t)
	say.Line("token {t}")
	let s = say.Fmt("%s", u.token)
	say.Line(u)
	let f = say.Fault("bad key %s", t)
	if f != nil {
		herald.Info(t)
	}
	mut buf = []u8{}
	argo.Put(mut buf, u)
	panic(t)
	_ = s
}
