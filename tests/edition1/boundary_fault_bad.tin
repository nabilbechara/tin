package main

import "say"
import "tide"

fn bad() ! {
	fail "bad"
}

fn load(n i64) !i64 {
	return n
}

// A call that can fail as a boundary block's last expression is a statement like any other:
// its fault must be handled with try or catch, never dropped as the block's value (#233).
fn main() {
	within 50ms {
		within 10s {
			try tide.Wait(3s)
		}
	} catch err {
		say.Line("outer:", err)
	}
	guard {
		bad()
	} catch err {
		say.Line("guard:", err)
	}
	let v = limit memory 1mb {
		load(1)
	} catch _ {
		0
	}
	say.Line(v)
}
