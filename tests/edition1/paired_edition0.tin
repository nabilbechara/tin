package main

type Point struct {
	x i64
	y i64
}

const Bias i64 = 2
var seed i64 = 3

func sum(n i64) i64 {
	total := i64(0)
	for i := 0; i < n; i++ {
		total += i
	}
	return total
}

func total(xs []i64) i64 {
	total := i64(0)
	for _, value := range xs {
		total += value
	}
	return total
}

func totalWithIndex(xs []i64) i64 {
	total := i64(0)
	for index, value := range xs {
		total += index + value
	}
	return total
}

func stepped(n i64) i64 {
	total := i64(0)
	for i := 0; i < n; i += 2 {
		total += i
	}
	return total
}

func mapTotal(values map[str]i64) i64 {
	total := i64(0)
	for key, value := range values {
		total += value
		_ = key
	}
	return total
}

func choose(value ?str) i64 {
	if present := value; present != nil {
		return len(present)
	}
	return seed
}

func pointSum(x i64, y i64) i64 {
	point := Point{x: x, y: y}
	return point.x + point.y + Bias
}

func main() {
	_ = sum(10)
	values := []i64{1, 2}
	_ = total(values)
	_ = totalWithIndex(values)
	_ = stepped(10)
	lookup := map[str]i64{"one": 1}
	_ = mapTotal(lookup)
	_ = choose(nil)
	_ = pointSum(1, 2)
}
