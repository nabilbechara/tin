package main

import "say"

// A secret stays secret until reveal (#239): no plain parameter, variable or result takes
// one, comparing secrets needs seal.Equal, and secret qualifies values, not structs.

type User struct {
	id    i64
	token secret str
}

type Vault struct {
	owner secret User
}

fn plain(s str) i64 {
	return len(s)
}

fn leak(u User) str {
	return u.token
}

fn main() {
	let t secret str = "abc"
	let u = User{id: 1, token: t}
	let n = plain(t)
	let p str = t
	mut buf = []u8{}
	copy(buf, []u8(t))
	if t == "abc" {
		say.Line("equal")
	}
	if u.token < "b" {
		say.Line("before")
	}
	let lo = min(t, "b")
	let r = reveal(p)
	let w = reveal(u)
	let ids = map[secret str]i64{}
	_ = n
	_ = lo
	_ = r
	_ = w
	_ = ids
}
