package main

import "say"

type Node struct {
	name str
	next ?Node
}

type Handler struct {
	name str
	run fn(i64) i64
}

fn twice(x i64) i64 {
	return x * 2
}

// An arena block's value is copied out of it, so its type must be one a copy can follow (#236).
fn main() {
	let n = arena {
		Node{name: "a", next: nil}
	}
	let h = arena {
		Handler{name: "h", run: twice}
	}
	say.Line(n.name, h.name)
}
