var calls;

fn touch(v) {
    calls = calls + 1;
    return v;
}

fn main() {
    print_int(touch(0) && touch(1)); print_int(calls); println(""); // expect: 01
    print_int(touch(1) || touch(1)); print_int(calls); println(""); // expect: 12
    print_int(touch(1) && touch(5)); print_int(calls); println(""); // expect: 14
    print_int(touch(0) || touch(0)); print_int(calls); println(""); // expect: 06
    print_int(1 < 2 && 2 < 3 || 0); println("");                    // expect: 1
    return 0;
}
