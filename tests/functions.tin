fn fib(n) {
    if n < 2 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn is_even(n) {
    if n == 0 { return 1; }
    return is_odd(n - 1);
}

fn is_odd(n) {
    if n == 0 { return 0; }
    return is_even(n - 1);
}

fn eight(a, b, c, d, e, f, g, h) {
    return a - b + c - d + e - f + g * h;
}

fn nothing() {
}

fn main() {
    print_int(fib(20)); println("");                // expect: 6765
    print_int(is_even(10)); print_int(is_odd(7)); println(""); // expect: 11
    print_int(eight(1, 2, 3, 4, 5, 6, 7, 8)); println(""); // expect: 53
    print_int(nothing()); println("");               // expect: 0
    print_int(fib(fib(7))); println("");             // expect: 233
    return 0;
}
