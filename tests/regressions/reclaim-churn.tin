package main

import "say"
import "hearth"

// #176: replacing long-lived entries reclaims the old ones once the request ends.
type User struct {
	Name str
	Roles []str
}

let users = map[str]User{}
mut log []str

fn step(i i64) {
	users[keep("u{i % 50}")] = keep(User{Name: "name{i}", Roles: []str{"a{i}"}})
	log = append(log, keep("e{i}"))
	if len(log) > 100 {
		log = keep(log[50:])
	}
}

fn main() {
	for i in 0..20000 {
		step(i)
		hearth.Reset()
	}
	report()
}

fn report() {
	let (blocks, bytes, limbo) = hearth.RcStats()
	say.Line(len(users), users["u7"].Roles[0], len(log), blocks < 2000, bytes < 200000, limbo < 100)
}
