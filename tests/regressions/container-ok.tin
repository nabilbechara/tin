package main

import "say"

type Box struct {
	Items []str
	n     i64
}

type Page struct {
	box   Box
	lines []str
	title str
}

var gbox Box = Box{Items: []str{"g"}}
var gboxes []Box

func (p mut Page) Add(s str) {
	p.lines = append(p.lines, s)
}

func (p mut Page) Title(s str) {
	p.title = s
}

func swap(xs mut []Box) {
	t := xs[0]
	xs[0] = xs[1]
	xs[1] = t
}

func copied(xs []Box) []Box {
	out := []Box{}
	for _, x := range xs {
		out = append(out, x)
	}
	return out
}

// Fresh containers that hold long-lived or parameter objects may still take request memory
// themselves, and their parts that are fresh may too.
func render(b Box, who str) i64 {
	p := Page{box: b}
	p.Add(say.Fmt("hello %s", who))
	p.Title(who)
	xs := []Box{b, Box{}}
	swap(mut xs)
	xs = append(xs, Box{Items: []str{who}})
	return len(p.lines) + len(xs) + xs[0].n
}

func main() {
	gboxes = append(gboxes, keep(Box{n: 2}))
	who := say.Fmt("%s-%d", "w", 1)
	all := copied(gboxes)
	all = append(all, Box{Items: []str{who}})
	p := Page{box: gbox}
	p.Add(who)
	say.Line(render(gbox, who), len(all), all[0].n, p.lines[0], len(gbox.Items))
}
