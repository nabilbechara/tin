package main

import "say"
import "hearth"

// #176: appending a kept struct with counted fields to a global slice (it once jumped
// to an ungenerated rt_rc_unqueue), and keeping a map that is already long-lived (its
// tables must stay with it).
type Entry struct {
	Name str
	Tags []i64
	Attrs map[str]str
}

mut entries []Entry
let base = map[str]str{"k": "v"}
mut kept []map[str]str

fn step(i i64) {
	let e = Entry{Name: "n{i}", Tags: []i64{i, i + 1}, Attrs: map[str]str{"i": "{i}"}}
	entries = append(entries, keep(e))
	kept = append(kept, keep(base))
	if len(entries) > 10 {
		entries = keep(entries[1:])
	}
}

fn main() {
	for i in 0..200 {
		step(i)
		hearth.Reset()
	}
	say.Line(len(entries), entries[0].Name, entries[9].Tags[1], entries[9].Attrs["i"])
	say.Line(len(kept), kept[0]["k"], base["k"], len(base))
}
