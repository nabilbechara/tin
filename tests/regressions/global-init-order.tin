package main

import "stamp"

type Box struct{ n i64 }

// An imported package is initialized first: Crc32 reads stamp's tables.
var sum u32 = stamp.Crc32("hello")

var b Box = Box{n: 1}
var m map[str]i64 = make(map[str]i64)

func mk() Box {
	m["mk"] = b.n + 1
	return Box{n: m["mk"]}
}

// Earlier globals may be used directly, through a call, or through a function value.
var f func() Box = mk
var a Box = f()
var c Box = Box{n: mk().n + a.n + b.n}

func main() { println(sum, a.n, c.n, len(m)) }
