package main

import "stamp"

type Box struct{ n i64 }

// An imported package is initialized first: Crc32 reads stamp's tables.
let sum u32 = stamp.Crc32("hello")

let b Box = Box{n: 1}
let m map[str]i64 = make(map[str]i64)

fn mk() Box {
	m["mk"] = b.n + 1
	return Box{n: m["mk"]}
}

// Earlier globals may be used directly, through a call, or through a function value.
let f fn() Box = mk
let a Box = f()
let c Box = Box{n: mk().n + a.n + b.n}

fn main() { println(sum, a.n, c.n, len(m)) }
