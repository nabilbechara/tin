package main

type Box struct {
	vals []i64
	n    i64
}

fn last(s []i64) i64 { return s[len(s)-1] }

fn pick(i i64) i64 { return i + 1 }

fn seven(a i64, b i64, c i64, d i64, e i64, f i64, g i64) i64 {
	return a + b + c + d + e + f + g
}

fn lt(a f64, b f64) bool { return a < b }

fn main() {
	let s = []i64{11, 22, 33}
	println(last(s))
	println(1, 2, 3, 4, 5, 6, s[len(s)-1])
	println(seven(1, 2, 3, 4, 5, 6, s[len(s)-1]))
	// Indexes that are themselves element, field or call expressions.
	let ix = []i64{2, 0, 1}
	println(s[ix[0]], s[ix[ix[1]]], s[pick(ix[1])])
	let b = Box{vals: []i64{7, 8, 9}, n: 2}
	println(b.vals[b.n], b.vals[len(b.vals)-2])
	// Sized elements and strings.
	let h = []u16{100, 200, 300, 400}
	let w = []i32{-1, -2, -3}
	let bs = []u8{5, 6, 7, 8}
	let t = "hello"
	println(h[len(h)-1], w[len(w)-1], bs[len(bs)-1], t[len(t)-1], t[ix[ix[0]]])
	// Stores through nested indexes.
	s[len(s)-1] = 99
	s[ix[ix[0]]] += 5
	h[len(h)-2] = 7
	w[ix[2]] = 42
	bs[len(bs)-1] += bs[len(bs)-2]
	println(s[0], s[1], s[2], h[2], w[1], bs[3])
	let grid = [][]i64{[]i64{1, 2}, []i64{3, 4}}
	grid[len(grid)-1][len(grid[0])-1] = 40
	println(grid[len(grid)-1][len(grid)-1], grid[ix[2]][ix[1]])
	// A float comparison whose operand contains another comparison.
	let f = []f64{1.5, 2.5}
	println(lt(f[len(f)-2], f[len(f)-1]), f[len(f)-1] < f[ix[1]])
}
