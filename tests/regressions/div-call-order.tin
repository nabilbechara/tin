package main

// Arguments run left to right, so a / b panics before g() prints.
fn g() i64 {
	println("g ran")
	return 1
}

// Two statements keep add out of the inliner.
fn add(x i64, y i64) i64 {
	let s = x + y
	return s
}

fn run(a i64, b i64) i64 {
	return add(a / b, g())
}

fn main() {
	println(run(7, 0))
}
