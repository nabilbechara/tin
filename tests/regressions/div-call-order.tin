package main

// Arguments run left to right, so a / b panics before g() prints.
func g() i64 {
	println("g ran")
	return 1
}

// Two statements keep add out of the inliner.
func add(x i64, y i64) i64 {
	s := x + y
	return s
}

func run(a i64, b i64) i64 {
	return add(a / b, g())
}

func main() {
	println(run(7, 0))
}
