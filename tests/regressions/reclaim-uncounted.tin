package main

import "say"
import "hearth"

// #176: a block also held where it cannot be counted (a global's initial value, a store
// into an element's field) must outlive its counted references.
type Row struct {
	Name str
}

let names = []str{twice("ab")}
let cache = map[str]str{}
let rows = []Row{Row{Name: ""}}
mut pool []str

fn twice(s str) str {
	return s + s + s
}

fn step(i i64) {
	cache["k"] = names[0]
	delete(cache, "k")
	pool = append(pool, keep("x{i}"))
	rows[0].Name = pool[len(pool)-1]
	pool = keep(pool[:0])
}

fn main() {
	for i in 0..50 {
		step(i)
		hearth.Reset()
		hearth.Reset()
	}
	say.Line(names[0], rows[0].Name, len(pool))
}
