package main

import "say"

type Box struct {
	Items []str
}

type Holder struct {
	box Box
}

var gbox Box = Box{}

func grab(h mut Holder) {
	h.box = gbox
}

// A call through a function value may run grab.
func main() {
	f := grab
	h := Holder{box: Box{}}
	f(mut h)
	h.box.Items = append(h.box.Items, say.Fmt("%d", 1))
	say.Line(len(gbox.Items))
}
