package main
import "postgres"
import "say"
fn main() {
	let v = postgres.Value.Null
	say.Line("null", v.IsNull(), v.Int(), v.Float(), v.Text() == "")
	let i = postgres.Value.Int(-123)
	let f = postgres.Value.Float(1.5)
	let s = postgres.Value.Text("42")
	say.Line("values", i.Int(), i.Text(), f.Float(), s.Int(), s.Float(), s.IsNull())
	let r = postgres.Rows{Columns: []str{"id", "name"}}
	say.Line("columns", r.Col("name"), r.Col("missing"))
	let c = postgres.Client{}
	let e1 = c.Ping()
	let (_, e2) = c.Begin()
	let t = postgres.Tx{}
	let e3 = t.Commit()
	let e4 = t.Rollback()
	say.Line("zero", e1 != nil, e2 != nil, e3 != nil, e4 != nil)
}
