package main
import "postgres"
import "say"
func main() {
	v := postgres.Value.Null
	say.Line("null", v.IsNull(), v.Int(), v.Float(), v.Text() == "")
	i := postgres.Value.Int(-123)
	f := postgres.Value.Float(1.5)
	s := postgres.Value.Text("42")
	say.Line("values", i.Int(), i.Text(), f.Float(), s.Int(), s.Float(), s.IsNull())
	r := postgres.Rows{Columns: []str{"id", "name"}}
	say.Line("columns", r.Col("name"), r.Col("missing"))
	c := postgres.Client{}
	e1 := c.Ping()
	_, e2 := c.Begin()
	t := postgres.Tx{}
	e3 := t.Commit()
	e4 := t.Rollback()
	say.Line("zero", e1 != nil, e2 != nil, e3 != nil, e4 != nil)
}
