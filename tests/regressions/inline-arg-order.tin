package main

import "say"

// Inlined calls must still evaluate their arguments left to right, before the body.
type Box struct {
	X i64
}

func bump(b mut Box) i64 {
	b.X = b.X + 10
	return 0
}

func push(xs mut []i64) i64 {
	xs = append(xs, 7)
	return 0
}

func noisy() i64 {
	say.Line("noisy ran")
	return 0
}

func add(a i64, b i64) i64 {
	return a + b
}

// The body writes through b before it reads a.
func bumpThenAdd(a i64, b mut Box) i64 {
	return bump(mut b) + a
}

func main() {
	box := Box{X: 1}
	say.Line(add(box.X, bump(mut box)))
	xs := []i64{1, 2}
	say.Line(add(len(xs), push(mut xs)))
	c := Box{X: 1}
	say.Line(bumpThenAdd(c.X, mut c))
	x := 5
	y := 0
	say.Line(add(x / y, noisy()))
}
