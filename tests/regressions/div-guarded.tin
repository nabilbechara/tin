package main

// A guarded division must not run on the path that skips it: neither if-conversion
// nor loop-invariant code motion may compute it early.
func safeDiv(a i64, b i64) i64 {
	q := i64(0)
	if b != 0 {
		q = a / b
	}
	return q
}

func safeRem(a i64, b i64) i64 {
	q := i64(0)
	if b != 0 {
		q = a % b
	}
	return q
}

func avg(sum i64, count i64, xs []i64) i64 {
	r := i64(0)
	for _, x := range xs {
		r += x + sum / count
	}
	return r
}

func guardedSum(a i64, b i64, n i64) i64 {
	s := i64(0)
	for i := 0; i < n; i++ {
		if b != 0 {
			s += a % b + a / b
		}
	}
	return s
}

func main() {
	println(safeDiv(7, 0), safeRem(7, 0), avg(10, 0, []i64{}), guardedSum(10, 0, 3))
	println(safeDiv(7, 2), safeRem(7, 2), avg(10, 5, []i64{1, 2}), guardedSum(10, 3, 3))
}
