package main

import "say"
import "argo"
import "twine"

type T struct {
	name str
}

type Node struct {
	name str
	kids []Node
	next ?Node
}

func arrays(n i64) str {
	return twine.Repeat("[", n) + twine.Repeat("]", n)
}

func main() {
	// An unknown member is skipped: the outer object and 511 arrays are 512 levels.
	v := T{}
	say.Line(argo.Get(`{"x":`+arrays(511)+`,"name":"ok"}`, mut v), v.name)
	say.Line(argo.Get(`{"x":`+arrays(512)+`}`, mut v))
	say.Line(argo.Get(`{"x":`+arrays(300000)+`}`, mut v))
	// Closed arrays and objects stop counting: over 20000 of them, never more than 4 deep.
	say.Line(argo.Get(`{"x":[`+twine.Repeat(`[[]],{"a":{}},`, 5000)+`0],"name":"wide"}`, mut v), v.name)
	// A recursive type's decoders count the same levels.
	n := Node{}
	say.Line(argo.Get(twine.Repeat(`{"next":`, 511)+`{"name":"leaf"}`+twine.Repeat(`}`, 511), mut n))
	say.Line(argo.Get(twine.Repeat(`{"next":`, 512)+`{}`+twine.Repeat(`}`, 512), mut n))
	say.Line(argo.Get(twine.Repeat(`{"kids":[`, 256)+`{}`+twine.Repeat(`]}`, 256), mut n))
	say.Line(argo.Get(twine.Repeat(`{"kids":[`, 100000), mut n))
}
