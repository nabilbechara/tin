package main

import "say"

// mut lets a callee modify the contents of a struct, slice or map. An integer has no contents: it is
// passed by value, so this used to compile and print 0. It must be rejected.
fn bump(n mut i64) {
	n += 1
}

fn main() {
	let count = 0
	bump(mut count)
	bump(mut count)
	say.Line(count)
}
