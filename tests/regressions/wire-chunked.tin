package main

import "hearth"
import "mint"
import "relay"
import "say"
import "tide"
import "wire"

// body is the chunked body for path, as parts written 20 ms apart; the server closes after the last.
fn body(path str) []str {
	if path == "/valid-split" {
		return []str{"4\r", "\nwi", "ki\r", "\n5\r\npedia\r\n0\r\n", "\r\n"}
	}
	if path == "/extensions" {
		return []str{"5;name=val\r\nhello\r\n6 ; q=\"x y\"\r\n world\r\n0;end\r\nExpires: never\r\nX-Sum: 1\r\n\r\n"}
	}
	if path == "/leading-zeros" {
		return []str{"000A\r\n0123456789\r\n000\r\n\r\n"}
	}
	if path == "/not-hex" {
		return []str{"Z\r\ninvalid\r\n0\r\n\r\n"}
	}
	if path == "/empty-size" {
		return []str{"\r\nabc\r\n0\r\n\r\n"}
	}
	if path == "/negative" {
		return []str{"-1\r\nx\r\n0\r\n\r\n"}
	}
	if path == "/space-first" {
		return []str{" 5\r\nhello\r\n0\r\n\r\n"}
	}
	if path == "/junk-after-size" {
		return []str{"5x\r\nhello\r\n0\r\n\r\n"}
	}
	if path == "/control-in-ext" {
		return []str{"5;a\x01b\r\nhello\r\n0\r\n\r\n"}
	}
	if path == "/bare-lf" {
		return []str{"5\nhello\r\n0\r\n\r\n"}
	}
	if path == "/no-crlf-after-data" {
		return []str{"5\r\nhelloXY0\r\n\r\n"}
	}
	if path == "/overflow" {
		return []str{"10000000000000005\r\nhello\r\n0\r\n\r\n"}
	}
	if path == "/huge-truncated" {
		return []str{"7fffffffffff\r\nabc"}
	}
	if path == "/truncated-size" {
		return []str{"5"}
	}
	if path == "/truncated-data" {
		return []str{"5\r\nhel"}
	}
	if path == "/no-last-chunk" {
		return []str{"5\r\nhello\r\n"}
	}
	if path == "/no-final-crlf" {
		return []str{"5\r\nhello\r\n0\r\n"}
	}
	if path == "/bad-trailer" {
		return []str{"5\r\nhello\r\n0\r\nnot a field\r\n\r\n"}
	}
	return []str{"3\r\nbye\r\n0\r\n\r\n"}
}

// serve answers each request with a chunked response until it sees /stop.
fn serve(l wire.Listener) ! {
	for {
		let c = try l.Accept()
		let req = make([]u8, 0, 1024)
		for {
			let (_, err) = c.Read(mut req, 1024)
			if err != nil {
				fail err
			}
			let s = str(req)
			if len(s) >= 4 && s[len(s)-4:] == "\r\n\r\n" {
				break
			}
		}
		let s = str(req)
		mut sp = 4
		for sp < len(s) && s[sp] != ' ' {
			sp += 1
		}
		let path = s[4:sp]
		mut ok = c.Write("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n") == nil
		for _, part in body(path) {
			if !ok {
				break
			}
			tide.Sleep(20000000)
			ok = c.Write(part) == nil
		}
		c.Close()
		if path == "/stop" {
			return
		}
	}
}

fn show(err fault) str {
	if err == nil {
		return "nil"
	}
	return say.Str(err)
}

fn worker(id i64) {
	if id == 1 {
		let (l, err) = wire.Listen("127.0.0.1:0")
		if err != nil {
			say.Line("listen", err)
			return
		}
		relay.Send(0, mint.Itoa(l.Port()))
		let e2 = serve(l)
		if e2 != nil {
			say.Line("serve error", e2)
		}
		l.Close()
		return
	}
	let (_, port) = relay.Recv()
	let base = "http://127.0.0.1:" + port
	let paths = []str{"/valid-split", "/extensions", "/leading-zeros", "/not-hex", "/empty-size", "/negative", "/space-first",
		"/junk-after-size", "/control-in-ext", "/bare-lf", "/no-crlf-after-data", "/overflow", "/huge-truncated",
		"/truncated-size", "/truncated-data", "/no-last-chunk", "/no-final-crlf", "/bad-trailer", "/stop"}
	for _, p in paths {
		let (r, err) = wire.Get(base + p)
		say.Line(p, r.Status, say.Fmt("%q", r.Body), show(err))
	}
}

fn main() {
	hearth.Run(2, worker)
}
