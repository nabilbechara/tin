package main

import "anvil"
import "fault"
import "mint"
import "twine"

// A checkout total (#242, saved by tin replay --save-test): the body holds "price qty" lines.
// The recorded request ended in a 500: a blank line was read as a line with two fields and the
// handler indexed past its end. Blank lines are skipped now, so the replay answers 200.

func total(body str) !i64 {
	sum := 0
	for _, line := range twine.Split(body, "\n") {
		f := twine.Fields(line)
		if len(f) == 0 {
			continue
		}
		if len(f) != 2 {
			fail "bad line: " + line
		}
		price := try mint.Atoi(f[0])
		qty := try mint.Atoi(f[1])
		sum += price * qty
	}
	return sum
}

func checkout(q anvil.Req, w mut anvil.Out) {
	sum := total(q.Body()) catch err {
		w.Status(400)
		w.Text(fault.Message(err) + "\n")
		return
	}
	w.Text("total {sum}\n")
}

func main() {
	r := anvil.NewRouter()
	r.Post("/checkout", checkout)
	err := r.Serve(":8080")
	if err != nil {
		panic(fault.Message(err))
	}
}
