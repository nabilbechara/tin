package main

import "say"

type Box struct {
	Items []str
}

var gbox Box = Box{}

func add(xs mut []Box, s str) {
	xs[0].Items = append(xs[0].Items, s)
}

// xs is fresh, but add stores into the global's Box inside it.
func main() {
	xs := []Box{gbox}
	add(mut xs, say.Fmt("%d", 1))
	say.Line(len(gbox.Items))
}
