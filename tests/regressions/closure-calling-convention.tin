package main

import "say"

fn apply(f fn(i64) i64, x i64) i64 {
	return f(x)
}

fn double(x i64) i64 {
	return x * 2
}

fn addTen(x i64) i64 {
	return x + 10
}

fn main() {
	mut f fn(i64) i64 = double
	say.Line(apply(f, 21))
	f = addTen
	say.Line(apply(f, 32))
	say.Line(apply(fn(x i64) i64 { return x * x }, 9))
}
