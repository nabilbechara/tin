package main

import "hearth"
import "say"

// #176: a value stored through a parameter is pinned. When it is the first object of a
// request pool, it starts at the pool chunk's own heap payload; pinning it must not turn
// the chunk into a counted long-lived block.
type Holder struct {
	xs []i64
}

fn put(h mut Holder, xs []i64) {
	h.xs = xs
}

fn step() {
	let xs = make([]i64, 0, 4)
	let h = Holder{xs: xs}
	put(mut h, xs)
}

fn main() {
	for i in 0..1000 {
		hearth.Reset()
		step()
	}
	let (blocks, bytes, limbo) = hearth.RcStats()
	say.Line(blocks, bytes, limbo)
}
