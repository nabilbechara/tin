package main

import "say"
import "sift"

fn makeCounter() fn() i64 {
	mut n = 0
	return fn() i64 {
		n += 1
		return n
	}
}

fn main() {
	let xs = []i64{1, 2, 3, 4, 5}
	mut total = 0
	sift.Each(xs, fn(x i64) {
		total += x
	})
	say.Line("total:", total)

	let c = makeCounter()
	say.Line("c:", c())
	say.Line("c:", c())
}
