const LIMIT = 3;
const TWICE = LIMIT * 2;
var counter;
var start = -TWICE;

fn bump() {
    counter = counter + 1;
    return counter;
}

fn set(p, v) {
    p[0] = v;
}

fn main() {
    bump(); bump();
    print_int(bump()); println("");   // expect: 3
    print_int(start); println("");    // expect: -6
    set(&counter, 40);
    print_int(counter + 2); println(""); // expect: 42
    let LIMIT = 100;
    print_int(LIMIT + TWICE); println(""); // expect: 106
    return 0;
}
