package main

import "flume"
import "say"
import "wire"

// #96: a struct literal cannot set private fields of another package (edition 1 literals name
// every field, so this is the keyed form of the old positional case).
fn main() {
	let w = flume.Writer{open: true, fd: 2, buf: []u8{}, err: nil}
	let r = wire.Resp{Status: 200, Body: "body", head: "forged head"}
	let ok = wire.Resp{Status: 200, Body: "fine"}
	_ = w
	say.Line(r.Status, ok.Status)
}
