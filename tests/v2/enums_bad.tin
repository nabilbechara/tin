package main

import "say"

type Shape enum {
	Circle(r f64)
	Rect(w, h f64)
	Tagged(tags []str)
	Empty
}


fn f(s Shape) {
	match s {
		Circle(r) => {
			say.Line(r)
		}
		Rect(w) => {
			say.Line(w)
		}
	}
	match s {
		Square(x) => {
			say.Line(x)
		}
		_ => {
		}
	}
	say.Line(s.r)
	let a = Shape.Oval(1)
	let b = Shape.Circle(1, 2)
	let c = Shape{r: 1}
	say.Line(a, b, c, s == Shape.Empty)
}

fn main() {
	f(Shape.Empty)
}
