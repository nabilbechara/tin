package main

import "say"
import "gauge"

func main() {
	hits := 0
	for i := 0; i < 1000; i++ {
		if i%2 == 0 {
			hits++
		}
	}
	edge := i64(9223372036854775807)
	if edge > 0 {
		edge++
	}
	nan := gauge.NaN()
	equal := 0
	if nan == nan {
		equal++
	}
	unequal := 0
	if nan != nan {
		unequal++
	}
	say.Line(hits, edge, equal, unequal)
}
