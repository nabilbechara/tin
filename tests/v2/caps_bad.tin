package main

// netpeek's tin.mod grants files, not net: its call to wire.Dial and its package-level
// function value wire.Dial are compile errors at those sites, with the path to the entry point.
import "example.com/netpeek"
import "say"

func main() {
	say.Line(netpeek.Reachable("127.0.0.1:1"))
}
