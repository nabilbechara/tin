package main

import "hearth"
import "say"

// #179: request memory read after hearth.Reset() freed it.

fn mk(n i64) str {
	return "fresh-{n}"
}

fn direct() {
	let s = mk(1)
	hearth.Reset()
	say.Line(s)
}

fn wraps() {
	let s = mk(2)
	for i in 0..3 {
		say.Line(s)
		hearth.Reset()
	}
}

fn cleanup() {
	hearth.Reset()
}

fn helper() {
	let xs = []str{mk(3)}
	cleanup()
	say.Line(len(xs))
}

fn branch(c bool) {
	let s = mk(4)
	if c {
		hearth.Reset()
	}
	say.Line(s)
}

fn main() {
	direct()
	wraps()
	helper()
	branch(true)
}
