package main

import "say"
import "glyph"

const big = 0xffffffffffffffff
const half = big >> 1
const k11 = big >> 11

func main() {
	ss := make([]str, 3)
	ss[1] = "b"
	say.Line(len(ss[0]), ss[0] == "", ss)
	grid := make([][]i64, 2)
	grid[1] = append(grid[1], 7)
	say.Line(len(grid[0]), grid[1])
	var v u64 = big
	a := u64(0xffffffffffffffff) >> 11
	say.Line(a, v>>11, u64(k11), u64(half), u64(big)/10, big > 1)
	var x u8 = 200
	y := u8(100) + u8(100)
	say.Line(x+100, y)
	var r i32 = 0xfffd
	say.Line(r == glyph.RuneError)
}
