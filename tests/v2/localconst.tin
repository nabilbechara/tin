package main
import "say"

const limit = 7

func other() i64 {
    const limit = 30
    return limit
}

func identity[T any](value T) T {
    const rounds = 2
    for i := 0; i < rounds; i++ {
        const step = 1
        if step != 1 { panic("bad constant") }
    }
    return value
}

func main() {
    before := 10
    const count = 1 << 2
    const byteValue u8 = 255
    const message = "local"
    const alias = message
    const enabled bool = true
    const scale f32 = 1.25
    const wide u64 = 18446744073709551615
    const _ = 1
    const _ = 2
    after := before + count
    say.Line("values", after, byteValue, alias, enabled, scale, wide)
    const limit = limit + 1
    say.Line("shadow", limit)
    {
        const limit = limit + 1
        say.Line("nested", limit)
    }
    say.Line("outer", limit, other())
    const x, y = 10, 20
    {
        const x, y = y, x
        say.Line("parallel", x, y)
    }
    const (
        a, b u8 = iota, iota + 10
        c, d
        e = c + d
    )
    say.Line("group", a, b, c, d, e)
    var numbers [count]i64
    numbers[3] = 9
    say.Line("array", len(numbers), numbers[3])
    say.Line("generic", identity(42), identity("yes"))
    f := func() i64 { const answer = 42; return answer }
    say.Line("literal", f())
    for i := 0; i < 2; i++ {
        const value = 3
        say.Line("loop", i + value)
    }
}
