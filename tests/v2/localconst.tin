package main

import "constraints"
import "say"

// Edition 1 declares constants at package level only (a local const is E090): these are the
// constants this test once declared inside functions, with the values they had there.
const limit_ = 7

const otherLimit = 30

fn other() i64 {
	return otherLimit
}

const rounds = 2

const step = 1

fn identity[T constraints.Any](value T) T {
	for i in 0..rounds {
		if step != 1 {
			panic("bad constant")
		}
	}
	return value
}

const count = 1 << 2

const byteValue u8 = 255

const message = "local"

const alias = message

const enabled bool = true

const scale f32 = 1.25

const wide u64 = 18446744073709551615

const shadow = limit_ + 1

const nested = shadow + 1

const x = 10

const y = 20

const swappedX = y

const swappedY = x

const a u8 = 0

const b u8 = 10

const c u8 = 1

const d u8 = 11

const e = c + d

const answer = 42

const value = 3

fn main() {
	let before = 10
	let after = before + count
	say.Line("values", after, byteValue, alias, enabled, scale, wide)
	say.Line("shadow", shadow)
	{
		say.Line("nested", nested)
	}
	say.Line("outer", shadow, other())
	{
		say.Line("parallel", swappedX, swappedY)
	}
	say.Line("group", a, b, c, d, e)
	mut numbers [count]i64
	numbers[3] = 9
	say.Line("array", len(numbers), numbers[3])
	say.Line("generic", identity(42), identity("yes"))
	let f = fn() i64 { return answer }
	say.Line("literal", f())
	for i in 0..2 {
		say.Line("loop", i + value)
	}
}
