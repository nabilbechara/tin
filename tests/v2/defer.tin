package main

import "say"

var log []str

func note(s str) {
	log = append(log, keep(s))
}

func work(n i64) (i64, fault) {
	defer note("first")
	if n < 0 {
		return 0, fail("negative")
	}
	defer note(say.Fmt("second %d", n))
	if n == 0 {
		return -1, nil
	}
	x := n * 2
	defer note("third")
	return x, nil
}

func parse(s str) (i64, fault) {
	defer note("parse done")
	if s == "" {
		return 0, fail("empty")
	}
	return len(s), nil
}

func chain(s str) (i64, fault) {
	defer note("chain done")
	v := try parse(s)
	return v + 1, nil
}

func plain() {
	defer note("plain end")
	note("plain body")
}

func main() {
	a, e1 := work(5)
	say.Line(a, e1 == nil, log)
	log = keep([]str{})
	b, e2 := work(0)
	say.Line(b, e2 == nil, log)
	log = keep([]str{})
	_, e3 := work(-1)
	say.Line(e3, log)
	log = keep([]str{})
	_, e4 := chain("")
	say.Line(e4, log)
	log = keep([]str{})
	plain()
	say.Line(log)
}
