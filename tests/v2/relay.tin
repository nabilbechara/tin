package main

import "say"
import "hearth"
import "relay"

const rounds = 20000

func worker(id i64) {
	if id == 0 {
		for c := 1; c < 4; c++ {
			for i := 0; i < rounds; i++ {
				relay.Send(c, say.Fmt("%d", i))
			}
		}
		total := 0
		sum := 0
		for total < 3*rounds {
			_, msg := relay.Recv()
			sum += len(msg)
			total++
		}
		say.Line("core 0 got", total, "replies, bytes", sum)
		for c := 1; c < 4; c++ {
			relay.Send(c, "stop")
		}
		return
	}
	n := 0
	for {
		from, msg := relay.Recv()
		if msg == "stop" {
			break
		}
		relay.Send(from, say.Fmt("%d:%s", id, msg))
		n++
	}
	say.Line("core", id, "echoed", n)
}

func main() {
	hearth.Run(4, worker)
}
