package main

import "fault"
import "say"

var ErrA = fault("a")
var ErrB = fault(3)
var ErrC = fault("a", "b")

func f() !i64 {
	e := fault("inside a function")
	fail e
}

func g(err fault) str {
	switch err {
	case "a":
		return "text"
	}
	return "none"
}

func main() {
	say.Line(ErrA, ErrB, ErrC, g(ErrA))
}
