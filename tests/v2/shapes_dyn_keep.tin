package main

import "hearth"
import "io"
import "say"

type Buf struct { n i64 }

fn (b Buf) Write(data []u8) !i64 {
	return len(data) + b.n
}

fn Keep(w dyn io.Writer) dyn io.Writer {
	return keep(w)
}

fn Write(w dyn io.Writer) !i64 {
	return try w.Write([]u8{1, 2})
}

fn main() {
	mut w dyn io.Writer = Buf{n: 5}
	w = Keep(w)
	hearth.Reset()
	let n = Write(w) catch _ { -1 }
	say.Line("write: {n}")
}
