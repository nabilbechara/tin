package main

import "hearth"
import "io"
import "say"

type Buf struct { n i64 }

func (b Buf) Write(data []u8) !i64 {
	return len(data) + b.n
}

func Keep(w dyn io.Writer) dyn io.Writer {
	return keep(w)
}

func Write(w dyn io.Writer) !i64 {
	return try w.Write([]u8{1, 2})
}

func main() {
	var w dyn io.Writer = Buf{n: 5}
	w = Keep(w)
	hearth.Reset()
	n := Write(w) catch _ { -1 }
	say.Line("write: {n}")
}
