package main

import "say"
import "lever"

// dump prints each line of s quoted after tag, so tabs and indentation are visible.
func dump(tag str, s str) {
	start := 0
	for i := 0; i < len(s); i++ {
		if s[i] == '\n' {
			say.Line(tag, say.Fmt("%q", s[start:i]))
			start = i + 1
		}
	}
}

func main() {
	// A: every kind, every syntax, "--" terminator.
	name := lever.Str("name", "world", "who to greet")
	n := lever.Int("n", 1, "repeat `count`")
	v := lever.Bool("v", false, "verbose")
	ratio := lever.F64("ratio", 0.5, "mix ratio")
	say.Line("A before", name.Given(), lever.Parsed(), lever.Rest(), name.Val(), n.Val(), v.Val(), ratio.Val())
	err := lever.Parse([]str{"-name=tin", "-n", "0x10", "-v", "--ratio", "1e3", "--", "-x", "rest"})
	say.Line("A parse", err, name.Val(), n.Val(), v.Val(), ratio.Val(), lever.Rest(), lever.Parsed())
	say.Line("A given", name.Given(), n.Given(), v.Given(), ratio.Given())
	dump("A usage", lever.Usage())

	// B: booleans.
	lever.Reset()
	v = lever.Bool("v", false, "verbose")
	x := lever.Bool("xray", true, "long bool name")
	say.Line("B defaults", v.Val(), x.Val())
	say.Line("B false", lever.Parse([]str{"-v=false", "-xray=0"}), v.Val(), x.Val())
	say.Line("B true", lever.Parse([]str{"-v=1", "--xray", "pos"}), v.Val(), x.Val(), lever.Rest())
	bools := []str{"T", "t", "TRUE", "True", "true", "F", "f", "FALSE", "False", "false", "0", "1", "maybe", "tRuE", "", "2", "yes"}
	for _, b := range bools {
		say.Line("B value", say.Fmt("%q", b), lever.Parse([]str{"-v=" + b}), v.Val())
	}
	say.Line("B next arg", lever.Parse([]str{"-v", "false"}), v.Val(), lever.Rest())
	dump("B usage", lever.Usage())

	// C: integers.
	lever.Reset()
	k := lever.Int("k", -5, "an int")
	ints := []str{"010", "0b101", "0o17", "-0x1F", "0X1f", "0B11", "0O7", "1_000", "1__0", "_1", "1_", "0x_f", "0x_", "9223372036854775807", "9223372036854775808", "-9223372036854775808", "-9223372036854775809", "", "+5", "-", "+", "0x", "08", "0", "00", "-0", "0o", "0b2", " 1", "1 ", "1.0", "99999999999999999999x", "0b1111111111111111111111111111111111111111111111111111111111111111", "0x7fffffffffffffff", "0x8000000000000000", "-0x8000000000000000", "0_7", "0x1_f", "+-1", "--1", "1e3", "٣"}
	for _, s := range ints {
		say.Line("C value", say.Fmt("%q", s), lever.Parse([]str{"-k=" + s}), k.Val())
	}
	say.Line("C next arg", lever.Parse([]str{"-k", "-7"}), k.Val(), lever.Rest())
	say.Line("C twice", lever.Parse([]str{"-k", "1", "-k", "2"}), k.Val())
	say.Line("C stops", lever.Parse([]str{"-k", "abc", "-k", "9"}), k.Val())
	dump("C usage", lever.Usage())

	// D: floats.
	lever.Reset()
	f := lever.F64("f", 0.25, "a float")
	floats := []str{"1.5", ".5", "5.", "1e-3", "1E3", "inf", "-Infinity", "+inf", "Inf", "nan", "NaN", "-nan", "+nan", "1e400", "-1e400", "1e-400", "0x1p-2", "0x1", "0x1.8p1", "0x.8p1", "0x1P+3", "1_000.5", "1__0.5", "abc", "1e", "1e+", "", "+", "-", ".", "infx", "infinit", "infinityx", "1.2.3", "0x1p", "0xp1", "1e1_0", "-0", "00012", "4.9e-324", "1.7976931348623157e308", "1.7976931348623158e308", "1.7976931348623159e308", "123456789012345678901234567890", "0.1", "1e21", "1e20", "100000000000000000000", "-1.5e-7", "1_e3", "1e_3", " 1", "1 ", "0x", "0x.p1"}
	for _, s := range floats {
		say.Line("D value", say.Fmt("%q", s), lever.Parse([]str{"-f=" + s}), f.Val())
	}
	say.Line("D next arg", lever.Parse([]str{"-f", "-2.5", "tail"}), f.Val(), lever.Rest())
	dump("D usage", lever.Usage())

	// E: strings, termination, errors, Set.
	lever.Reset()
	s := lever.Str("s", "", "a string")
	t := lever.Str("t", "dflt", "another")
	say.Line("E dash value", lever.Parse([]str{"-s", "-foo", "-t="}), say.Fmt("%q %q", s.Val(), t.Val()))
	say.Line("E empty value", lever.Parse([]str{"-s", ""}), say.Fmt("%q", s.Val()))
	say.Line("E stops at arg", lever.Parse([]str{"a", "-s=x"}), say.Fmt("%q", s.Val()), lever.Rest())
	say.Line("E lone dash", lever.Parse([]str{"-", "-s=x"}), lever.Rest())
	say.Line("E terminator only", lever.Parse([]str{"--"}), lever.Rest())
	say.Line("E terminator twice", lever.Parse([]str{"-s=1", "--", "--", "-t=2"}), say.Fmt("%q %q", s.Val(), t.Val()), lever.Rest())
	say.Line("E no args", lever.Parse([]str{}), lever.Rest())
	say.Line("E equals in value", lever.Parse([]str{"-s=a=b=c"}), s.Val())
	say.Line("E double dash", lever.Parse([]str{"--s=dd", "--t", "tt"}), s.Val(), t.Val())
	say.Line("E needs arg", lever.Parse([]str{"-s"}))
	say.Line("E needs arg after", lever.Parse([]str{"-t=ok", "-s"}), t.Val())
	say.Line("E unknown", lever.Parse([]str{"-zz"}), lever.Parse([]str{"--zz=1"}), lever.Parse([]str{"-s=1", "-q", "2"}))
	say.Line("E help", lever.Parse([]str{"-h"}), lever.Parse([]str{"--help"}), lever.Parse([]str{"-help"}), lever.Parse([]str{"-help=1"}), lever.Parse([]str{"-h", "x"}))
	say.Line("E syntax", lever.Parse([]str{"---x"}), lever.Parse([]str{"-=x"}), lever.Parse([]str{"--=x"}), lever.Parse([]str{"-s=1", "---"}))
	say.Line("E repeat", lever.Parse([]str{"-t", "x", "-t", "y"}), t.Val())
	say.Line("E unicode", lever.Parse([]str{"-s=é", "-t=日本", "ü"}), s.Val(), t.Val(), lever.Rest())
	say.Line("E set", lever.Set("t", "set!"), t.Val(), lever.Set("nope", "1"))
	dump("E usage", lever.Usage())

	// F: usage formatting.
	lever.Reset()
	lever.Str("empty", "", "no default shown")
	lever.Str("q", "a\"b\\c", "quoted default")
	lever.Int("zero", 0, "int zero")
	lever.Int("neg", -5, "negative\nsecond line")
	lever.F64("big", 1e21, "huge")
	lever.F64("two", 2.0, "two")
	lever.F64("fz", 0, "float zero")
	lever.F64("small", 0.000001, "tiny")
	lever.Bool("b", true, "bool default true")
	lever.Bool("longbool", false, "a long bool")
	lever.Str("nm", "x", "name is `FILE` here")
	lever.Int("i", 3, "`N` items")
	lever.Str("odd", "", "one `tick only")
	lever.Str("Z", "z", "upper sorts first")
	dump("F usage", lever.Usage())
	say.Line("F rest before parse", lever.Rest(), lever.Parsed())
}
