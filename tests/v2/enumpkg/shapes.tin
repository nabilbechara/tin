// Package enumpkg holds an enum used from another package by tests/v2/enums_pkg.tin.
package enumpkg

// Token is a lexer token.
type Token enum {
	Num(v i64)
	Word(text str)
	End
}

// Lex splits s on spaces into tokens.
fn Lex(s str) []Token {
	mut out = []Token{}
	mut start = 0
	{
		mut i = 0
		for i <= len(s) {
			if i == len(s) || s[i] == ' ' {
				if i > start {
					out = append(out, classify(s[start:i]))
				}
				start = i + 1
			}
			i += 1
		}
	}
	return append(out, Token.End)
}

fn classify(w str) Token {
	mut n = 0
	for i in 0..len(w) {
		if w[i] < '0' || w[i] > '9' {
			return Token.Word(w)
		}
		n = n*10 + i64(w[i]-'0')
	}
	return Token.Num(n)
}
