package main

import "say"

type Node struct {
	v i64
	l ?Node
	r ?Node
}

func check(n Node) i64 {
	l := n.l
	r := n.r
	if l == nil || r == nil {
		return 1
	}
	return 1 + check(l) + check(r)
}

func both(a ?Node, b ?Node) i64 {
	if a != nil && b != nil {
		return a.v + b.v
	}
	return -1
}

func bytesOf(n i64) []u8 {
	b := make([]u8, 0, 8)
	for i := 0; i < n; i++ {
		b = append(b, 'x')
	}
	return b
}

func main() {
	leaf := Node{v: 1}
	t := Node{v: 2, l: leaf, r: Node{v: 3, l: leaf, r: leaf}}
	say.Line(check(t), both(leaf, leaf), both(leaf, nil))
	say.Line("len", len(bytesOf(3)))
	var big u64 = 18446744073709551615
	var h u64 = 0xcbf29ce484222325
	say.Line(big, h, big/2+1)
}
