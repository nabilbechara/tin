package main

import "say"
import "hearth"

mut seen i64

fn work(id i64) {
	seen = id + 100
	say.Line("core", id, "sees", seen, "id", hearth.ID() == id)
}

fn main() {
	let n = hearth.Cores()
	say.Line("cores at least 1", n >= 1)
	say.Line("cores at most 1024", n <= 1024)
	say.Line("memlimit not negative", hearth.MemLimit() >= 0)
	let limited = hearth.MemLimit() > 0 && hearth.PoolChunk() >= 65536 && hearth.PoolChunk() < 4194304
	say.Line("poolchunk default or limited", hearth.PoolChunk() == 4194304 || limited)
	say.Line("poolchunk multiple of 64K", hearth.PoolChunk()%65536 == 0)
	hearth.Run(3, work)
	say.Line("main after run", seen, hearth.ID())
}
