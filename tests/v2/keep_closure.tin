package main

import "hearth"
import "say"

// keep() on a closure copies what it captured, deeply (#170): after the request pool is reset
// and reused, the kept closures still see their own values.

type Holder struct {
	f fn() str
}

mut greet fn() str = fn() str { return "none" }
mut held []Holder = []Holder{}
let byName map[str]fn() str = make(map[str]fn() str)
mut counter fn() i64 = fn() i64 { return 0 }

fn remember(q str) {
	let name = "user-" + q
	let parts = []str{"a-" + q, "b-" + q}
	greet = keep(fn() str { return name + " " + parts[1] })
	held = append(held, keep(Holder{f: fn() str { return "held " + name }}))
	byName["x"] = keep(fn() str { return "mapped " + parts[0] })
	mut n = 40
	counter = keep(fn() i64 {
		n += 1
		return n
	})
}

fn clobber() {
	for i in 0..200 {
		let x = say.Fmt("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX%d", i)
		if len(x) == 0 {
			say.Line("never")
		}
	}
}

fn main() {
	remember(say.Fmt("alice-%d", 42))
	hearth.Reset()
	clobber()
	say.Line("greet", greet())
	say.Line("struct", held[0].f())
	say.Line("map", byName["x"]())
	counter()
	say.Line("counter", counter())
}
