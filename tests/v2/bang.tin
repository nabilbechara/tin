package main

import "say"
import "mint"

type P struct {
	x i64
	tags []str
}

fn port(text str) !i64 {
	let n = try mint.Atoi(text)
	if n < 1 || n > 65535 {
		fail say.Fmt("port %d out of range", n)
	}
	return n
}

fn check(n i64) ! {
	if n < 0 {
		fail "negative"
	}
}

fn pair(a str) !(str, i64) {
	if a == "" {
		fail "empty"
	}
	return a, len(a)
}

fn mkp(ok bool) !P {
	if !ok {
		fail "no"
	}
	return P{x: 1, tags: []str{"a"}}
}

fn orzero(t str) i64 {
	return port(t) catch _ { 0 }
}

fn main() {
	let p = port("80") catch _ { 8080 }
	let q = port("99999") catch err {
		say.Line("err:", err)
		7
	}
	mut r i64 = port("x") catch _ { -1 }
	r = port("443") catch _ { -2 }
	say.Line(p, q, r, orzero("nope"), orzero("22"))
	check(-1) catch err {
		say.Line("check:", err)
	}
	let e = check(5)
	say.Line("check ok:", e == nil)
	let (a, n) = pair("hey") catch _ {
		return
	}
	say.Line(a, n)
	for _, s in []str{"", "z"} {
		let (b, m) = pair(s) catch err {
			say.Line("pair:", err)
			continue
		}
		say.Line(b, m)
	}
	let (v, err) = mkp(false)
	say.Line(v.x, len(v.tags), err)
	let w = mkp(true) catch _ { P{x: 9, tags: []str{}} }
	say.Line(w.x, w.tags)
}
