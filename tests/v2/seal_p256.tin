package main

import "say"
import "seal"

func hx(s str) []u8 {
	b, err := seal.HexDecode(s)
	if err != nil {
		panic("bad hex")
	}
	return b
}

func small(v i64) []u8 {
	k := make([]u8, 32)
	k[31] = u8(v)
	return k
}

func pub(k []u8) str {
	p := seal.P256PublicKey(k) catch _ {
		return "fault"
	}
	return seal.Hex(p)
}

func shared(k []u8, peer []u8) str {
	s := seal.P256ECDH(k, peer) catch _ {
		return "fault"
	}
	return seal.Hex(s)
}

func cat(a []u8, b []u8) []u8 {
	out := make([]u8, 0, len(a)+len(b))
	out = append(out, a...)
	out = append(out, b...)
	return out
}

func main() {
	n := hx("ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551")
	n1 := hx("ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632550")
	n2 := hx("ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc63254f")
	np1 := hx("ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632552")
	ks := [][]u8{small(1), small(2), small(15), small(16), small(255), n1, n2, hx("c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721")}
	for i, k := range ks {
		say.Line("pub", i, pub(k))
	}
	bad := [][]u8{make([]u8, 32), n, np1, hx("ff"), make([]u8, 33)}
	for i, k := range bad {
		say.Line("badpriv", i, pub(k))
	}
	a := hx("0612465c89a023ab17855b0a6bcebfd3febb53aef84138647b5352e02c10c346")
	b := hx("7d7dc5f71eb29ddaf80d6214632eeae03d9058af1fb6d22ed80badb62bc1a534")
	pa := hx(pub(a))
	pb := hx(pub(b))
	say.Line("ecdh", shared(a, pb), shared(b, pa))
	comp := cat([]u8{2 + pb[64]&1}, pb[1:33])
	flip := cat([]u8{3 - pb[64]&1}, pb[1:33])
	say.Line("compressed", shared(a, comp), shared(a, flip) != shared(a, pb))
	notOn := cat([]u8{}, pb)
	notOn[64] ^= 1
	big1 := make([]u8, 65)
	big1[0] = 4
	for i := 1; i < 33; i++ {
		big1[i] = 0xff
	}
	peers := [][]u8{notOn, big1, pb[:64], cat([]u8{5}, pb[1:]), []u8{}, []u8{0}, cat([]u8{2}, make([]u8, 32))}
	for i, p := range peers {
		say.Line("badpeer", i, shared(a, p))
	}
	// Fresh keys agree with each other.
	x := seal.P256NewPrivateKey()
	y := seal.P256NewPrivateKey()
	px := hx(pub(x))
	py := hx(pub(y))
	say.Line("fresh", shared(x, py) == shared(y, px), len(px))
}
