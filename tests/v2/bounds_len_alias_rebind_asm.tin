package main

fn sum_rebind_len(xs []i64) i64 {
	mut n = len(xs)
	n = 0
	mut total = i64(0)
	for i in i64(0)..n {
		total += xs[i]
	}
	return total
}

fn sum_rebind_slice(xs []i64) i64 {
	let n = len(xs)
	xs = xs[:0]
	mut total = i64(0)
	for i in i64(0)..n {
		total += xs[i]
	}
	return total
}

fn main() {
	let xs = []i64{}
	sum_rebind_len(xs)
	sum_rebind_slice(xs)
}
