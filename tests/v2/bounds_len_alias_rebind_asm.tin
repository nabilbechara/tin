package main

func sum_rebind_len(xs []i64) i64 {
	n := len(xs)
	n = 0
	total := i64(0)
	for i := i64(0); i < n; i++ {
		total += xs[i]
	}
	return total
}

func sum_rebind_slice(xs []i64) i64 {
	n := len(xs)
	xs = xs[:0]
	total := i64(0)
	for i := i64(0); i < n; i++ {
		total += xs[i]
	}
	return total
}

func main() {
	xs := []i64{}
	sum_rebind_len(xs)
	sum_rebind_slice(xs)
}
