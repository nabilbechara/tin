package main

import "say"
import "atlas"
import "sift"

type Color enum { Red, Green, Blue }

type Shape enum {
	Circle(r f64)
	Rect(w, h f64)
}

type Point struct {
	X i64
	Y i64
	Tag str
}

fn double(x i64) i64 {
	return 2 * x
}

fn even(x i64) bool {
	return x%2 == 0
}

fn add(a i64, x i64) i64 {
	return a + x
}

fn label(x i64) str {
	return "n{x}"
}

fn main() {
	let m = map[str]i64{"z": 1, "a": 2, "m": 3}
	m["b"] = 4
	delete(m, "a")
	m["a"] = 5
	m["z"] = 9
	mut order = []str{}
	for k, v in m {
		order = append(order, "{k}={v}")
	}
	say.Line(order)
	say.Line(atlas.Keys(m), atlas.Values(m), atlas.SortedKeys(m))
	let ints = map[i64]str{}
	{
		mut i = 10
		for i > 0 {
			ints[i*7%11] = "v{i}"
			i -= 1
		}
	}
	delete(ints, 3)
	say.Line(atlas.Keys(ints))
	say.Line(atlas.SortedKeys(ints))
	let b = map[bool]str{true: "yes", false: "no"}
	let f = map[f64]i64{0.5: 1, -2.25: 2}
	say.Line(b[true], b[false], f[0.5], f[-2.25], len(f))
	let c = map[Color]i64{}
	c[Color.Blue] = 3
	c[Color.Red] = 1
	c[Color.Blue] += 10
	say.Line(c, len(c), c[Color.Blue], c[Color.Green])
	let p = map[Point]str{}
	let k1 = Point{X: 1, Y: 2, Tag: "a"}
	p[k1] = "first"
	k1.X = 99
	p[Point{X: 1, Y: 2, Tag: "a"}] = "again"
	p[Point{X: 3, Y: 4, Tag: "b"}] = "second"
	let (v, ok) = p[Point{X: 1, Y: 2, Tag: "a"}]
	let (_, ok2) = p[k1]
	say.Line(len(p), v, ok, ok2)
	for pk, pv in p {
		say.Line(pk.X, pk.Y, pk.Tag, pv)
	}
	let s = map[Shape]str{Shape.Circle(1): "c", Shape.Rect(2, 3): "r"}
	delete(s, Shape.Circle(1))
	say.Line(s, s[Shape.Rect(2, 3)], len(s))
	let xs = []i64{1, 2, 3, 4, 5, 6}
	say.Line(sift.Map(xs, double), sift.Filter(xs, even), sift.Reduce(xs, 0, add), sift.Map(xs, label))
}
