package main

import "say"

type Entry struct {
	Key  str
	Tags []str
}

var names []str
var cache map[str]i64 = make(map[str]i64)
var last str
var entries []Entry

func remember(q str) {
	names = append(names, keep(q))
	cache[keep(q)] = len(q)
	last = keep(q)
	e := Entry{Key: q}
	e.Tags = append(e.Tags, q)
	entries = append(entries, keep(e))
}

func count(m map[str]i64, k str) i64 {
	return m[k]
}

func main() {
	for i := 0; i < 3; i++ {
		remember(say.Fmt("req%d", i))
	}
	say.Line(names, len(cache), last, count(cache, "req1"), entries[2].Key, entries[2].Tags)
}
