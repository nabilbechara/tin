package main

import "hearth"
import "say"

// Uses around hearth.Reset() that are safe (#179): a value created after the reset, a kept
// one, a number, and a loop whose locals are new each iteration.

mut kept str = ""

fn mk(n i64) str {
	return "fresh-{n}"
}

fn main() {
	mut total = 0
	for i in 0..3 {
		let s = mk(i)
		total += len(s)
		hearth.Reset()
	}
	let k = keep(mk(7))
	hearth.Reset()
	mut t = mk(8)
	hearth.Reset()
	t = mk(9)
	kept = keep(t)
	hearth.Reset()
	say.Line("total", total, "kept", k, "again", kept)
}
