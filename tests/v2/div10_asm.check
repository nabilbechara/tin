# x64 constant division avoids IDIV; arm64 keeps its existing SDiv lowering.

[arm64]
CHECK: _quotient:
CHECK: sdiv
CHECK: _remainder:
CHECK: sdiv

[amd64]
CHECK: # L1: quotient
CHECK: # L2: remainder
CHECK: # L3: main.main
CHECK: \nL1:\n
CHECK-NOT: idiv
CHECK: imul r
CHECK-NOT: idiv
CHECK: \nL2:\n
CHECK-NOT: idiv
CHECK: imul r
CHECK-NOT: idiv
CHECK: \nL3:\n
