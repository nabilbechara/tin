package main

import "say"

fn show(q query) {
	say.Line(len(q.Parts), len(q.Args), q.Parts)
	for _, a in q.Args {
		match a {
			Int(v) => {
				say.Line("int", v)
			}
			Str(v) => {
				say.Line("str", v)
			}
			Float(v) => {
				say.Line("float", v)
			}
			Bool(v) => {
				say.Line("bool", v)
			}
			Bytes(v) => {
				say.Line("bytes", len(v))
			}
		}
	}
}

fn main() {
	let id = 42
	let small u8 = 7
	let bs = []u8{1, 2}
	let name = "o'brien; DROP"
	show("PING")
	show("SET user:{id} {name}")
	show("{small}{1.5}{true}{bs}{f32(2.5)}")
	let q query = "GET k{id}"
	show(q)
}
