package main

import "say"

// Closures that outlive the call capture parameters through cells; every parameter must
// keep its own value (a captured parameter's cell once overwrote the next parameter).

func adders(a i64, b i64, c str) []func() str {
	fs := make([]func() str, 0, 3)
	fs = append(fs, func() str { return say.Fmt("%d", a+b) })
	fs = append(fs, func() str { return c + say.Fmt("%d", b) })
	fs = append(fs, func() str { return say.Fmt("%d %d %s", a, b, c) })
	return fs
}

func counter(start i64, step i64) func() i64 {
	n := start
	return func() i64 {
		n += step
		return n
	}
}

func main() {
	for _, f := range adders(3, 4, "x") {
		say.Line(f())
	}
	next := counter(10, 5)
	next()
	say.Line(next())
}
