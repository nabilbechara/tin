package main

import "constraints"

// A listed instance's parameter constraint is checked at the instantiation.
shape Limited[T i64 | str] { Get() T }

shape LimitedGetter[U constraints.Any] { Limited[U] }

type Box struct { n i64 }

fn (b Box) Get() bool {
	return true
}

fn Use[S LimitedGetter[bool]](s S) i64 {
	return 0
}

fn main() {
	let b = Box{n: 1}
	Use(b)
}
