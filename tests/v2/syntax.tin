package main

import "say"

type Color i64

const (
	Red Color = iota
	Green
	Blue
)

func main() {
	if x := 3; x > 2 {
		say.Line("ifinit", x)
	}
	switch y := 5; {
	case y > 3:
		say.Line("tagless")
	}
	n := 0
	for i := range 3 {
		n += i
	}
	say.Line("range int", n)
	say.Line(0b101, 0o17, 1_000, 'a', "é", `raw\n`)
	a, b := 1, 2
	a, b = b, a
	say.Line(a, b, Green, Blue)
	var arr [3]i64
	say.Line(len(arr))
	extra()
	board()
}

type Grid struct {
	cells [4]i64
	names [2]str
}

var g [5]u8

func extra() {
	gr := Grid{}
	gr.cells[3] = 9
	say.Line(len(gr.cells), gr.cells, len(gr.names), gr.names[1] == "", len(g))
	var m [2][3]i64
	say.Line(len(m), len(m[0]))
}

type Board struct {
	cells [3][3]u8
}

func board() {
	b := Board{}
	b.cells[1][2] = 7
	var plain []i64
	say.Line(len(b.cells), len(b.cells[2]), b.cells[1], len(plain))
}
