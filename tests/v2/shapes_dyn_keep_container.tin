package main

import "hearth"
import "io"
import "say"

type Buf struct { n i64 }

func (b Buf) Write(data []u8) !i64 {
	return len(data) + b.n
}

type Holder struct {
	w dyn io.Writer
	ws []dyn io.Writer
}

func Write(w dyn io.Writer) !i64 {
	return try w.Write([]u8{1})
}

func main() {
	let b = Buf{n: 2}
	let ws = append([]dyn io.Writer{}, b)
	let h = Holder{w: b, ws: ws}
	let k = keep(h)
	hearth.Reset()
	a := Write(k.w) catch _ { -1 }
	c := Write(k.ws[0]) catch _ { -1 }
	say.Line("total: {a + c}")
}
