package main

import "anvil"
import "say"

func h(q anvil.Req, w mut anvil.Out) {
	w.Text("h")
}

func mw(q anvil.Req, w mut anvil.Out, next func(anvil.Req, mut anvil.Out)) {
	next(q, w)
}

func main() {
	r := anvil.NewRouter()
	// In a "..." string {id} is a value: patterns with parameters are raw strings.
	r.Get("/users/{id}", h)
	r.Use(h)
	r.Get("/x", mw)
	// Function literals cannot capture: a group's routes use only its parameter and globals.
	prefix := "/v1"
	r.Route("/api", func(g mut anvil.Router) {
		g.Get(prefix, h)
	})
	err := r.Serve(":8080")
	say.Line(err)
}
