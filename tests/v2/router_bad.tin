package main

import "anvil"
import "say"

fn h(q anvil.Req, w mut anvil.Out) {
	w.Text("h")
}

fn mw(q anvil.Req, w mut anvil.Out, next fn(anvil.Req, mut anvil.Out)) {
	next(q, w)
}

fn main() {
	let r = anvil.NewRouter()
	// In a "..." string {id} is a value: patterns with parameters are raw strings.
	r.Get("/users/{id}", h)
	r.Use(h)
	r.Get("/x", mw)
	let err = r.Serve(":8080")
	say.Line(err)
}
