package main

import "constraints"

// A constraint failure in a listed instance is reported once, even when the shape is used.
shape A[T i64 | str] { Get() T }

shape G[T constraints.Any] { A[f64] }

type X struct { n i64 }

fn (x X) Get() f64 {
	return 0
}

fn Use[S G[i64]](s S) i64 {
	return 0
}

fn main() {
	let x = X{n: 1}
	Use(x)
}
