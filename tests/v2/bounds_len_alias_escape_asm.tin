package main

mut saved fn()

fn trigger() {
	saved()
}

fn sum(xs []i64) i64 {
	mut data = xs
	saved = keep(fn() { data = keep(data[:0]) })
	let n = len(data)
	mut total = i64(0)
	for i in i64(0)..n {
		if i == 1 {
			trigger()
		}
		total += data[i]
	}
	return total
}

fn main() {
	sum([]i64{1, 2, 3})
}
