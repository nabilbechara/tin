package main

var saved func()

func trigger() {
	saved()
}

func sum(xs []i64) i64 {
	data := xs
	saved = keep(func() { data = keep(data[:0]) })
	n := len(data)
	total := i64(0)
	for i := i64(0); i < n; i++ {
		if i == 1 {
			trigger()
		}
		total += data[i]
	}
	return total
}

func main() {
	sum([]i64{1, 2, 3})
}
