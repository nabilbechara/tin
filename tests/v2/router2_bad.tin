package main

import "anvil"
import "say"

var last str
var global = anvil.NewRouter()

// Path parameters live in the request pool like the rest of the request.
func h(q anvil.Req, w mut anvil.Out) {
	last = q.PathParam("id")
}

func main() {
	// A router is built in main, or by a function a global's initializer calls.
	global.Get(`/users/{id}`, h)
	err := global.Serve(":8080")
	say.Line(err)
}
