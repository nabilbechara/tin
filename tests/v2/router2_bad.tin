package main

import "anvil"
import "say"

mut last str
let global = anvil.NewRouter()

// Path parameters live in the request pool like the rest of the request.
fn h(q anvil.Req, w mut anvil.Out) {
	last = q.PathParam("id")
}

fn main() {
	// A router is built in main, or by a function a global's initializer calls.
	global.Get(`/users/{id}`, h)
	let err = global.Serve(":8080")
	say.Line(err)
}
