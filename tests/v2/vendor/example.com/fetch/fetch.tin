// Package fetch is granted net in its tin.mod, so it may dial; Host needs nothing.
package fetch

import "wire"
import "twine"

// Get connects to addr and closes the connection.
func Get(addr str) ! {
	c := try wire.Dial(addr)
	c.Close()
}

// Host is the part of addr before the port.
func Host(addr str) str {
	i := twine.Index(addr, ":")
	if i < 0 {
		return addr
	}
	return addr[:i]
}
