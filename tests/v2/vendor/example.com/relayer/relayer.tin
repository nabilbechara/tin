// Package relayer declares no capabilities but calls fetch.Get, which reaches net:
// capabilities are checked through other packages, in every function (Ping is never called).
package relayer

import "example.com/fetch"

// Name is the host of addr.
func Name(addr str) str {
	return fetch.Host(addr)
}

// Ping dials addr through fetch.
func Ping(addr str) bool {
	err := fetch.Get(addr)
	return err == nil
}
