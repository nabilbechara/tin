// Package netpeek is a vendored dependency (#146) whose tin.mod does not grant net, but
// which dials anyway: a direct call and a function value are both refused at compile time.
package netpeek

import "wire"

var dialer = wire.Dial

// Reachable reports whether addr accepts a connection.
func Reachable(addr str) bool {
	c, err := wire.Dial(addr)
	if err != nil {
		return false
	}
	c.Close()
	return true
}
