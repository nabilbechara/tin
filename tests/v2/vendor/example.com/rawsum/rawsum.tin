// Package rawsum is granted unsafe: like the standard library, it may use raw memory.
package rawsum

// Sum adds the bytes of s, reading them straight from the string's memory.
func Sum(s str) i64 {
	p := cast(i64, s) + 8
	t := 0
	for i := 0; i < len(s); i++ {
		t += i64(load8(p + i))
	}
	return t
}
