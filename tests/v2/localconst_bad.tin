package main

// Edition 1 declares constants at package level only (a local const is E090, see
// tests/edition1/local_const.tin): the errors a constant can still have, one name per case.
fn value() i64 { return 1 }

const assigned = 1

fn assign() { assigned = 2 }

const increased = 1

fn increment() { increased += 1 }

const twice = 1

const twice = 2

let runtimeValue = 1

const fromVariable = runtimeValue

const fromCall = value()

const tooBig u8 = 256

const wrongType bool = "wrong"

const divided = 1 / 0

fn main() {}
