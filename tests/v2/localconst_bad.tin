package main

func value() i64 { return 1 }
func assign() { const n = 1; n = 2 }
func increment() { const n = 1; n++ }
func compound() { const n = 1; n += 1 }
func multi() { const n = 1; n, fresh := 2, 3; _ = fresh }
func duplicate() { const n = 1; const n = 2 }
func variable() { n := 1; const n = 2 }
func parameter(n i64) { const n = 2 }
func scope() { { const n = 1 }; _ = n }
func forward() { const n = later; const later = 2; _ = n }
func call() { const n = value(); _ = n }
func runtime() { n := 1; const m = n; _ = m }
func overflow() { const n u8 = 256 }
func wrongType() { const n bool = "wrong" }
func zero() { const n = 1 / 0 }
func main() {}
