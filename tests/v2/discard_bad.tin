package main

import "say"

func one() !i64 {
	fail "boom"
}

func two() !(i64, str) {
	fail "boom"
}

func check() ! {
	fail "boom"
}

func pair() (i64, str) {
	return 1, "a"
}

func none() {
}

func drop[T any](x T) {
}

func blanks() {
	_ = one()
	_ := check()
	x, _ := one()
	a, b, _ := two()
	x, _ = one()
	_, c := one(), 2
	_ = pair()
	_ = none()
	_, err := one()
	if err != nil {
		say.Line(x, a, b, c)
	}
}

func values() {
	say.Line(one())
	say.Line(pair())
	say.Line(none())
	s := say.Fmt("%v", one())
	println(one())
	t := "v={one()}"
	drop(one())
	say.Line(s, t)
}

func main() {
	blanks()
	values()
}
