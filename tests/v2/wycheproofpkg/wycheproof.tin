// Package wycheproofpkg runs the compact Wycheproof signature files for tests/v2/seal_wycheproof*.tin.
package wycheproofpkg

import "say"
import "seal"
import "quarry"
import "twine"

func hexOrEmpty(s str) []u8 {
	if s == "-" {
		return []u8{}
	}
	b, err := seal.HexDecode(s)
	if err != nil {
		return []u8{}
	}
	return b
}

func hashOf(name str) seal.Hash {
	if name == "SHA-384" {
		return seal.Hash.SHA384
	}
	if name == "SHA-512" {
		return seal.Hash.SHA512
	}
	return seal.Hash.SHA256
}

// Run checks every test of tests/wycheproof/NAME.txt and prints a summary line and any mismatch.
func Run(name str) {
	text := quarry.ReadFile("tests/wycheproof/" + name + ".txt") catch err {
		say.Line(name, "unreadable:", err)
		return
	}
	kind := ""
	h := seal.Hash.SHA256
	salt := -1
	keyOk := false
	key := seal.RSAPublicKey{N: []u8{}, E: []u8{}}
	curve := ""
	point := []u8{}
	counts := map[str]i64{}
	passed := map[str]i64{}
	for _, ln := range twine.Split(text, "\n") {
		if ln == "" || ln[0] == '#' {
			continue
		}
		f := twine.Fields(ln)
		if f[0] == "group" {
			kind = f[1]
			h = hashOf(f[2])
			salt = -1
			if kind == "ecdsa" {
				curve = f[3]
				point = hexOrEmpty(f[4])
				keyOk = true
				continue
			}
			if f[3] != "-" {
				salt = mint_atoi(f[3])
			}
			k, err := seal.ParseRSAPublicKeyDER(hexOrEmpty(f[4]))
			keyOk = err == nil
			if keyOk {
				key = k
			}
			continue
		}
		result := f[1]
		msg := hexOrEmpty(f[2])
		sig := hexOrEmpty(f[3])
		digest := seal.Sum(h, str(msg))
		ok := false
		if keyOk {
			if kind == "rsa-pkcs1" {
				err := seal.VerifyPKCS1v15(key, h, digest, sig)
				ok = err == nil
			} else if kind == "ecdsa" {
				err := seal.VerifyECDSA(curve, point, digest, sig)
				ok = err == nil
			} else {
				err := seal.VerifyPSS(key, h, digest, sig, salt)
				ok = err == nil
			}
		}
		counts[result] += 1
		if ok {
			passed[result] += 1
		}
		if (result == "valid" && !ok) || (result == "invalid" && ok) {
			say.Line(name, "MISMATCH tcId", f[0], result, ok)
		}
	}
	say.Line(name, "valid", passed["valid"], "/", counts["valid"], "invalid-accepted", passed["invalid"], "/", counts["invalid"], "acceptable-accepted", passed["acceptable"], "/", counts["acceptable"])
}

func mint_atoi(s str) i64 {
	v := 0
	for i := 0; i < len(s); i++ {
		v = v*10 + i64(s[i]-'0')
	}
	return v
}
