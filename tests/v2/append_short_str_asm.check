[arm64]
CHECK: _main.main:
CHECK: cmp x[0-9]+, #1
CHECK: ldrb w[0-9]+, \[x[0-9]+\]
CHECK: strb w[0-9]+, \[x[0-9]+\]
CHECK: _memcpy

[amd64]
CHECK: (?m)^L1:$
CHECK: cmp r[a-z0-9]+,0x1
CHECK: movzx [a-z0-9]+,BYTE PTR \[r[a-z0-9]+\]
CHECK: mov BYTE PTR \[r[a-z0-9]+\],(?:r[0-9]+b|[a-z]+l)
CHECK: # memcpy
