package main

import "say"

type Box struct {
	Items []str
}

mut names []str
let cache map[str]i64 = make(map[str]i64)
mut last str
let box Box = Box{}

fn bad1(q str) {
	names = append(names, q)
}

fn bad2(q str) {
	cache[q] = 1
}

fn bad3(q str) {
	last = q
}

fn put(b mut Box, s str) {
	b.Items = append(b.Items, s)
}

fn bad4(q str) {
	put(mut box, q)
}

fn bad5(b Box) {
	b.Items = append(b.Items, "x")
}

fn main() {
	let q = say.Fmt("%d", 1)
	bad1(q)
	bad2(q)
	bad3(q)
	bad4(q)
	bad5(Box{})
	let b = Box{}
	put(mut b, q)
	say.Line(len(names))
}
