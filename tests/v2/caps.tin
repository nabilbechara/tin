package main

// Capabilities (#146): fetch declares net and label uses only its Host, which needs
// nothing; rawsum declares unsafe and reads raw memory. Nothing here touches the network.
import "example.com/fetch"
import "example.com/rawsum"
import "example.com/label"
import "say"

func main() {
	say.Line("host", fetch.Host("example.com:80"))
	say.Line("label", label.Of("tin.dev:443"))
	say.Line("sum", rawsum.Sum("abc"))
	f := fetch.Get
	say.Line("have Get", f != nil)
}
