package main

import "say"

fn main() {
	let parts = []str{"", "a", "be", "cat", "dogs", "light!", "12345678", "ninebytes!"}
	mut b = make([]u8, 0, 128)
	for _, part in parts {
		b = append(b, part...)
	}
	say.Line("parts", str(b), len(b))

	mut long = make([]u8, 0, 64)
	long = append(long, parts[7]...)
	say.Line("long", str(long), len(long))

	mut tiny = make([]u8, 0, 1)
	tiny = append(tiny, parts[1]...)
	tiny = append(tiny, parts[2]...)
	say.Line("tiny", str(tiny), len(tiny))

	mut two = make([]u8, 0, 2)
	two = append(two, parts[2]...)
	say.Line("two", str(two), len(two), cap(two))

	mut exact = make([]u8, 0, 6)
	exact = append(exact, parts[5]...)
	say.Line("exact", str(exact), len(exact), cap(exact))
}
