package main

import "say"

func main() {
	parts := []str{"", "a", "be", "cat", "dogs", "light!", "12345678", "ninebytes!"}
	b := make([]u8, 0, 128)
	for _, part := range parts {
		b = append(b, part...)
	}
	say.Line("parts", str(b), len(b))

	long := make([]u8, 0, 64)
	long = append(long, parts[7]...)
	say.Line("long", str(long), len(long))

	tiny := make([]u8, 0, 1)
	tiny = append(tiny, parts[1]...)
	tiny = append(tiny, parts[2]...)
	say.Line("tiny", str(tiny), len(tiny))
}
