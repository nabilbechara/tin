package main

import "say"
import "hearth"

mut hits i64
let name str = say.Fmt("core%d", 7)
let seen map[i64]str = make(map[i64]str)

fn work(id i64) {
	for i in 0..1000 {
		hits += 1
	}
	seen[id] = name
	say.Line(name, id, hits, len(seen))
}

fn main() {
	hits = 5
	hearth.Run(4, work)
	say.Line("main", hits)
}
