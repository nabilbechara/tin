package main

import "say"
import "hearth"

var hits i64
var name str = say.Fmt("core%d", 7)
var seen map[i64]str = make(map[i64]str)

func work(id i64) {
	for i := 0; i < 1000; i++ {
		hits++
	}
	seen[id] = name
	say.Line(name, id, hits, len(seen))
}

func main() {
	hits = 5
	hearth.Run(4, work)
	say.Line("main", hits)
}
