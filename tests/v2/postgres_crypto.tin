package main

import "seal"
import "say"
import "postgres/md5"
import "postgres/sasl"

func main() {
	v0 := seal.Pbkdf2Sha256("password", "salt", 1, 32) catch _ { []u8{} }
	say.Line("pbkdf2 0", seal.Hex(v0))
	v1 := seal.Pbkdf2Sha256("password", "salt", 2, 32) catch _ { []u8{} }
	say.Line("pbkdf2 1", seal.Hex(v1))
	v2 := seal.Pbkdf2Sha256("password", "salt", 4096, 32) catch _ { []u8{} }
	say.Line("pbkdf2 2", seal.Hex(v2))
	v3 := seal.Pbkdf2Sha256("passwordPASSWORDpassword", "saltSALTsaltSALTsaltSALTsaltSALTsalt", 4096, 40) catch _ { []u8{} }
	say.Line("pbkdf2 3", seal.Hex(v3))
	v4 := seal.Pbkdf2Sha256("pass\x00word", "sa\x00lt", 4096, 16) catch _ { []u8{} }
	say.Line("pbkdf2 4", seal.Hex(v4))
	v5 := seal.Pbkdf2Sha256("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", "salt", 10000, 64) catch _ { []u8{} }
	say.Line("pbkdf2 5", seal.Hex(v5))
	v6 := seal.Pbkdf2Sha256("password", "salt", 1, 0) catch _ { []u8{} }
	say.Line("pbkdf2 6", len(v6))
	_, e0 := seal.Pbkdf2Sha256("p", "s", 0, 32)
	say.Line("invalid 0", e0 != nil)
	_, e1 := seal.Pbkdf2Sha256("p", "s", -1, 32)
	say.Line("invalid 1", e1 != nil)
	_, e2 := seal.Pbkdf2Sha256("p", "s", 1, -1)
	say.Line("invalid 2", e2 != nil)
	_, e3 := seal.Pbkdf2Sha256("p", "s", 1, 1048577)
	say.Line("invalid 3", e3 != nil)
	say.Line("md5 0", seal.Hex(md5.Sum("")))
	say.Line("md5 1", seal.Hex(md5.Sum("a")))
	say.Line("md5 2", seal.Hex(md5.Sum("abc")))
	say.Line("md5 3", seal.Hex(md5.Sum("message digest")))
	say.Line("md5 4", seal.Hex(md5.Sum("abcdefghijklmnopqrstuvwxyz")))
	say.Line("md5 5", seal.Hex(md5.Sum("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789")))
	say.Line("md5 6", seal.Hex(md5.Sum("12345678901234567890123456789012345678901234567890123456789012345678901234567890")))
	say.Line("sasl 0", seal.Hex([]u8(sasl.Prep("plain"))))
	say.Line("sasl 1", seal.Hex([]u8(sasl.Prep("I­X"))))
	say.Line("sasl 2", seal.Hex([]u8(sasl.Prep("ª"))))
	say.Line("sasl 3", seal.Hex([]u8(sasl.Prep("Ⅸ"))))
	say.Line("sasl 4", seal.Hex([]u8(sasl.Prep("x y"))))
	say.Line("sasl 5", seal.Hex([]u8(sasl.Prep("é"))))
	say.Line("sasl 6", seal.Hex([]u8(sasl.Prep("각"))))
	say.Line("sasl 7", seal.Hex([]u8(sasl.Prep("اب"))))
	say.Line("sasl 8", seal.Hex([]u8(sasl.Prep("اaب"))))
	say.Line("sasl 9", seal.Hex([]u8(sasl.Prep("ȡ"))))
	say.Line("sasl 10", seal.Hex([]u8(sasl.Prep("\x07ª"))))
	say.Line("sasl 11", len(sasl.Prep("﻿")))
	say.Line("sasl 12", seal.Hex([]u8(sasl.Prep("�"))))
	say.Line("sasl 13", seal.Hex([]u8(sasl.Prep("ᴬ"))))
	say.Line("sasl 14", seal.Hex([]u8(sasl.Prep("Ạ̊"))))
	say.Line("sasl 15", seal.Hex([]u8(sasl.Prep("é̖̀"))))
	_, timed := seal.Pbkdf2Sha256Timeout("p", "s", 1000000, 32, 1)
	say.Line("pbkdf2 timeout", timed != nil)
	say.Line("sasl invalid", seal.Hex([]u8(sasl.Prep("\xff\xaa"))))
}
