fn main() {
    let n = 20000000;
    let s = malloc(n * 8);
    let i = 0;
    while i < n {
        s[i] = 1;
        i = i + 1;
    }
    let count = 0;
    i = 2;
    while i < n {
        if s[i] {
            count = count + 1;
            let j = i * i;
            while j < n {
                s[j] = 0;
                j = j + i;
            }
        }
        i = i + 1;
    }
    print_int(count);
    println("");
    return 0;
}
