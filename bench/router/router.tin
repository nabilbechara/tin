package main

import "anvil"
import "hearth"
import "say"
import "tide"

// The cost of routing with 1, 20 and 200 routes (bench/router/go is the same with chi):
// Match is the lookup alone, Run a whole request through the router (Req, Out, handler).
//   tin bench/router/router.tin
fn h(q anvil.Req, w mut anvil.Out) {
	w.Text("ok")
}

// build makes a router of n routes: per resource i, GET /resI, GET and PUT /resI/{id}, and
// GET /resI/{id}/items (n = 1 is just GET /res0/{id}).
fn build(n i64) anvil.Router {
	let r = anvil.NewRouter()
	if n == 1 {
		r.Get(`/res0/{id}`, h)
		return r
	}
	{
		mut i = 0
		for len(routes_of(n, i)) > 0 {
			for _, p in routes_of(n, i) {
				if p[0] == 'P' {
					r.Put(p[1:], h)
				} else {
					r.Get(p, h)
				}
			}
			i += 1
		}
	}
	return r
}

// routes_of is resource i's patterns in a router of n routes ("P" marks a PUT).
fn routes_of(n i64, i i64) []str {
	mut per = 2
	if n > 20 {
		per = 4
	}
	if i*per >= n {
		return []str{}
	}
	mut ps = []str{say.Fmt("/res%d", i), say.Fmt(`/res%d/{id}`, i)}
	if per == 4 {
		ps = append(ps, say.Fmt(`P/res%d/{id}`, i), say.Fmt(`/res%d/{id}/items`, i))
	}
	return ps
}

let r1 = build(1)
let r20 = build(20)
let r200 = build(200)

fn match_(label str, r anvil.Router, method str, path str, want str) {
	if r.Match(method, path) != want {
		say.Line("wrong match for", path)
		return
	}
	let n = 5000000
	let t0 = tide.Now()
	for i in 0..n {
		r.Match(method, path)
	}
	say.Out("%-34s %6.1f ns\n", label, f64(tide.Since(t0))/f64(n))
}

// router is one of the global routers (long-lived, so it outlives hearth.Reset).
fn router(routes i64) anvil.Router {
	if routes == 1 {
		return r1
	}
	if routes == 20 {
		return r20
	}
	return r200
}

fn run(label str, routes i64, method str, path str) {
	// The rounds reset the pool (hearth.Reset), so the strings must outlive it.
	label = keep(label)
	method = keep(method)
	path = keep(path)
	let n = 200000
	mut best = 0.0
	for round in 0..5 {
		let t0 = tide.Now()
		let r = router(routes)
		for i in 0..n {
			r.Run(method, path, "")
		}
		let ns = f64(tide.Since(t0)) / f64(n)
		if round == 0 || ns < best {
			best = ns
		}
		hearth.Reset()
	}
	say.Out("%-34s %6.1f ns\n", label, best)
}

fn main() {
	say.Line("routes", r1.Check(), r20.Check(), r200.Check())
	match_("match 1   /res0/42", r1, "GET", "/res0/42", `/res0/{id}`)
	match_("match 20  /res7 (static)", r20, "GET", "/res7", "/res7")
	match_("match 20  /res7/42", r20, "GET", "/res7/42", `/res7/{id}`)
	match_("match 20  /nope (404)", r20, "GET", "/nope", "")
	match_("match 200 /res37 (static)", r200, "GET", "/res37", "/res37")
	match_("match 200 /res37/42", r200, "GET", "/res37/42", `/res37/{id}`)
	match_("match 200 PUT /res37/42", r200, "PUT", "/res37/42", `/res37/{id}`)
	match_("match 200 /res37/42/items", r200, "GET", "/res37/42/items", `/res37/{id}/items`)
	match_("match 200 /nope (404)", r200, "GET", "/nope", "")
	run("run 1   /res0/42", 1, "GET", "/res0/42")
	run("run 20  /res7/42", 20, "GET", "/res7/42")
	run("run 200 /res37/42/items", 200, "GET", "/res37/42/items")
	run("run 200 /nope (404)", 200, "GET", "/nope")
}
