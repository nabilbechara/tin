fn main() {
    let n = 400;
    let a = malloc(n * n * 8);
    let b = malloc(n * n * 8);
    let c = malloc(n * n * 8);
    let i = 0;
    while i < n * n {
        a[i] = i % 7;
        b[i] = i % 5;
        c[i] = 0;
        i = i + 1;
    }
    i = 0;
    while i < n {
        let k = 0;
        while k < n {
            let aik = a[i * n + k];
            let j = 0;
            while j < n {
                c[i * n + j] = c[i * n + j] + aik * b[k * n + j];
                j = j + 1;
            }
            k = k + 1;
        }
        i = i + 1;
    }
    let sum = 0;
    i = 0;
    while i < n * n {
        sum = sum + c[i];
        i = i + 1;
    }
    print_int(sum);
    println("");
    return 0;
}
