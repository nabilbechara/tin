package main

import "anvil"
import "argo"
import "mint"
import "quarry"
import "say"

// examples/api.tin's /json and /plaintext behind a router of ROUTES routes (at least 2):
// the others are GET /resI, GET and PUT /resI/{id} and GET /resI/{id}/items, so the root
// has many static children and the lookups go through parameters. Port 9180, like api.tin.
type Message struct {
	message str
}

func json(q anvil.Req, w mut anvil.Out) {
	w.Json()
	argo.Put(mut w.Body, Message{message: "Hello, World!"})
}

func plaintext(q anvil.Req, w mut anvil.Out) {
	w.Text("Hello, World!")
}

func filler(q anvil.Req, w mut anvil.Out) {
	w.Text("filler")
}

func main() {
	n := mint.Atoi(quarry.Getenv("ROUTES")) catch _ { 2 }
	r := anvil.NewRouter()
	r.Get("/json", json)
	r.Get("/plaintext", plaintext)
	added := 2
	for i := 0; added < n; i++ {
		r.Get(say.Fmt("/res%d", i), filler)
		r.Get(say.Fmt(`/res%d/{id}`, i), filler)
		r.Put(say.Fmt(`/res%d/{id}`, i), filler)
		r.Get(say.Fmt(`/res%d/{id}/items`, i), filler)
		added += 4
	}
	say.Line("routes:", added)
	err := r.Serve(":9180")
	say.Line("server:", err)
}
