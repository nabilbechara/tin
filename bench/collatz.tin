fn steps(n) {
    let c = 0;
    while n != 1 {
        if n % 2 == 0 {
            n = n / 2;
        } else {
            n = 3 * n + 1;
        }
        c = c + 1;
    }
    return c;
}

fn main() {
    let total = 0;
    let i = 1;
    while i < 3000000 {
        total = total + steps(i);
        i = i + 1;
    }
    print_int(total);
    println("");
    return 0;
}
