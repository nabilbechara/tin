package main
import "ore"
import "say"
func main() {
    const n = 1048576
    source := make([]u8,n)
    dest := make([]u8,n)
    for i := range source { source[i] = 7 }
    source[n-1] = 33
    text := str(source)
    buf := make([]u8,0,n)
    total := i64(0)
    for i := 0; i < 128; i++ {
        buf = buf[:0]
        buf = append(buf,text...)
        copy(dest,buf)
        if !ore.Equal(source,dest) { panic("memory mismatch") }
        total += ore.IndexByte(dest,33)
    }
    say.Line(n,total,dest[n-1])
}
