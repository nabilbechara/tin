package main

import "say"
import "seal"

// 1000 chained X25519 operations (RFC 7748 section 5.2's iteration).
fn main() {
	mut k = make([]u8, 32)
	k[0] = 9
	mut u = make([]u8, 32)
	u[0] = 9
	for i in 0..1000 {
		let r = seal.X25519(k, u) catch e {
			say.Line(e)
			return
		}
		u = k
		k = r
	}
	say.Line(seal.Hex(k))
}
