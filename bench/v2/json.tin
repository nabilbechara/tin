package main

import "say"
import "argo"

type Item struct {
	ID   i64
	Name str
	Qty  u32
	Tags []str
	OK   bool
	Note str
}

fn main() {
	mut items = make([]Item, 0, 10)
	for i in i64(0)..10 {
		items = append(items, Item{ID: i * 7919, Name: say.Fmt("item-%d", i), Qty: u32(i * 3), Tags: []str{"a", "bb", say.Fmt("t%d", i)}, OK: i%2 == 0, Note: "quote \"here\" and\nnewline"})
	}
	mut b = make([]u8, 0, 4096)
	mut total = i64(0)
	for i in 0..1000000 {
		b = b[:0]
		argo.Put(mut b, items)
		total += len(b)
	}
	say.Line(total)
	say.Line(str(b))
}
