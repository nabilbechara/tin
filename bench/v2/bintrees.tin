package main

import "say"

type Node struct {
	left  ?Node
	right ?Node
}

func bottomUp(d i64) Node {
	if d <= 0 {
		return Node{}
	}
	return Node{left: bottomUp(d - 1), right: bottomUp(d - 1)}
}

func check(n Node) i64 {
	l := n.left
	r := n.right
	if l != nil {
		if r != nil {
			return 1 + check(l) + check(r)
		}
	}
	return 1
}

func main() {
	maxDepth := i64(18)
	stretch := maxDepth + 1
	say.Out("stretch tree of depth %d\t check: %d\n", stretch, check(bottomUp(stretch)))
	longLived := bottomUp(maxDepth)
	total := i64(0)
	for d := i64(4); d <= maxDepth; d += 2 {
		iters := i64(1) << (maxDepth - d + 4)
		chk := i64(0)
		for i := i64(0); i < iters; i++ {
			chk += check(bottomUp(d))
		}
		total += chk
		say.Out("%d\t trees of depth %d\t check: %d\n", iters, d, chk)
	}
	say.Out("long lived tree of depth %d\t check: %d\n", maxDepth, check(longLived))
	say.Line(total)
}
