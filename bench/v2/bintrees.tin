package main

import "say"

type Node struct {
	left  ?Node
	right ?Node
}

fn bottomUp(d i64) Node {
	if d <= 0 {
		return Node{}
	}
	return Node{left: bottomUp(d - 1), right: bottomUp(d - 1)}
}

fn check(n Node) i64 {
	let l = n.left
	let r = n.right
	if l != nil {
		if r != nil {
			return 1 + check(l) + check(r)
		}
	}
	return 1
}

fn main() {
	let maxDepth = i64(18)
	let stretch = maxDepth + 1
	say.Out("stretch tree of depth %d\t check: %d\n", stretch, check(bottomUp(stretch)))
	let longLived = bottomUp(maxDepth)
	mut total = i64(0)
	{
		mut d = i64(4)
		for d <= maxDepth {
			let iters = i64(1) << (maxDepth - d + 4)
			mut chk = i64(0)
			for i in i64(0)..iters {
				chk += check(bottomUp(d))
			}
			total += chk
			say.Out("%d\t trees of depth %d\t check: %d\n", iters, d, chk)
			d += 2
		}
	}
	say.Out("long lived tree of depth %d\t check: %d\n", maxDepth, check(longLived))
	say.Line(total)
}
