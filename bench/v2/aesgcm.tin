package main

import "say"
import "seal"

// AES-128-GCM over 16 MiB in 16 KiB TLS-sized records.
func main() {
	key := make([]u8, 16)
	for i := 0; i < 16; i++ {
		key[i] = u8(i * 7)
	}
	a := seal.NewAESGCM(key) catch e {
		say.Line(e)
		return
	}
	data := make([]u8, 16384)
	for i := 0; i < len(data); i++ {
		data[i] = u8(i)
	}
	nonce := make([]u8, 12)
	aad := []u8{23, 3, 3, 64, 17}
	tag := []u8{}
	for r := 0; r < 1024; r++ {
		nonce[11] = u8(r)
		nonce[10] = u8(r >> 8)
		out := a.Seal(nonce, data, aad) catch e {
			say.Line(e)
			return
		}
		tag = out[len(out)-16:]
	}
	say.Line(seal.Hex(tag))
}
