package main

import "say"
import "seal"

// AES-128-GCM over 16 MiB in 16 KiB TLS-sized records.
fn main() {
	let key = make([]u8, 16)
	for i in 0..16 {
		key[i] = u8(i * 7)
	}
	let a = seal.NewAESGCM(key) catch e {
		say.Line(e)
		return
	}
	let data = make([]u8, 16384)
	for i in 0..len(data) {
		data[i] = u8(i)
	}
	let nonce = make([]u8, 12)
	let aad = []u8{23, 3, 3, 64, 17}
	mut tag = []u8{}
	for r in 0..1024 {
		nonce[11] = u8(r)
		nonce[10] = u8(r >> 8)
		let out = a.Seal(nonce, data, aad) catch e {
			say.Line(e)
			return
		}
		tag = out[len(out)-16:]
	}
	say.Line(seal.Hex(tag))
}
