package main

import "say"

func main() {
	n := i64(5000000)
	m := make(map[i64]i64)
	k := i64(12345)
	for i := i64(0); i < n; i++ {
		k = k*6364136223846793005 + 1442695040888963407
		m[k] = i
	}
	k = 12345
	sum := i64(0)
	for i := i64(0); i < n; i++ {
		k = k*6364136223846793005 + 1442695040888963407
		sum += m[k]
	}
	miss := i64(0)
	for i := i64(0); i < n; i++ {
		k = k*6364136223846793005 + 1442695040888963407
		_, ok := m[k]
		if !ok {
			miss++
		}
	}
	say.Line(len(m), sum, miss)
}
