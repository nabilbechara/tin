package main

import "say"

fn main() {
	let n = i64(5000000)
	let m = make(map[i64]i64)
	mut k = i64(12345)
	for i in i64(0)..n {
		k = k*6364136223846793005 + 1442695040888963407
		m[k] = i
	}
	k = 12345
	mut sum = i64(0)
	for i in i64(0)..n {
		k = k*6364136223846793005 + 1442695040888963407
		sum += m[k]
	}
	mut miss = i64(0)
	for i in i64(0)..n {
		k = k*6364136223846793005 + 1442695040888963407
		let (_, ok) = m[k]
		if !ok {
			miss += 1
		}
	}
	say.Line(len(m), sum, miss)
}
