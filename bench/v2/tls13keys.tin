package main

import "say"
import "seal"

func label(secret []u8, l str, ctx []u8, n i64) []u8 {
	return seal.HkdfExpandLabel(seal.Hash.SHA256, str(secret), l, str(ctx), n) catch _ {
		[]u8{}
	}
}

// The client's cryptography for 300 TLS 1.3 handshakes: an X25519 key share and shared
// secret, the key schedule, four AES-128-GCM keys and both Finished MACs.
func main() {
	server := seal.X25519PublicKey(seal.Sha256("server")) catch _ {
		[]u8{}
	}
	zero := make([]u8, 32)
	empty := seal.Sha256("")
	acc := []u8{}
	for i := 0; i < 300; i++ {
		priv := seal.Sha256(say.Fmt("client %d", i))
		share := seal.X25519PublicKey(priv) catch _ {
			[]u8{}
		}
		shared := seal.X25519(priv, server) catch _ {
			[]u8{}
		}
		th := seal.Sha256(str(share))
		early := seal.HkdfExtract(seal.Hash.SHA256, str(zero), str(zero))
		hs := seal.HkdfExtract(seal.Hash.SHA256, str(label(early, "derived", empty, 32)), str(shared))
		chs := label(hs, "c hs traffic", th, 32)
		shs := label(hs, "s hs traffic", th, 32)
		master := seal.HkdfExtract(seal.Hash.SHA256, str(label(hs, "derived", empty, 32)), str(zero))
		cap := label(master, "c ap traffic", th, 32)
		sap := label(master, "s ap traffic", th, 32)
		for _, s := range [][]u8{chs, shs, cap, sap} {
			a := seal.NewAESGCM(label(s, "key", []u8{}, 16)) catch _ {
				return
			}
			label(s, "iv", []u8{}, 12)
			if a.NonceSize() != 12 {
				return
			}
		}
		sf := seal.Hmac(seal.Hash.SHA256, str(label(shs, "finished", []u8{}, 32)), str(th))
		acc = seal.Hmac(seal.Hash.SHA256, str(label(chs, "finished", []u8{}, 32)), str(sf))
	}
	say.Line(seal.Hex(acc))
}
