package main

import "say"
import "seal"

fn label(secret_ []u8, l str, ctx []u8, n i64) []u8 {
	return seal.HkdfExpandLabel(seal.Hash.SHA256, str(secret_), l, str(ctx), n) catch _ {
		[]u8{}
	}
}

// The client's cryptography for 300 TLS 1.3 handshakes: an X25519 key share and shared
// secret, the key schedule, four AES-128-GCM keys and both Finished MACs.
fn main() {
	let server = seal.X25519PublicKey(seal.Sha256("server")) catch _ {
		[]u8{}
	}
	let zero = make([]u8, 32)
	let empty = seal.Sha256("")
	mut acc = []u8{}
	for i in 0..300 {
		let priv = seal.Sha256(say.Fmt("client %d", i))
		let share = seal.X25519PublicKey(priv) catch _ {
			[]u8{}
		}
		let shared_ = seal.X25519(priv, server) catch _ {
			[]u8{}
		}
		let th = seal.Sha256(str(share))
		let early = seal.HkdfExtract(seal.Hash.SHA256, str(zero), str(zero))
		let hs = seal.HkdfExtract(seal.Hash.SHA256, str(label(early, "derived", empty, 32)), str(shared_))
		let chs = label(hs, "c hs traffic", th, 32)
		let shs = label(hs, "s hs traffic", th, 32)
		let master = seal.HkdfExtract(seal.Hash.SHA256, str(label(hs, "derived", empty, 32)), str(zero))
		let cap = label(master, "c ap traffic", th, 32)
		let sap = label(master, "s ap traffic", th, 32)
		for _, s in [][]u8{chs, shs, cap, sap} {
			let a = seal.NewAESGCM(label(s, "key", []u8{}, 16)) catch _ {
				return
			}
			label(s, "iv", []u8{}, 12)
			if a.NonceSize() != 12 {
				return
			}
		}
		let sf = seal.Hmac(seal.Hash.SHA256, str(label(shs, "finished", []u8{}, 32)), str(th))
		acc = seal.Hmac(seal.Hash.SHA256, str(label(chs, "finished", []u8{}, 32)), str(sf))
	}
	say.Line(seal.Hex(acc))
}
