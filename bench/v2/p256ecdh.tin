package main

import "say"
import "seal"

// 200 P-256 ECDH operations, each private key the SHA-256 of a counter.
fn main() {
	let peer = seal.P256PublicKey(seal.Sha256("peer")) catch e {
		say.Line(e)
		return
	}
	mut acc = seal.Sha256("")
	for i in 0..200 {
		let priv = seal.Sha256(say.Fmt("key %d", i))
		let s = seal.P256ECDH(priv, peer) catch e {
			say.Line(e)
			return
		}
		acc = seal.Sha256(str(acc) + str(s))
	}
	say.Line(seal.Hex(acc))
}
