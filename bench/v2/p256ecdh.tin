package main

import "say"
import "seal"

// 200 P-256 ECDH operations, each private key the SHA-256 of a counter.
func main() {
	peer := seal.P256PublicKey(seal.Sha256("peer")) catch e {
		say.Line(e)
		return
	}
	acc := seal.Sha256("")
	for i := 0; i < 200; i++ {
		priv := seal.Sha256(say.Fmt("key %d", i))
		s := seal.P256ECDH(priv, peer) catch e {
			say.Line(e)
			return
		}
		acc = seal.Sha256(str(acc) + str(s))
	}
	say.Line(seal.Hex(acc))
}
