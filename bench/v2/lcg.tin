package main

import "say"

fn main() {
	let alu = "ACGTacgtNNxxyyzzWWSS"
	let buf = make([]u8, 1024)
	mut seed = i64(42)
	mut sum = i64(0)
	for i in i64(0)..300000000 {
		seed = (seed*3877 + 29573) % 139968
		let c = alu[seed%20]
		buf[i&1023] = c
		sum += i64(c) + seed
	}
	say.Line(sum, buf[0], buf[1023])
}
