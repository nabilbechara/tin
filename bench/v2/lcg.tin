package main

import "say"

func main() {
	alu := "ACGTacgtNNxxyyzzWWSS"
	buf := make([]u8, 1024)
	seed := i64(42)
	sum := i64(0)
	for i := i64(0); i < 300000000; i++ {
		seed = (seed*3877 + 29573) % 139968
		c := alu[seed%20]
		buf[i&1023] = c
		sum += i64(c) + seed
	}
	say.Line(sum, buf[0], buf[1023])
}
