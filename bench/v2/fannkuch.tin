package main

import "say"

fn fannkuch(n i64) (i64, i64) {
	let perm1 = make([]i64, n)
	for i in i64(0)..n {
		perm1[i] = i
	}
	let perm = make([]i64, n)
	let count = make([]i64, n)
	mut maxFlips = i64(0)
	mut checksum = i64(0)
	mut r = n
	mut permCount = i64(0)
	for {
		for r != 1 {
			count[r-1] = r
			r -= 1
		}
		copy(perm, perm1)
		mut flips = i64(0)
		mut k = perm[0]
		for k != 0 {
			mut i = i64(0)
			mut j = k
			for i < j {
				let t = perm[i]
				perm[i] = perm[j]
				perm[j] = t
				i += 1
				j -= 1
			}
			flips += 1
			k = perm[0]
		}
		if flips > maxFlips {
			maxFlips = flips
		}
		if permCount%2 == 0 {
			checksum += flips
		} else {
			checksum -= flips
		}
		for {
			if r == n {
				return checksum, maxFlips
			}
			let perm0 = perm1[0]
			for i in i64(0)..r {
				perm1[i] = perm1[i+1]
			}
			perm1[r] = perm0
			count[r] -= 1
			if count[r] > 0 {
				break
			}
			r += 1
		}
		permCount += 1
	}
}

fn main() {
	let n = i64(11)
	let (checksum, maxFlips) = fannkuch(n)
	say.Out("%d\nPfannkuchen(%d) = %d\n", checksum, n, maxFlips)
}
