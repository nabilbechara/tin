package main

import "say"

// A batch loop whose steps each run in a small arena (#530): about 1 KiB of temporaries a step.
fn step(i i64) i64 {
	mut xs = make([]i64, 0, 16)
	for k in i64(0)..100 {
		xs = append(xs, (i + k) & 255)
	}
	mut t = i64(0)
	for x in xs {
		t += x
	}
	return t
}

fn main() {
	mut total = i64(0)
	for i in i64(0)..2000000 {
		total += arena {
			step(i)
		}
	}
	say.Line(total)
}
