package main

import "gauge"
import "say"

fn a(i i64, j i64) f64 {
	return 1.0 / f64((i+j)*(i+j+1)/2+i+1)
}

fn mulAv(v []f64, av mut []f64) {
	let n = len(v)
	for i in i64(0)..n {
		mut sum = 0.0
		for j in i64(0)..n {
			sum += a(i, j) * v[j]
		}
		av[i] = sum
	}
}

fn mulAtv(v []f64, atv mut []f64) {
	let n = len(v)
	for i in i64(0)..n {
		mut sum = 0.0
		for j in i64(0)..n {
			sum += a(j, i) * v[j]
		}
		atv[i] = sum
	}
}

fn mulAtAv(v []f64, out mut []f64, tmp mut []f64) {
	mulAv(v, mut tmp)
	mulAtv(tmp, mut out)
}

fn main() {
	let n = i64(5500)
	let u = make([]f64, n)
	let v = make([]f64, n)
	let tmp = make([]f64, n)
	for i in i64(0)..n {
		u[i] = 1.0
	}
	for i in 0..10 {
		mulAtAv(u, mut v, mut tmp)
		mulAtAv(v, mut u, mut tmp)
	}
	mut vBv = 0.0
	mut vv = 0.0
	for i in i64(0)..n {
		vBv += u[i] * v[i]
		vv += v[i] * v[i]
	}
	say.Out("%.9f\n", gauge.Sqrt(vBv/vv))
}
