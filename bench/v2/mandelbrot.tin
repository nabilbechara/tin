package main

import "say"

fn main() {
	let n = i64(4000)
	let limit_ = 4.0
	mut sum = i64(0)
	for y in i64(0)..n {
		let ci = 2.0*f64(y)/f64(n) - 1.0
		mut byteAcc = i64(0)
		mut bitNum = i64(0)
		for x in i64(0)..n {
			let cr = 2.0*f64(x)/f64(n) - 1.5
			mut zr = 0.0
			mut zi = 0.0
			mut tr = 0.0
			mut ti = 0.0
			mut i = 0
			for i < 50 && tr+ti <= limit_ {
				zi = 2.0*zr*zi + ci
				zr = tr - ti + cr
				tr = zr * zr
				ti = zi * zi
				i += 1
			}
			byteAcc <<= 1
			if tr+ti <= limit_ {
				byteAcc |= 1
			}
			bitNum += 1
			if bitNum == 8 {
				sum += byteAcc * (x + 1)
				byteAcc = 0
				bitNum = 0
			}
		}
	}
	say.Line(sum)
}
